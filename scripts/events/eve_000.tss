path_03DC:
    step speed=-1, x=380, y=119, anim=anim_03FA, next=NEXT  ; jump to 380, 119
    step speed=8, x=240, y=119, anim=anim_03FA, next=path_03F0  ; move to 240, 119, 8 pixels a frame

path_03F0:
    step speed=0, x=100, y=0, anim=anim_03FA, next=path_03F0  ; wait 100 frames

anim_03FA:
    frame IMG_FACE, time=6, flip=0, next=NEXT
    frame IMG_FACE+1, time=6, flip=0, next=anim_03FA

path_040A:
    step speed=0, x=64, y=0, anim=anim_046E, next=NEXT  ; wait 64 frames
    step speed=-1, x=32, y=-32, anim=anim_046E, next=NEXT  ; jump to 32, -32
    step speed=5, x=32, y=-17, anim=anim_046E, next=NEXT  ; move to 32, -17, 5 pixels a frame
    step speed=6, x=32, y=-11, anim=anim_046E, next=NEXT  ; move to 32, -11, 6 pixels a frame
    step speed=7, x=32, y=-4, anim=anim_046E, next=NEXT  ; move to 32, -4, 7 pixels a frame
    step speed=8, x=32, y=4, anim=anim_046E, next=NEXT  ; move to 32, 4, 8 pixels a frame
    step speed=9, x=32, y=13, anim=anim_046E, next=NEXT  ; move to 32, 13, 9 pixels a frame
    step speed=10, x=32, y=23, anim=anim_046E, next=NEXT  ; move to 32, 23, 10 pixels a frame
    step speed=10, x=32, y=64, anim=anim_046E, next=path_0464  ; move to 32, 64, 10 pixels a frame

path_0464:
    step speed=0, x=100, y=0, anim=anim_046E, next=path_0464  ; wait 100 frames

anim_046E:
    frame 1, time=4, flip=0, next=anim_046E
    words 0    ; padding
