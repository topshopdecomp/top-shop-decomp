; EVE_000.J entry 0
;
; Played when a player goes bankrupt (Board_Task step 10104): what the player's
; character says. (Event 0 itself is never drawn.)
;
; What it says: "[<player>] / Meow-hiss-meow...." | "[<player>] / Oh my!" | "[<player>] / I demand
; a re-count!" | "[<player>] / I can't stand anymore..." | "[<player>] / Nononononono!" |
; "[<player>] / I can't believe it!" | ...
;
; 1144 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "EVE_000"                      ; a name for the script; costs a frame
    talk_clear
    fade_in 20
    wait_fade
    sprite_init 0, image=IMG_FACE+1, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=0, attr=0, x=-100, y=-100, pri=2
    portrait_face 4
    sprite_path 0, path_03DC
    sprite_path 1, path_040A
    switch $char: L_0060, L_00A0, L_00D5, L_0118, L_015E, L_019A, L_01DC, L_021A, L_0256, L_029B, L_02DD, L_0324, L_035E, L_039F

L_0060:
    ; $char 0: Meower
    talk "【%NMY】%KMeow-hiss-meow…."       ; [<player>] / Meow-hiss-meow....
    talk_show 0
    talk_open
    talk_wait_open
    play_xa 0, 15                         ; voice: XA track 15 (g_xaSets[1])
    wait 80
    wait_buttons_for CROSS|0x300, 40      ; wait for cross, 40 frames at most
    stop_xa
    fade_out 24
    wait_fade
    end

