; EVE_073.J entry 0
;
; Event 73: never played. Event_PickRandom never draws it, and nothing turns on
; RULE_PICK_EVENT, the debug rule that lets the player pick any event.
; Result ($result of the task): 0 the turn goes on, 1 another event (result_another),
; 2 roll again (result_reroll), 3 move the steps set (move_steps).
;
; What it does: the current player: money + $v00.
;
; What it says: "[Pumpkin Head] / Here's a chance quiz." | "Pick the correct / answer from the
; three / choices about the store / items, and a BONUS / will be awarded." | "(at the store above)
; /" | "... item is which of these?" | "1." | "2." | ...
;
; 11080 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
; NOTE 0x00CB: talk without its NUL: the game continues at 0x00CE, inside the next instruction

; The event card scene's variables (scripts/README.md):
; corner1-4: top left, top right, bottom left, bottom right (sprites 1-4)
; $cornerN_x/_y: position; _dx/_dy: offset for this frame only; _home_x/_y: place in the frame
; $corner_zoom: 256 = full size, this frame; $corner_stretch_x/_y: 50 = no stretch
; $corner_entrance: CORNERS_*; $corner_effects: FX_* bits; $card_entrance: CARD_*
; $card_state: 0 not started, 32767 done (the card routines count in it)
var $corner1_x = $v0A
var $corner1_y = $v0B
var $corner2_x = $v0C
var $corner2_y = $v0D
var $corner3_x = $v0E
var $corner3_y = $v0F
var $corner4_x = $v10
var $corner4_y = $v11
var $corner_zoom = $v12
var $corner_stretch_x = $v13
var $corner_stretch_y = $v14
var $corner1_dx = $v15
var $corner1_dy = $v16
var $corner2_dx = $v17
var $corner2_dy = $v18
var $corner3_dx = $v19
var $corner3_dy = $v1A
var $corner4_dx = $v1B
var $corner4_dy = $v1C
var $corner1_home_x = $v1D
var $corner1_home_y = $v1E
var $corner2_home_x = $v1F
var $corner2_home_y = $v20
var $corner3_home_x = $v21
var $corner3_home_y = $v22
var $corner4_home_x = $v23
var $corner4_home_y = $v24
var $corner_entrance = $v25
var $corner_effects = $v26
var $card_entrance = $v28
var $card_state = $v8C
var $card_angle = $v8D
var $card_sink_step = $v93
var $card_rise_step = $v94
var $pulse_angle = $v96
var $pulse_x_angle = $v97
var $pulse_y_angle = $v98
var $shrink_amount = $v99
var $grow_amount = $v9A
var $corner_steps = $v9B
var $squeeze_y_angle = $v9C
var $squeeze_x_angle = $v9D
var $circle_radius = $v9E
var $circle_angle = $v9F
    call clear_vars
    call scene_setup
    call corners_animate
    $corner_entrance = CORNERS_HOME
    $corner_effects = 0
    $card_entrance = CARD_RISE
    call effects_default
    nop_34 6                              ; no effect in this game
    talk "【Pumpkin Head】%KHere's a chance quiz."  ; [Pumpkin Head] / Here's a chance quiz.
    call card_show
    talk_clear
    talk "Pick the correct%Kanswer from the three%Kchoices about the store%Kitems, and a BONUS%Kwill be awarded.%K"
    talk_show 0
    call wait_cross
    talk_clear
    bytes 0x00, 0xCA                      ; talk "" without its NUL: the game reads the next byte as the NUL and goes on at 0x00CE, inside the next instruction
    $v00 = random 44
    $v00 *= 7
    $l0 = table_04F8[$v00]
    $v01 = random 6
    $l1 = table_048C[$v01]
    $v01 += 1
    $v01 += $v00
    $l2 = table_04F8[$v01]

L_0103:
    $v02 = random 6
    $v02 += 1
    $v02 += $v00
    if $v01 == $v02 goto L_0103
    $l3 = table_04F8[$v02]

L_0127:
    $v03 = random 6
    $v03 += 1
    $v03 += $v00
    if $v03 == $v01 goto L_0127
    if $v03 == $v02 goto L_0127
    $l4 = table_04F8[$v03]
    talk_data $l0
    talk "で%K"                            ; en: (at the store above) /
    talk_data $l1
    talk "い商品は次のどれですか？"                   ; en: ... item is which of these?
    talk_show 0
    call wait_cross
    $v00 = random 3

L_018D:
    $v01 = random 3
    if $v00 == $v01 goto L_018D

L_019D:
    $v02 = random 3
    if $v00 == $v02 goto L_019D
    if $v01 == $v02 goto L_019D
    $v03 = 0
    $v04 = $l2
    $v05 = $l3
    $v06 = $l4
    talk_clear
    talk "１．"                             ; 1.
    call quiz_print_answer
    talk "%K"
    $v00 = $v01
    $v03 += 1
    talk "２．"                             ; 2.
    call quiz_print_answer
    talk "%K"
    $v00 = $v02
    $v03 += 1
    talk "３．"                             ; 3.
    call quiz_print_answer
    $l5 = $v07
    talk_show 0
    $v00 = $l5
    call quiz_choose
    if $v00 != $l5 goto L_0288
    call money_by_years
    $v00 *= 5
    play_se 7
    talk_clear
    talk "Congratulations!%KAs a prize, I will%Kgive you "
    talk_number $v00, 0
    talk "."
    earn CUR_PLAYER, $v00                 ; the current player: money + $v00
    goto L_02D3

L_0288:
    play_se 8
    talk_clear
    talk "Wrong answer.%KThe correct answer is%K"
    $v00 = table_047D[$l5]
    talk_data $v00
    talk ",“"                             ; ,"
    talk_data $l2
    talk "”."                             ; ".

L_02D3:
    talk_show 0
    call wait_cross
    call card_close
    call finish

quiz_print_answer:
    ; add answer $v00 to the text: 0 the right one ($v04; its row $v03 goes to $v07), 1 $v05, 2
    ; $v06
    switch $v00: L_02F3, L_02FF
    talk_data $v06
    return

L_02F3:
    ; $v00 = 0
    talk_data $v04
    $v07 = $v03
    return

L_02FF:
    ; $v00 = 1
    talk_data $v05
    return

quiz_choose:
    ; the player picks one of three rows with up and down; the choice is confirmed with button bit
    ; 0x0200, which no button gives, so only a CPU player gets through (it picks row $v00, the
    ; right one, 70% of the time); the row blinks three times; $v00 = the row
    $l1 = $v00
    $l0 = 0
    talk_cursor 0
    if $cur_is_cpu & CPU goto L_03C5

L_031F:
    call effects_run
    if $cur_pressed != 8192 goto L_034B
    $l0 += 1
    if $l0 != 3 goto L_0343
    $l0 = 0

L_0343:
    talk_cursor $l0
    play_se 0

L_034B:
    if $cur_pressed != 4096 goto L_0373
    $l0 -= 1
    if $l0 != -1 goto L_036B
    $l0 = 2

L_036B:
    talk_cursor $l0
    play_se 0

L_0373:
    if $cur_pressed != 512 goto L_031F
    play_se 1
    talk_no_cursor
    $l2 = 0

L_0389:
    $v00 = 1
    call effects_for
    talk_cursor $l0
    $v00 = 3
    call effects_for
    talk_no_cursor
    $l2 += 1
    if $l2 != 3 goto L_0389
    $v00 = 1
    call effects_for
    $v00 = $l0
    return

L_03C5:
    $v00 = random 100
    if $v00 >= 70 goto L_03E1
    switch $l1: L_03FD, L_0407, L_041F

L_03E1:
    $v00 = random 3
    if $v00 == $l1 goto L_03E1
    switch $v00: L_03FD, L_0407, L_041F

L_03FD:
    ; $l1 = 0, $v00 = 0
    $l0 = 0
    goto L_0441

L_0407:
    ; $l1 = 1, $v00 = 1
    $l0 = 1
    $v00 = 30
    call effects_for
    talk_cursor 1
    goto L_0441

L_041F:
    ; $l1 = 2, $v00 = 2
    $l0 = 2
    $v00 = 10
    call effects_for
    talk_cursor 1
    $v00 = 10
    call effects_for
    talk_cursor 2

L_0441:
    $v00 = 30
    call effects_for
    play_se 1
    talk_no_cursor
    $l2 = 0
    goto L_0389

effects_for:
    ; keep the effects going for $v00 frames
    $l0 = $v00
    $l1 = 0

L_0467:
    call effects_run
    $l1 += 1
    if $l1 != $l0 goto L_0467
    return

