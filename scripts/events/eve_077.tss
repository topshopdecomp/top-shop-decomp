corners_animate:
    ; start the animations of the card and the four corners
    sprite_animate 0, anim_2A43
    sprite_animate 1, anim_2773
    sprite_animate 2, anim_27C3
    sprite_animate 3, anim_2813
    sprite_animate 4, anim_2863
    return

corners_animate_alt:
    ; other animations for the corners (not used)
    ; (not reached: nothing jumps here)
    sprite_animate 1, anim_28B3
    sprite_animate 2, anim_28EB
    sprite_animate 3, anim_2923
    sprite_animate 4, anim_295B
    return

corners_animate_alt_2:
    ; other animations for the corners (not used)
    sprite_animate 1, anim_2993
    sprite_animate 2, anim_29B3
    sprite_animate 3, anim_2993
    sprite_animate 4, anim_29B3
    return

corners_animate_alt_3:
    ; other animations for the corners (not used)
    sprite_animate 1, anim_29D3
    sprite_animate 2, anim_2A0B
    sprite_animate 3, anim_29D3
    sprite_animate 4, anim_2A0B
    return

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_wait_clear:
    ; show the text, wait for cross (180 frames at most), clear the text
    talk_show 0
    wait_buttons_for CROSS|0x300, 180     ; wait for cross, 180 frames at most
    talk_clear
    return

card_close:
    ; close the view and take everything away (corners_leave); wait until the view and the talk
    ; panel are closed
    ; (reached again)
    view_close GROW, 10
    set 0, 0                              ; a constant where a variable belongs: only $result is set
    call corners_leave
    view_wait
    talk_wait_closed
    return

corners_leave:
    ; the corners draw in for 10 frames, the talk panel closes, then they fly off for 15 frames;
    ; meanwhile the card sinks into the talk panel (card_sink) and the tiles shrink
    $l0 = 0
    $card_state = 0

L_154D:
    $corner1_x += 2
    $corner1_y += 2
    $corner2_x -= 2
    $corner2_y += 2
    $corner3_x += 2
    $corner3_y -= 2
    $corner4_x -= 2
    $corner4_y -= 2
    if $card_entrance == CARD_STILL goto L_158B
    call card_sink

L_158B:
    call effects_run
    call tiles_shrink
    $l0 += 1
    if $l0 != 10 goto L_154D
    $l0 = 0
    talk_close

L_15AB:
    $corner1_x -= 10
    $corner1_y -= 10
    $corner2_x += 10
    $corner2_y -= 10
    $corner3_x -= 10
    $corner3_y += 10
    $corner4_x += 10
    $corner4_y += 10
    call card_sink
    call effects_run
    call tiles_shrink
    $l0 += 1
    if $l0 != 15 goto L_15AB
    return

finish:
    ; stop the music; end of the script
    stop_bgm
    end

scene_setup:
    ; the scene: layer 0 (scene image 0); the card (sprite 0, image 7) off screen; the four
    ; corners (sprites 1-4, image 1) at their home positions, worked out from the size of image 1
    ; (the frame fills 320 x 170); the 30 background tiles (sprites 10-39, image 10) in rows of 6;
    ; dim 128; $corner_steps = 20, the zoom and squeeze counters set
    get_image_size 1, $v00, $v01
    $v00 /= 2
    $v01 /= 2
    $corner1_home_x = 0
    $corner1_home_x += $v00
    $corner1_home_y = 0
    $corner1_home_y += $v01
    $corner2_home_x = 320
    $corner2_home_x -= $v00
    $corner2_home_y = 0
    $corner2_home_y += $v01
    $corner3_home_x = 0
    $corner3_home_x += $v00
    $corner3_home_y = 170
    $corner3_home_y -= $v01
    $corner4_home_x = 320
    $corner4_home_x -= $v00
    $corner4_home_y = 170
    $corner4_home_y -= $v01
    $corner1_x = $corner1_home_x
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner2_y = $corner2_home_y
    $corner3_x = $corner3_home_x
    $corner3_y = $corner3_home_y
    $corner4_x = $corner4_home_x
    $corner4_y = $corner4_home_y
    $corner_zoom = 256
    $corner_stretch_x = 50
    $corner_stretch_y = 50
    $v95 = 1
    $shrink_amount = 256
    $grow_amount = 256
    $corner_steps = 20
    $squeeze_y_angle = 8191
    $squeeze_x_angle = 8191
    $circle_radius = 50
    layer_init 0, image=0, pri=31, flags=0
    sprite_init 0, image=7, attr=MIDDLE_CENTER, x=420, y=340, pri=0
    sprite_init 1, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    sprite_init 2, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    sprite_init 3, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    sprite_init 4, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    $l0 = 10
    $v00 = 0
    $v01 = 0

L_173F:
    sprite_init $l0, image=10, attr=MIDDLE_CENTER|SEMITRANS2, x=$v00, y=$v01, pri=-1
    sprite_scale $l0, 0, 0
    $l0 += 1
    $v00 += 64
    if $v00 != 384 goto L_1777
    $v00 = 0
    $v01 += 64

L_1777:
    if $l0 != 40 goto L_173F
    set_dim 128
    return

L_1787:
    return

effects_default:
    ; no corner entrance; only FX_TILES
    $corner_entrance = CORNERS_HOME
    $corner_effects = 0
    $corner_effects |= FX_TILES
    return

card_show:
    ; music 3; open the view and the talk panel; then every frame the corner entrance
    ; ($corner_entrance), the effects ($corner_effects) and the card's entrance ($card_entrance),
    ; until the voice has ended and cross is pressed (a CPU player: 60 frames); then the corners
    ; back home and a sound
    play_bgm 3
    $l0 = 0
    view_set x=64, y=24, w=192, h=128
    view_open GROW, 10
    talk_show 0
    talk_open

L_17BD:
    switch $corner_entrance: L_17D9, L_17C9, L_17D1

L_17C9:
    ; $corner_entrance = 1
    call corners_spread
    goto L_17D9

L_17D1:
    ; $corner_entrance = 2
    call corners_fly_in
    goto L_17D9

L_17D9:
    ; $corner_entrance = 0
    if $corner_effects !& FX_GROW goto L_17E7
    call fx_grow

L_17E7:
    if $corner_effects !& FX_SHRINK goto L_17F5
    call fx_shrink

L_17F5:
    if $corner_effects !& FX_CIRCLE goto L_1803
    call fx_circle

L_1803:
    if $corner_effects !& FX_SQUEEZE_X goto L_1811
    call fx_squeeze_x

L_1811:
    if $corner_effects !& FX_SQUEEZE_Y goto L_181F
    call fx_squeeze_y

L_181F:
    if $corner_effects !& FX_SPIN goto L_182D
    call fx_spin

L_182D:
    if $corner_effects !& FX_PULSE_X goto L_183B
    call fx_pulse_x

L_183B:
    if $corner_effects !& FX_PULSE_Y goto L_1849
    call fx_pulse_y

L_1849:
    if $corner_effects !& FX_PULSE goto L_1857
    call fx_pulse

L_1857:
    if $corner_effects !& FX_TILES goto L_1869
    call fx_tiles_scroll
    call fx_tiles_grow

L_1869:
    call card_enter
    call corners_apply
    $l0 += 1
    if $l0 >= 0 goto L_1887
    $l0 = 30

L_1887:
    if $l0 < 30 goto L_17BD
    if $l0 != 10 goto L_189F
    nop_34 $card_sink_step                ; no effect in this game

L_189F:
    $v00 = xa_playing
    if $v00 == 1 goto L_17BD
    if $cur_is_cpu & CPU goto L_18C5
    if $cur_pressed !& CROSS|0x300 goto L_17BD
    goto L_18CF

L_18C5:
    if $l0 < 60 goto L_17BD

L_18CF:
    $corner1_x = $corner1_home_x
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner2_y = $corner2_home_y
    $corner3_x = $corner3_home_x
    $corner3_y = $corner3_home_y
    $corner4_x = $corner4_home_x
    $corner4_y = $corner4_home_y
    sprite_pos 1, $corner1_home_x, $corner1_home_y
    sprite_pos 2, $corner2_home_x, $corner2_home_y
    sprite_pos 3, $corner3_home_x, $corner3_home_y
    sprite_pos 4, $corner4_home_x, $corner4_home_y
    play_se 1
    return

effects_settle:
    ; (not used) run the effects until the corner entrance, FX_GROW, FX_SHRINK, FX_CIRCLE and the
    ; squeezes have run down, then until the spin and the pulses are back at rest
    ; (not reached: nothing jumps here)
    $vA0 = 0
    if $corner_entrance == CORNERS_HOME goto L_193B
    $vA0 += $corner_steps

L_193B:
    if $corner_effects !& FX_GROW goto L_194B
    $vA0 += $grow_amount

L_194B:
    if $corner_effects !& FX_SHRINK goto L_195B
    $vA0 += $shrink_amount

L_195B:
    if $corner_effects !& FX_CIRCLE goto L_196B
    $vA0 += $circle_radius

L_196B:
    if $corner_effects !& FX_SQUEEZE_X goto L_197B
    $vA0 += $squeeze_x_angle

L_197B:
    if $corner_effects !& FX_SQUEEZE_Y goto L_198B
    $vA0 += $squeeze_y_angle

L_198B:
    call corners_apply
    if $vA0 != 0 goto card_show

L_1999:
    $vA0 = 0
    if $corner_effects !& FX_SPIN goto L_19B9
    call fx_spin_stop
    sprite_get_angle 1, $v00
    $vA0 += $v00

L_19B9:
    if $corner_effects !& FX_PULSE_X goto L_19CD
    call fx_pulse_x_stop
    $vA0 += $pulse_x_angle

L_19CD:
    if $corner_effects !& FX_PULSE_Y goto L_19E1
    call fx_pulse_y_stop
    $vA0 += $pulse_y_angle

L_19E1:
    if $corner_effects !& FX_PULSE goto L_19F5
    call fx_pulse_stop
    $vA0 += $pulse_angle

L_19F5:
    call corners_apply
    if $vA0 != 0 goto L_1999
    return

effects_run:
    ; one frame of the effects that keep going (FX_SPIN, FX_PULSE_X, FX_PULSE_Y, FX_PULSE,
    ; FX_TILES), then corners_apply
    ; (reached again)
    if $corner_effects !& FX_SPIN goto L_1A13
    call fx_spin

L_1A13:
    if $corner_effects !& FX_PULSE_X goto L_1A21
    call fx_pulse_x

L_1A21:
    if $corner_effects !& FX_PULSE_Y goto L_1A2F
    call fx_pulse_y

L_1A2F:
    if $corner_effects !& FX_PULSE goto L_1A3D
    call fx_pulse

L_1A3D:
    if $corner_effects !& FX_TILES goto L_1A4B
    call fx_tiles_scroll

L_1A4B:
    call corners_apply
    return

corners_apply:
    ; corner positions plus this frame's offsets to sprites 1-4, their scale = $corner_stretch_x/y
    ; * $corner_zoom / 50; offsets, zoom and stretch back to neutral; wait a frame
    $v00 = $corner1_x
    $v01 = $corner1_y
    $v02 = $corner2_x
    $v03 = $corner2_y
    $v04 = $corner3_x
    $v05 = $corner3_y
    $v06 = $corner4_x
    $v07 = $corner4_y
    $v00 += $corner1_dx
    $v01 += $corner1_dy
    $v02 += $corner2_dx
    $v03 += $corner2_dy
    $v04 += $corner3_dx
    $v05 += $corner3_dy
    $v06 += $corner4_dx
    $v07 += $corner4_dy
    $corner1_dx = 0
    $corner1_dy = 0
    $corner2_dx = 0
    $corner2_dy = 0
    $corner3_dx = 0
    $corner3_dy = 0
    $corner4_dx = 0
    $corner4_dy = 0
    sprite_pos 1, $v00, $v01
    sprite_pos 2, $v02, $v03
    sprite_pos 3, $v04, $v05
    sprite_pos 4, $v06, $v07
    $corner_stretch_x *= $corner_zoom
    $corner_stretch_y *= $corner_zoom
    $corner_stretch_x /= 50
    $corner_stretch_y /= 50
    sprite_scale 1, $corner_stretch_x, $corner_stretch_y
    sprite_scale 2, $corner_stretch_x, $corner_stretch_y
    sprite_scale 3, $corner_stretch_x, $corner_stretch_y
    sprite_scale 4, $corner_stretch_x, $corner_stretch_y
    $corner_zoom = 256
    $corner_stretch_x = 50
    $corner_stretch_y = 50
    wait 1
    return

corners_spread:
    ; corner entrance 1: all four start at the center and spread out to their home positions over
    ; $corner_steps frames
    if $corner_steps == 0 goto L_1787
    if $corner_steps == 1 goto L_1C2B
    if $corner_steps != 20 goto L_1BD3
    $v00 = $corner2_home_x
    $v00 -= $corner1_home_x
    $v00 /= 2
    $v00 += $corner1_home_x
    $v01 = $corner3_home_y
    $v01 -= $corner1_home_y
    $v01 /= 2
    $v01 += $corner1_home_y
    $corner1_x = $v00
    $corner1_y = $v01
    $corner2_x = $v00
    $corner2_y = $v01
    $corner3_x = $v00
    $corner3_y = $v01
    $corner4_x = $v00
    $corner4_y = $v01
    goto L_1C5B

L_1BD3:
    $v00 = $corner4_home_x
    $v00 -= $corner4_x
    $v00 /= $corner_steps
    $v01 = $corner4_home_y
    $v01 -= $corner4_y
    $v01 /= $corner_steps
    $corner1_x -= $v00
    $corner1_y -= $v01
    $corner2_x += $v00
    $corner2_y -= $v01
    $corner3_x -= $v00
    $corner3_y += $v01
    $corner4_x += $v00
    $corner4_y += $v01
    goto L_1C5B

L_1C2B:
    $corner1_x = $corner1_home_x
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner2_y = $corner2_home_y
    $corner3_x = $corner3_home_x
    $corner3_y = $corner3_home_y
    $corner4_x = $corner4_home_x
    $corner4_y = $corner4_home_y

L_1C5B:
    $corner_steps -= 1
    return

corners_fly_in:
    ; corner entrance 2: the corners fly in from the edges of the screen over $corner_steps frames
    if $corner_steps == 0 goto L_1787
    if $corner_steps == 1 goto L_1D01
    if $corner_steps != 20 goto L_1C9D
    $corner1_y = 340
    $corner2_x = -100
    $corner3_x = 420
    $corner4_y = -100
    goto L_1D19

L_1C9D:
    $v00 = $corner1_home_y
    $v00 -= $corner1_y
    $v00 /= $corner_steps
    $v01 = $corner2_home_x
    $v01 -= $corner2_x
    $v01 /= $corner_steps
    $v02 = $corner3_home_x
    $v02 -= $corner3_x
    $v02 /= $corner_steps
    $v03 = $corner4_home_y
    $v03 -= $corner4_y
    $v03 /= $corner_steps
    $corner1_y += $v00
    $corner2_x += $v01
    $corner3_x += $v02
    $corner4_y += $v03
    goto L_1D19

L_1D01:
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner3_x = $corner3_home_x
    $corner4_y = $corner4_home_y

L_1D19:
    $corner_steps -= 1
    return

fx_grow:
    ; FX_GROW: zoom = 1 - $grow_amount/256; the amount falls by 10 a frame
    $corner_zoom -= $grow_amount
    $grow_amount -= 10
    if $grow_amount > 0 goto L_1787
    $grow_amount = 0
    return

fx_shrink:
    ; FX_SHRINK: zoom = 1 + $shrink_amount/256; the amount falls by 10 a frame
    $corner_zoom += $shrink_amount
    $shrink_amount -= 10
    if $shrink_amount > 0 goto L_1787
    $shrink_amount = 0
    return

fx_squeeze_x:
    ; FX_SQUEEZE_X: the corners start 100 pixels further apart sideways and ease back
    ; ($squeeze_x_angle)
    $v02 = 8191
    $v02 -= $squeeze_x_angle
    step_toward x=0, y=0, distance=100, angle=$v02, to_x=$v00, to_y=$v01
    $v00 = 100
    $v00 -= $v01
    $corner1_dx -= $v00
    $corner2_dx += $v00
    $corner3_dx -= $v00
    $corner4_dx += $v00
    $squeeze_x_angle -= 400
    if $squeeze_x_angle > 0 goto L_1787
    $squeeze_x_angle = 0
    return

fx_squeeze_y:
    ; FX_SQUEEZE_Y: the same up and down ($squeeze_y_angle)
    $v02 = 8191
    $v02 -= $squeeze_y_angle
    step_toward x=0, y=0, distance=100, angle=$v02, to_x=$v00, to_y=$v01
    $v00 = 100
    $v00 -= $v01
    $corner1_dy -= $v00
    $corner2_dy -= $v00
    $corner3_dy += $v00
    $corner4_dy += $v00
    $squeeze_y_angle -= 400
    if $squeeze_y_angle > 0 goto L_1787
    $squeeze_y_angle = 0
    return

fx_circle:
    ; FX_CIRCLE: the corners circle around their places; the radius $circle_radius falls by 1 a
    ; frame
    step_toward x=0, y=0, distance=$circle_radius, angle=$circle_angle, to_x=$v00, to_y=$v01
    $corner1_dx -= $v00
    $corner1_dy -= $v01
    $corner2_dx += $v00
    $corner2_dy -= $v01
    $corner3_dx -= $v00
    $corner3_dy += $v01
    $corner4_dx += $v00
    $corner4_dy += $v01
    $circle_angle += 1500
    if $circle_angle <= 32767 goto L_1E5D
    $circle_angle -= 32767

L_1E5D:
    $circle_radius -= 1
    if $circle_radius >= 0 goto L_1787
    $circle_radius = 0
    return

fx_pulse:
    ; FX_PULSE: the corners throb (size 1 to 1.5, $pulse_angle)
    step_toward x=0, y=0, distance=128, angle=$pulse_angle, to_x=$v00, to_y=$v01
    if $v00 >= 0 goto L_1E97
    $corner_zoom -= $v00
    goto L_1E9D

L_1E97:
    $corner_zoom += $v00

L_1E9D:
    $pulse_angle += 1500
    if $pulse_angle >= 0 goto L_1787
    $pulse_angle -= 32767
    return

fx_pulse_stop:
    ; stop FX_PULSE at the end of a swing (not used)
    ; (not reached: nothing jumps here)
    if $pulse_angle == 0 goto L_1787
    if $pulse_angle >= 31267 goto L_1ECF
    call fx_pulse
    return

L_1ECF:
    $pulse_angle = 0
    return

fx_pulse_x:
    ; FX_PULSE_X: the corners turn over sideways, around and around (their width swings between -1
    ; and 1, $pulse_x_angle)
    ; (reached again)
    step_toward x=0, y=0, distance=50, angle=$pulse_x_angle, to_x=$v00, to_y=$v01
    $v00 -= 50
    $corner_stretch_x += $v00
    $pulse_x_angle += 1500
    if $pulse_x_angle >= 0 goto L_1787
    $pulse_x_angle -= 32767
    return

fx_pulse_x_stop:
    ; stop FX_PULSE_X at the end of a swing (not used)
    ; (not reached: nothing jumps here)
    if $pulse_x_angle == 0 goto L_1787
    if $pulse_x_angle >= 31267 goto L_1F23
    call fx_pulse_x
    return

L_1F23:
    $pulse_x_angle = 0
    return

fx_pulse_y:
    ; FX_PULSE_Y: the same, turning over top to bottom ($pulse_y_angle)
    ; (reached again)
    step_toward x=0, y=0, distance=50, angle=$pulse_y_angle, to_x=$v00, to_y=$v01
    $v00 -= 50
    $corner_stretch_y += $v00
    $pulse_y_angle += 1500
    if $pulse_y_angle >= 0 goto L_1787
    $pulse_y_angle -= 32767
    return

fx_pulse_y_stop:
    ; stop FX_PULSE_Y at the end of a swing (not used)
    ; (not reached: nothing jumps here)
    if $pulse_y_angle == 0 goto L_1787
    if $pulse_y_angle >= 31267 goto L_1F77
    call fx_pulse_y
    return

L_1F77:
    $pulse_y_angle = 0
    return

fx_spin:
    ; FX_SPIN: the corners turn (1 and 3 one way, 2 and 4 the other)
    ; (reached again)
    sprite_rotate 1, -1500
    sprite_rotate 2, 1500
    sprite_rotate 3, -1500
    sprite_rotate 4, 1500
    return

fx_spin_stop:
    ; stop FX_SPIN once the angle is back at 0 (not used)
    ; (not reached: nothing jumps here)
    sprite_get_angle 1, $v00
    if $v00 == 0 goto L_1787
    if $v00 >= 31267 goto L_1FB9
    call fx_spin
    return

L_1FB9:
    sprite_angle 1, 0
    sprite_angle 2, 0
    sprite_angle 3, 0
    sprite_angle 4, 0
    return

card_slide_left:
    ; CARD_SLIDE_LEFT: the card slides in from the left, slowing down, to the center (160, 120)
    ; (reached again)
    if $card_state == CARD_DONE goto L_1787
    step_toward x=0, y=0, distance=261, angle=$card_angle, to_x=$v01, to_y=$v00
    $v00 -= 100
    sprite_pos 0, $v00, 120
    $card_angle += 1000
    if $v00 < 160 goto L_1787
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_slide_right:
    ; CARD_SLIDE_RIGHT: the card slides in from the right
    if $card_state == CARD_DONE goto L_1787
    step_toward x=0, y=0, distance=261, angle=$card_angle, to_x=$v00, to_y=$v01
    $v00 = 420
    $v00 -= $v01
    sprite_pos 0, $v00, 120
    $card_angle += 1000
    if $v00 > 160 goto L_1787
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_zoom:
    ; CARD_ZOOM: the card appears 16 times its size at the center and shrinks to its size
    if $card_state == CARD_DONE goto L_1787
    if $card_state != 0 goto L_2091
    sprite_pos 0, 160, 120
    sprite_scale 0, 4096, 4096
    $card_state = 1
    return

L_2091:
    sprite_scale_by 0, -256, -256
    sprite_get_scale 0, $v00, $v01
    if $v00 > 256 goto L_1787
    sprite_scale 0, 256, 256
    $card_state = CARD_DONE
    return

card_rise:
    ; CARD_RISE: the card grows out of the top of the talk panel, moving right from the center (it
    ; ends at x 240, standing on the panel)
    if $card_state == CARD_DONE goto L_1787
    if $card_state != 0 goto L_20DF
    sprite_scale 0, 0, 0
    $card_state = 1
    return

L_20DF:
    $v00 = 240
    $v00 -= 160
    $v00 *= $card_rise_step
    $v00 /= 16
    $v00 += 160
    get_image_size 7, $v01, $v02
    $v01 = $card_rise_step
    $v01 *= 16
    $v02 *= $v01
    $v02 /= 256
    $v02 /= 2
    $v01 = talk_y
    $v01 -= $v02
    $v01 -= 3
    sprite_pos 0, $v00, $v01
    $card_rise_step += 1
    sprite_scale_by 0, 16, 16
    sprite_get_scale 0, $v00, $v01
    if $v00 < 256 goto L_1787
    sprite_scale 0, 256, 256
    $card_state = CARD_DONE
    return

card_sink:
    ; the card shrinks into the talk panel, moving back to the center, and is hidden
    if $card_state == CARD_DONE goto L_1787
    $v00 = 240
    $v00 -= 160
    $v01 = 8
    $v01 -= $card_sink_step
    $v00 *= $v01
    $v00 /= 8
    $v00 += 160
    get_image_size 7, $v01, $v02
    $v01 = 7
    $v01 -= $card_sink_step
    $v01 *= 32
    $v02 *= $v01
    $v02 /= 256
    $v02 /= 2
    $v01 = talk_y
    $v01 -= $v02
    $v01 -= 3
    sprite_pos 0, $v00, $v01
    $card_sink_step += 1
    sprite_scale_by 0, -32, -32
    sprite_get_scale 0, $v00, $v01
    if $v00 > 0 goto L_1787
    sprite_scale 0, 0, 0
    $card_state = CARD_DONE
    sprite_hide 0
    return

card_spiral:
    ; CARD_SPIRAL: the card spirals in to the center
    if $card_state == CARD_DONE goto L_1787
    $v00 = 260
    $v01 = $card_state
    $v01 *= 13
    $v00 -= $v01
    step_toward x=160, y=120, distance=$v00, angle=$card_angle, to_x=$v01, to_y=$v02
    sprite_pos 0, $v01, $v02
    if $v00 <= 0 goto L_2277
    $card_state += 1
    $card_angle += 3000
    if $card_angle >= 0 goto L_1787
    sub 0, 32767                          ; a constant where a variable belongs: only $result is set
    return

L_2277:
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_bounce:
    ; CARD_BOUNCE: the card bounces up and down, less and less, into the center
    if $card_state == CARD_DONE goto L_1787
    if $card_state != 0 goto L_22A1
    $card_angle = 24575

L_22A1:
    $v00 = 220
    $v01 = $card_state
    $v01 *= 3
    $v00 -= $v01
    step_toward x=160, y=120, distance=$v00, angle=$card_angle, to_x=$v02, to_y=$v01
    sprite_pos 0, 160, $v01
    if $v00 <= 0 goto L_2303
    $card_state += 1
    $v00 = 40
    $v00 *= $card_state
    $card_angle += $v00
    if $card_angle >= 0 goto L_1787
    $card_angle -= 16383
    return

L_2303:
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_enter:
    ; one frame of the card's entrance, by $card_entrance
    switch $card_entrance: L_2327, L_232B, L_2333, L_233B, L_2343, L_234B, L_2353

L_2327:
    ; $card_entrance = 0
    goto L_2357

L_232B:
    ; $card_entrance = 1
    call card_slide_left
    goto L_2357

L_2333:
    ; $card_entrance = 2
    call card_slide_right
    goto L_2357

L_233B:
    ; $card_entrance = 3
    call card_zoom
    goto L_2357

L_2343:
    ; $card_entrance = 4
    call card_rise
    goto L_2357

L_234B:
    ; $card_entrance = 5
    call card_spiral
    goto L_2357

L_2353:
    ; $card_entrance = 6
    call card_bounce

L_2357:
    return

wait_cross:
    ; keep the effects going until cross is pressed (a CPU player: 30 frames); a sound
    $l0 = 0

L_235F:
    call effects_run
    $l0 += 1
    if $cur_is_cpu & CPU goto L_2383
    if $cur_pressed !& CROSS|0x300 goto L_235F
    play_se 1
    return

L_2383:
    if $l0 < 30 goto L_235F
    play_se 1
    return

