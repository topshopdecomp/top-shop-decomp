; EVE_077.J entry 0
;
; Event 77: never played. Event_PickRandom never draws it, and nothing turns on
; RULE_PICK_EVENT, the debug rule that lets the player pick any event.
; Result ($result of the task): 0 the turn goes on, 1 another event (result_another),
; 2 roll again (result_reroll), 3 move the steps set (move_steps).
;
; What it does: the current player: money + $l10.
;
; What it says: "[Pumpkin Head] / This is a speed-up quiz." | "The quiz is two-choice questions
; about store goods; / a wrong answer or running out of time / ends it" | ""number right x" | ""
; money is yours" | "Start!" | "1." | ...
;
; 11212 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.

; The event card scene's variables (scripts/README.md):
; corner1-4: top left, top right, bottom left, bottom right (sprites 1-4)
; $cornerN_x/_y: position; _dx/_dy: offset for this frame only; _home_x/_y: place in the frame
; $corner_zoom: 256 = full size, this frame; $corner_stretch_x/_y: 50 = no stretch
; $corner_entrance: CORNERS_*; $corner_effects: FX_* bits; $card_entrance: CARD_*
; $card_state: 0 not started, 32767 done (the card routines count in it)
var $corner1_x = $v0A
var $corner1_y = $v0B
var $corner2_x = $v0C
var $corner2_y = $v0D
var $corner3_x = $v0E
var $corner3_y = $v0F
var $corner4_x = $v10
var $corner4_y = $v11
var $corner_zoom = $v12
var $corner_stretch_x = $v13
var $corner_stretch_y = $v14
var $corner1_dx = $v15
var $corner1_dy = $v16
var $corner2_dx = $v17
var $corner2_dy = $v18
var $corner3_dx = $v19
var $corner3_dy = $v1A
var $corner4_dx = $v1B
var $corner4_dy = $v1C
var $corner1_home_x = $v1D
var $corner1_home_y = $v1E
var $corner2_home_x = $v1F
var $corner2_home_y = $v20
var $corner3_home_x = $v21
var $corner3_home_y = $v22
var $corner4_home_x = $v23
var $corner4_home_y = $v24
var $corner_entrance = $v25
var $corner_effects = $v26
var $card_entrance = $v28
var $card_state = $v8C
var $card_angle = $v8D
var $card_sink_step = $v93
var $card_rise_step = $v94
var $pulse_angle = $v96
var $pulse_x_angle = $v97
var $pulse_y_angle = $v98
var $shrink_amount = $v99
var $grow_amount = $v9A
var $corner_steps = $v9B
var $squeeze_y_angle = $v9C
var $squeeze_x_angle = $v9D
var $circle_radius = $v9E
var $circle_angle = $v9F
    call clear_vars
    call scene_setup
    call corners_animate
    $corner_entrance = CORNERS_HOME
    $corner_effects = 0
    $card_entrance = CARD_RISE
    call effects_default
    nop_34 6                              ; no effect in this game
    talk "【Pumpkin Head】%KThis is a speed-up quiz."  ; [Pumpkin Head] / This is a speed-up quiz.
    call card_show
    talk_clear
    talk "クイズはお店の商品に関する２択で%K間違えるか、タイムオーバーすると%K終了し"  ; en: The quiz is two-choice questions about store goods; / a wrong answer or running out of time / ends it
    talk_show 0
    call wait_cross
    call money_by_years
    $v00 /= 2
    talk_clear
    talk "「正解数×"                          ; en: "number right x
    talk_number $v00, 0
    talk "」お金がもらえます"                      ; en: " money is yours
    talk_show 0
    call wait_cross
    talk_clear
    talk "Start!"
    talk_show 0
    call wait_cross
    if $cur_is_cpu & CPU goto L_042C

L_0107:
    $l0 = 50
    sprite_init 50, image=11, attr=BOTTOM_LEFT, x=50, y=167, pri=2
    sprite_scale 50, 512, 256
    $v00 = random 44
    $v00 *= 7
    $l0 = table_057B[$v00]
    $v01 = random 6
    $v01 += 1
    $v01 += $v00
    $l1 = table_057B[$v01]

L_0151:
    $v01 = random 44
    $v01 *= 7
    if $v01 == $v00 goto L_0151
    $v00 = random 6
    $v00 += 1
    $v01 += $v00
    $l2 = table_057B[$v01]
    $l4 = random 2
    $l3 = table_0555[$l4]
    talk_clear
    talk_data $l0
    talk_data $l3
    $v00 = random 2
    if $v00 != 0 goto L_01D1
    talk "１．"                             ; 1.
    talk_data $l1
    talk "%K２．"                           ; 2.
    talk_data $l2
    $l6 = 0
    $l7 = 1
    goto L_01F5

L_01D1:
    talk "１．"                             ; 1.
    talk_data $l2
    talk "%K２．"                           ; 2.
    talk_data $l1
    $l6 = 1
    $l7 = 0

L_01F5:
    talk_show 0
    $l5 = 1
    talk_cursor 1
    $l12 = 512

L_0209:
    call effects_run
    if $cur_pressed != 8192 goto L_0235
    $l5 += 1
    if $l5 != 3 goto L_022D
    $l5 = 1

L_022D:
    talk_cursor $l5
    play_se 0

L_0235:
    if $cur_pressed != 4096 goto L_025D
    $l5 -= 1
    if $l5 != 0 goto L_0255
    $l5 = 2

L_0255:
    talk_cursor $l5
    play_se 0

L_025D:
    if $l12 <= 0 goto L_030B
    sprite_scale 50, $l12, 256
    $v00 = $l9
    $v00 += 1
    $l12 -= $v00
    if $cur_pressed != 512 goto L_0209
    if $l5 != 1 goto L_029F
    $l11 = $l6
    goto L_02A5

L_029F:
    $l11 = $l7

L_02A5:
    if $l4 != $l11 goto L_02B7
    play_se 7
    goto L_02BB

L_02B7:
    play_se 8

L_02BB:
    talk_no_cursor
    $l8 = 0

L_02C3:
    $v00 = 1
    call effects_for
    talk_cursor $l5
    $v00 = 3
    call effects_for
    talk_no_cursor
    $l8 += 1
    if $l8 != 3 goto L_02C3
    $v00 = 1
    call effects_for
    if $l4 != $l11 goto L_032F
    $l9 += 1
    goto L_0107

L_030B:
    play_se 8
    sprite_hide 50
    $v00 = 5
    call effects_for
    talk_clear
    talk "Time."
    talk_show 0
    goto L_036B

L_032F:
    $v00 = 50
    sprite_hide 50
    $v00 = 5
    call effects_for
    talk_clear
    talk "I'm sorry, but%Kthe time is up."
    talk_show 0

L_036B:
    call wait_cross
    if $l9 != 0 goto L_03C8
    talk_clear
    talk "Since you didn't get%Kthe answers right, you%Kdidn't win anything."
    talk_show 0
    goto L_041C

L_03C8:
    talk_clear
    talk_number $l9, 0
    talk "問正解でしたので%K"                     ; en: questions right, so /
    talk_show 0
    call money_by_years
    $l10 = $v00
    $l10 /= 2
    $l10 *= $l9
    talk_number $l10, 0
    talk "s prize money."
    earn CUR_PLAYER, $l10                 ; the current player: money + $l10

L_041C:
    talk_show 0
    call wait_cross
    call card_close
    call finish

L_042C:
    $l1 = 0
    $l2 = 90
    $l3 = -2

L_043E:
    talk_clear
    talk "%NMY is answering.%K"
    $l0 = 0

L_045D:
    if $l0 == $l1 goto L_0476
    $l0 += 1
    talk "○"                              ; ○
    goto L_045D

L_0476:
    if $l1 == 16 goto L_04B3
    $l4 = random 100
    if $l4 > $l2 goto L_04B3
    $l2 += $l3
    $l1 += 1
    talk "○"                              ; ○
    talk_show 0
    $v00 = 10
    call effects_for
    goto L_043E

L_04B3:
    talk "×"                              ; ×
    talk_show 0
    $l9 = $l1
    goto L_036B

effects_for:
    ; keep the effects going for $v00 frames
    $l0 = $v00
    $l1 = 0

L_04D2:
    call effects_run
    $l1 += 1
    if $l1 != $l0 goto L_04D2
    return

