    frame 8, time=5, flip=0, next=anim_2A43

fx_tiles_scroll:
    ; FX_TILES: the background tiles drift down and to the left, wrapping around
    $l0 = 10

L_2A59:
    sprite_move_by $l0, -3, 3
    sprite_get_pos $l0, $v00, $v01
    if $v00 > -32 goto L_2A81
    $v00 += 384
    sprite_pos $l0, $v00, $v01

L_2A81:
    if $v01 < 288 goto L_2A99
    $v01 -= 320
    sprite_pos $l0, $v00, $v01

L_2A99:
    $l0 += 1
    if $l0 != 40 goto L_2A59
    return

fx_tiles_grow:
    ; FX_TILES: the background tiles grow to full size
    sprite_get_scale 10, $v00, $v01
    if $v00 == 256 goto L_1787
    $l0 = 10

L_2AC3:
    sprite_scale_by $l0, 16, 16
    $l0 += 1
    if $l0 != 40 goto L_2AC3
    sprite_get_scale 10, $v00, $v01
    if $v00 < 256 goto L_1787
    $l0 = 10

L_2AF3:
    sprite_scale $l0, 256, 256
    $l0 += 1
    if $l0 != 40 goto L_2AF3
    return

tiles_shrink:
    ; the background tiles shrink; hidden once gone
    $l0 = 10

L_2B13:
    sprite_scale_by $l0, -16, -16
    $l0 += 1
    if $l0 != 40 goto L_2B13
    sprite_get_scale 10, $v00, $v01
    if $v00 > 0 goto L_1787
    $l0 = 10

L_2B43:
    sprite_hide $l0
    $l0 += 1
    if $l0 != 40 goto L_2B43
    return

money_by_years:
    ; $v00 = 100 * ($months / 24 + 1): an amount that grows every two years
    $l0 = $months
    $l0 /= 24
    $l0 += 1
    $l0 *= 100
    $v00 = $l0
    return

path_2B79:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_2773, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=-100, anim=anim_2773, next=END  ; move to -100, -100, 10 pixels a frame

path_2B8D:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_27C3, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=-100, anim=anim_27C3, next=END  ; move to 100, -100, 10 pixels a frame

path_2BA1:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_2813, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=100, anim=anim_2813, next=END  ; move to -100, 100, 10 pixels a frame

path_2BB5:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_2863, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=100, anim=anim_2863, next=END  ; move to 100, 100, 10 pixels a frame
