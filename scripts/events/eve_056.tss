; EVE_056.J entry 0
;
; Event 56: never played. Event_PickRandom never draws it, and nothing turns on
; RULE_PICK_EVENT, the debug rule that lets the player pick any event.
; Result ($result of the task): 0 the turn goes on, 1 another event (result_another),
; 2 roll again (result_reroll), 3 move the steps set (move_steps).
;
; What it does: the calendar moves on 4 months.
;
; What it says: "[Young Lady] / An announcement / from the information counter" | "The building is
; being renovated" | "It will take about 4 months, so time / moves forward ∵" | "Stores closed for
; now and broken / elevators will be back sooner"
;
; 6228 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.

; The event card scene's variables (scripts/README.md):
; corner1-4: top left, top right, bottom left, bottom right (sprites 1-4)
; $cornerN_x/_y: position; _dx/_dy: offset for this frame only; _home_x/_y: place in the frame
; $corner_zoom: 256 = full size, this frame; $corner_stretch_x/_y: 50 = no stretch
; $corner_entrance: CORNERS_*; $corner_effects: FX_* bits; $card_entrance: CARD_*
; $card_state: 0 not started, 32767 done (the card routines count in it)
var $corner1_x = $v0A
var $corner1_y = $v0B
var $corner2_x = $v0C
var $corner2_y = $v0D
var $corner3_x = $v0E
var $corner3_y = $v0F
var $corner4_x = $v10
var $corner4_y = $v11
var $corner_zoom = $v12
var $corner_stretch_x = $v13
var $corner_stretch_y = $v14
var $corner1_dx = $v15
var $corner1_dy = $v16
var $corner2_dx = $v17
var $corner2_dy = $v18
var $corner3_dx = $v19
var $corner3_dy = $v1A
var $corner4_dx = $v1B
var $corner4_dy = $v1C
var $corner1_home_x = $v1D
var $corner1_home_y = $v1E
var $corner2_home_x = $v1F
var $corner2_home_y = $v20
var $corner3_home_x = $v21
var $corner3_home_y = $v22
var $corner4_home_x = $v23
var $corner4_home_y = $v24
var $corner_entrance = $v25
var $corner_effects = $v26
var $card_entrance = $v28
var $card_state = $v8C
var $card_angle = $v8D
var $card_sink_step = $v93
var $card_rise_step = $v94
var $pulse_angle = $v96
var $pulse_x_angle = $v97
var $pulse_y_angle = $v98
var $shrink_amount = $v99
var $grow_amount = $v9A
var $corner_steps = $v9B
var $squeeze_y_angle = $v9C
var $squeeze_x_angle = $v9D
var $circle_radius = $v9E
var $circle_angle = $v9F
    call clear_vars
    call scene_setup
    call corners_animate
    $corner_entrance = CORNERS_HOME
    $corner_effects = 0
    $card_entrance = CARD_RISE
    call effects_default
    talk "【お姉さん】%Kインフォメーションカウンターからの%Kお知らせです"  ; en: [Young Lady] / An announcement / from the information counter
    call card_show
    talk_clear
    talk "ビルの改築工事を行います"                   ; en: The building is being renovated
    talk_show 0
    call wait_cross
    talk_clear
    talk "４ヶ月ほどかかるので時間を%K進ませちゃいます∵"       ; en: It will take about 4 months, so time / moves forward ∵
    talk_show 0
    call wait_cross
    talk_clear
    talk "お店がお休みで困っている方や%Kエレベーターが故障で寂しい方%K回復が早くなります"  ; en: Stores closed for now and broken / elevators will be back sooner
    talk_show 0
    call wait_cross
    call card_close
    advance_months 4                      ; the calendar moves on 4 months
    call finish

corners_animate:
    ; start the animations of the card and the four corners
    sprite_animate 0, anim_16CA
    sprite_animate 1, anim_13FA
    sprite_animate 2, anim_144A
    sprite_animate 3, anim_149A
    sprite_animate 4, anim_14EA
    return

corners_animate_alt:
    ; other animations for the corners (not used)
    ; (not reached: nothing jumps here)
    sprite_animate 1, anim_153A
    sprite_animate 2, anim_1572
    sprite_animate 3, anim_15AA
    sprite_animate 4, anim_15E2
    return

corners_animate_alt_2:
    ; other animations for the corners (not used)
    sprite_animate 1, anim_161A
    sprite_animate 2, anim_163A
    sprite_animate 3, anim_161A
    sprite_animate 4, anim_163A
    return

corners_animate_alt_3:
    ; other animations for the corners (not used)
    sprite_animate 1, anim_165A
    sprite_animate 2, anim_1692
    sprite_animate 3, anim_165A
    sprite_animate 4, anim_1692
    return

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_wait_clear:
    ; show the text, wait for cross (180 frames at most), clear the text
    talk_show 0
    wait_buttons_for CROSS|0x300, 180     ; wait for cross, 180 frames at most
    talk_clear
    return

card_close:
    ; close the view and take everything away (corners_leave); wait until the view and the talk
    ; panel are closed
    ; (reached again)
    view_close GROW, 10
    set 0, 0                              ; a constant where a variable belongs: only $result is set
    call corners_leave
    view_wait
    talk_wait_closed
    return

corners_leave:
    ; the corners draw in for 10 frames, the talk panel closes, then they fly off for 15 frames;
    ; meanwhile the card sinks into the talk panel (card_sink) and the tiles shrink
    $l0 = 0
    $card_state = 0

L_01D4:
    $corner1_x += 2
    $corner1_y += 2
    $corner2_x -= 2
    $corner2_y += 2
    $corner3_x += 2
    $corner3_y -= 2
    $corner4_x -= 2
    $corner4_y -= 2
    if $card_entrance == CARD_STILL goto L_0212
    call card_sink

L_0212:
    call effects_run
    call tiles_shrink
    $l0 += 1
    if $l0 != 10 goto L_01D4
    $l0 = 0
    talk_close

L_0232:
    $corner1_x -= 10
    $corner1_y -= 10
    $corner2_x += 10
    $corner2_y -= 10
    $corner3_x -= 10
    $corner3_y += 10
    $corner4_x += 10
    $corner4_y += 10
    call card_sink
    call effects_run
    call tiles_shrink
    $l0 += 1
    if $l0 != 15 goto L_0232
    return

finish:
    ; stop the music; end of the script
    stop_bgm
    end

scene_setup:
    ; the scene: layer 0 (scene image 0); the card (sprite 0, image 7) off screen; the four
    ; corners (sprites 1-4, image 1) at their home positions, worked out from the size of image 1
    ; (the frame fills 320 x 170); the 30 background tiles (sprites 10-39, image 10) in rows of 6;
    ; dim 128; $corner_steps = 20, the zoom and squeeze counters set
    get_image_size 1, $v00, $v01
    $v00 /= 2
    $v01 /= 2
    $corner1_home_x = 0
    $corner1_home_x += $v00
    $corner1_home_y = 0
    $corner1_home_y += $v01
    $corner2_home_x = 320
    $corner2_home_x -= $v00
    $corner2_home_y = 0
    $corner2_home_y += $v01
    $corner3_home_x = 0
    $corner3_home_x += $v00
    $corner3_home_y = 170
    $corner3_home_y -= $v01
    $corner4_home_x = 320
    $corner4_home_x -= $v00
    $corner4_home_y = 170
    $corner4_home_y -= $v01
    $corner1_x = $corner1_home_x
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner2_y = $corner2_home_y
    $corner3_x = $corner3_home_x
    $corner3_y = $corner3_home_y
    $corner4_x = $corner4_home_x
    $corner4_y = $corner4_home_y
    $corner_zoom = 256
    $corner_stretch_x = 50
    $corner_stretch_y = 50
    $v95 = 1
    $shrink_amount = 256
    $grow_amount = 256
    $corner_steps = 20
    $squeeze_y_angle = 8191
    $squeeze_x_angle = 8191
    $circle_radius = 50
    layer_init 0, image=0, pri=31, flags=0
    sprite_init 0, image=7, attr=MIDDLE_CENTER, x=420, y=340, pri=0
    sprite_init 1, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    sprite_init 2, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    sprite_init 3, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    sprite_init 4, image=1, attr=MIDDLE_CENTER, x=-100, y=0, pri=1
    $l0 = 10
    $v00 = 0
    $v01 = 0

L_03C6:
    sprite_init $l0, image=10, attr=MIDDLE_CENTER|SEMITRANS2, x=$v00, y=$v01, pri=-1
    sprite_scale $l0, 0, 0
    $l0 += 1
    $v00 += 64
    if $v00 != 384 goto L_03FE
    $v00 = 0
    $v01 += 64

L_03FE:
    if $l0 != 40 goto L_03C6
    set_dim 128
    return

L_040E:
    return

effects_default:
    ; no corner entrance; only FX_TILES
    $corner_entrance = CORNERS_HOME
    $corner_effects = 0
    $corner_effects |= FX_TILES
    return

card_show:
    ; music 3; open the view and the talk panel; then every frame the corner entrance
    ; ($corner_entrance), the effects ($corner_effects) and the card's entrance ($card_entrance),
    ; until the voice has ended and cross is pressed (a CPU player: 60 frames); then the corners
    ; back home and a sound
    play_bgm 3
    $l0 = 0
    view_set x=64, y=24, w=192, h=128
    view_open GROW, 10
    talk_show 0
    talk_open

L_0444:
    switch $corner_entrance: L_0460, L_0450, L_0458

L_0450:
    ; $corner_entrance = 1
    call corners_spread
    goto L_0460

L_0458:
    ; $corner_entrance = 2
    call corners_fly_in
    goto L_0460

L_0460:
    ; $corner_entrance = 0
    if $corner_effects !& FX_GROW goto L_046E
    call fx_grow

L_046E:
    if $corner_effects !& FX_SHRINK goto L_047C
    call fx_shrink

L_047C:
    if $corner_effects !& FX_CIRCLE goto L_048A
    call fx_circle

L_048A:
    if $corner_effects !& FX_SQUEEZE_X goto L_0498
    call fx_squeeze_x

L_0498:
    if $corner_effects !& FX_SQUEEZE_Y goto L_04A6
    call fx_squeeze_y

L_04A6:
    if $corner_effects !& FX_SPIN goto L_04B4
    call fx_spin

L_04B4:
    if $corner_effects !& FX_PULSE_X goto L_04C2
    call fx_pulse_x

L_04C2:
    if $corner_effects !& FX_PULSE_Y goto L_04D0
    call fx_pulse_y

L_04D0:
    if $corner_effects !& FX_PULSE goto L_04DE
    call fx_pulse

L_04DE:
    if $corner_effects !& FX_TILES goto L_04F0
    call fx_tiles_scroll
    call fx_tiles_grow

L_04F0:
    call card_enter
    call corners_apply
    $l0 += 1
    if $l0 >= 0 goto L_050E
    $l0 = 30

L_050E:
    if $l0 < 30 goto L_0444
    if $l0 != 10 goto L_0526
    nop_34 $card_sink_step                ; no effect in this game

L_0526:
    $v00 = xa_playing
    if $v00 == 1 goto L_0444
    if $cur_is_cpu & CPU goto L_054C
    if $cur_pressed !& CROSS|0x300 goto L_0444
    goto L_0556

L_054C:
    if $l0 < 60 goto L_0444

L_0556:
    $corner1_x = $corner1_home_x
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner2_y = $corner2_home_y
    $corner3_x = $corner3_home_x
    $corner3_y = $corner3_home_y
    $corner4_x = $corner4_home_x
    $corner4_y = $corner4_home_y
    sprite_pos 1, $corner1_home_x, $corner1_home_y
    sprite_pos 2, $corner2_home_x, $corner2_home_y
    sprite_pos 3, $corner3_home_x, $corner3_home_y
    sprite_pos 4, $corner4_home_x, $corner4_home_y
    play_se 1
    return

effects_settle:
    ; (not used) run the effects until the corner entrance, FX_GROW, FX_SHRINK, FX_CIRCLE and the
    ; squeezes have run down, then until the spin and the pulses are back at rest
    ; (not reached: nothing jumps here)
    $vA0 = 0
    if $corner_entrance == CORNERS_HOME goto L_05C2
    $vA0 += $corner_steps

L_05C2:
    if $corner_effects !& FX_GROW goto L_05D2
    $vA0 += $grow_amount

L_05D2:
    if $corner_effects !& FX_SHRINK goto L_05E2
    $vA0 += $shrink_amount

L_05E2:
    if $corner_effects !& FX_CIRCLE goto L_05F2
    $vA0 += $circle_radius

L_05F2:
    if $corner_effects !& FX_SQUEEZE_X goto L_0602
    $vA0 += $squeeze_x_angle

L_0602:
    if $corner_effects !& FX_SQUEEZE_Y goto L_0612
    $vA0 += $squeeze_y_angle

L_0612:
    call corners_apply
    if $vA0 != 0 goto card_show

L_0620:
    $vA0 = 0
    if $corner_effects !& FX_SPIN goto L_0640
    call fx_spin_stop
    sprite_get_angle 1, $v00
    $vA0 += $v00

L_0640:
    if $corner_effects !& FX_PULSE_X goto L_0654
    call fx_pulse_x_stop
    $vA0 += $pulse_x_angle

L_0654:
    if $corner_effects !& FX_PULSE_Y goto L_0668
    call fx_pulse_y_stop
    $vA0 += $pulse_y_angle

L_0668:
    if $corner_effects !& FX_PULSE goto L_067C
    call fx_pulse_stop
    $vA0 += $pulse_angle

L_067C:
    call corners_apply
    if $vA0 != 0 goto L_0620
    return

effects_run:
    ; one frame of the effects that keep going (FX_SPIN, FX_PULSE_X, FX_PULSE_Y, FX_PULSE,
    ; FX_TILES), then corners_apply
    ; (reached again)
    if $corner_effects !& FX_SPIN goto L_069A
    call fx_spin

L_069A:
    if $corner_effects !& FX_PULSE_X goto L_06A8
    call fx_pulse_x

L_06A8:
    if $corner_effects !& FX_PULSE_Y goto L_06B6
    call fx_pulse_y

L_06B6:
    if $corner_effects !& FX_PULSE goto L_06C4
    call fx_pulse

L_06C4:
    if $corner_effects !& FX_TILES goto L_06D2
    call fx_tiles_scroll

L_06D2:
    call corners_apply
    return

corners_apply:
    ; corner positions plus this frame's offsets to sprites 1-4, their scale = $corner_stretch_x/y
    ; * $corner_zoom / 50; offsets, zoom and stretch back to neutral; wait a frame
    $v00 = $corner1_x
    $v01 = $corner1_y
    $v02 = $corner2_x
    $v03 = $corner2_y
    $v04 = $corner3_x
    $v05 = $corner3_y
    $v06 = $corner4_x
    $v07 = $corner4_y
    $v00 += $corner1_dx
    $v01 += $corner1_dy
    $v02 += $corner2_dx
    $v03 += $corner2_dy
    $v04 += $corner3_dx
    $v05 += $corner3_dy
    $v06 += $corner4_dx
    $v07 += $corner4_dy
    $corner1_dx = 0
    $corner1_dy = 0
    $corner2_dx = 0
    $corner2_dy = 0
    $corner3_dx = 0
    $corner3_dy = 0
    $corner4_dx = 0
    $corner4_dy = 0
    sprite_pos 1, $v00, $v01
    sprite_pos 2, $v02, $v03
    sprite_pos 3, $v04, $v05
    sprite_pos 4, $v06, $v07
    $corner_stretch_x *= $corner_zoom
    $corner_stretch_y *= $corner_zoom
    $corner_stretch_x /= 50
    $corner_stretch_y /= 50
    sprite_scale 1, $corner_stretch_x, $corner_stretch_y
    sprite_scale 2, $corner_stretch_x, $corner_stretch_y
    sprite_scale 3, $corner_stretch_x, $corner_stretch_y
    sprite_scale 4, $corner_stretch_x, $corner_stretch_y
    $corner_zoom = 256
    $corner_stretch_x = 50
    $corner_stretch_y = 50
    wait 1
    return

corners_spread:
    ; corner entrance 1: all four start at the center and spread out to their home positions over
    ; $corner_steps frames
    if $corner_steps == 0 goto L_040E
    if $corner_steps == 1 goto L_08B2
    if $corner_steps != 20 goto L_085A
    $v00 = $corner2_home_x
    $v00 -= $corner1_home_x
    $v00 /= 2
    $v00 += $corner1_home_x
    $v01 = $corner3_home_y
    $v01 -= $corner1_home_y
    $v01 /= 2
    $v01 += $corner1_home_y
    $corner1_x = $v00
    $corner1_y = $v01
    $corner2_x = $v00
    $corner2_y = $v01
    $corner3_x = $v00
    $corner3_y = $v01
    $corner4_x = $v00
    $corner4_y = $v01
    goto L_08E2

L_085A:
    $v00 = $corner4_home_x
    $v00 -= $corner4_x
    $v00 /= $corner_steps
    $v01 = $corner4_home_y
    $v01 -= $corner4_y
    $v01 /= $corner_steps
    $corner1_x -= $v00
    $corner1_y -= $v01
    $corner2_x += $v00
    $corner2_y -= $v01
    $corner3_x -= $v00
    $corner3_y += $v01
    $corner4_x += $v00
    $corner4_y += $v01
    goto L_08E2

L_08B2:
    $corner1_x = $corner1_home_x
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner2_y = $corner2_home_y
    $corner3_x = $corner3_home_x
    $corner3_y = $corner3_home_y
    $corner4_x = $corner4_home_x
    $corner4_y = $corner4_home_y

L_08E2:
    $corner_steps -= 1
    return

corners_fly_in:
    ; corner entrance 2: the corners fly in from the edges of the screen over $corner_steps frames
    if $corner_steps == 0 goto L_040E
    if $corner_steps == 1 goto L_0988
    if $corner_steps != 20 goto L_0924
    $corner1_y = 340
    $corner2_x = -100
    $corner3_x = 420
    $corner4_y = -100
    goto L_09A0

L_0924:
    $v00 = $corner1_home_y
    $v00 -= $corner1_y
    $v00 /= $corner_steps
    $v01 = $corner2_home_x
    $v01 -= $corner2_x
    $v01 /= $corner_steps
    $v02 = $corner3_home_x
    $v02 -= $corner3_x
    $v02 /= $corner_steps
    $v03 = $corner4_home_y
    $v03 -= $corner4_y
    $v03 /= $corner_steps
    $corner1_y += $v00
    $corner2_x += $v01
    $corner3_x += $v02
    $corner4_y += $v03
    goto L_09A0

L_0988:
    $corner1_y = $corner1_home_y
    $corner2_x = $corner2_home_x
    $corner3_x = $corner3_home_x
    $corner4_y = $corner4_home_y

L_09A0:
    $corner_steps -= 1
    return

fx_grow:
    ; FX_GROW: zoom = 1 - $grow_amount/256; the amount falls by 10 a frame
    $corner_zoom -= $grow_amount
    $grow_amount -= 10
    if $grow_amount > 0 goto L_040E
    $grow_amount = 0
    return

fx_shrink:
    ; FX_SHRINK: zoom = 1 + $shrink_amount/256; the amount falls by 10 a frame
    $corner_zoom += $shrink_amount
    $shrink_amount -= 10
    if $shrink_amount > 0 goto L_040E
    $shrink_amount = 0
    return

fx_squeeze_x:
    ; FX_SQUEEZE_X: the corners start 100 pixels further apart sideways and ease back
    ; ($squeeze_x_angle)
    $v02 = 8191
    $v02 -= $squeeze_x_angle
    step_toward x=0, y=0, distance=100, angle=$v02, to_x=$v00, to_y=$v01
    $v00 = 100
    $v00 -= $v01
    $corner1_dx -= $v00
    $corner2_dx += $v00
    $corner3_dx -= $v00
    $corner4_dx += $v00
    $squeeze_x_angle -= 400
    if $squeeze_x_angle > 0 goto L_040E
    $squeeze_x_angle = 0
    return

fx_squeeze_y:
    ; FX_SQUEEZE_Y: the same up and down ($squeeze_y_angle)
    $v02 = 8191
    $v02 -= $squeeze_y_angle
    step_toward x=0, y=0, distance=100, angle=$v02, to_x=$v00, to_y=$v01
    $v00 = 100
    $v00 -= $v01
    $corner1_dy -= $v00
    $corner2_dy -= $v00
    $corner3_dy += $v00
    $corner4_dy += $v00
    $squeeze_y_angle -= 400
    if $squeeze_y_angle > 0 goto L_040E
    $squeeze_y_angle = 0
    return

fx_circle:
    ; FX_CIRCLE: the corners circle around their places; the radius $circle_radius falls by 1 a
    ; frame
    step_toward x=0, y=0, distance=$circle_radius, angle=$circle_angle, to_x=$v00, to_y=$v01
    $corner1_dx -= $v00
    $corner1_dy -= $v01
    $corner2_dx += $v00
    $corner2_dy -= $v01
    $corner3_dx -= $v00
    $corner3_dy += $v01
    $corner4_dx += $v00
    $corner4_dy += $v01
    $circle_angle += 1500
    if $circle_angle <= 32767 goto L_0AE4
    $circle_angle -= 32767

L_0AE4:
    $circle_radius -= 1
    if $circle_radius >= 0 goto L_040E
    $circle_radius = 0
    return

fx_pulse:
    ; FX_PULSE: the corners throb (size 1 to 1.5, $pulse_angle)
    step_toward x=0, y=0, distance=128, angle=$pulse_angle, to_x=$v00, to_y=$v01
    if $v00 >= 0 goto L_0B1E
    $corner_zoom -= $v00
    goto L_0B24

L_0B1E:
    $corner_zoom += $v00

L_0B24:
    $pulse_angle += 1500
    if $pulse_angle >= 0 goto L_040E
    $pulse_angle -= 32767
    return

fx_pulse_stop:
    ; stop FX_PULSE at the end of a swing (not used)
    ; (not reached: nothing jumps here)
    if $pulse_angle == 0 goto L_040E
    if $pulse_angle >= 31267 goto L_0B56
    call fx_pulse
    return

L_0B56:
    $pulse_angle = 0
    return

fx_pulse_x:
    ; FX_PULSE_X: the corners turn over sideways, around and around (their width swings between -1
    ; and 1, $pulse_x_angle)
    ; (reached again)
    step_toward x=0, y=0, distance=50, angle=$pulse_x_angle, to_x=$v00, to_y=$v01
    $v00 -= 50
    $corner_stretch_x += $v00
    $pulse_x_angle += 1500
    if $pulse_x_angle >= 0 goto L_040E
    $pulse_x_angle -= 32767
    return

fx_pulse_x_stop:
    ; stop FX_PULSE_X at the end of a swing (not used)
    ; (not reached: nothing jumps here)
    if $pulse_x_angle == 0 goto L_040E
    if $pulse_x_angle >= 31267 goto L_0BAA
    call fx_pulse_x
    return

L_0BAA:
    $pulse_x_angle = 0
    return

fx_pulse_y:
    ; FX_PULSE_Y: the same, turning over top to bottom ($pulse_y_angle)
    ; (reached again)
    step_toward x=0, y=0, distance=50, angle=$pulse_y_angle, to_x=$v00, to_y=$v01
    $v00 -= 50
    $corner_stretch_y += $v00
    $pulse_y_angle += 1500
    if $pulse_y_angle >= 0 goto L_040E
    $pulse_y_angle -= 32767
    return

fx_pulse_y_stop:
    ; stop FX_PULSE_Y at the end of a swing (not used)
    ; (not reached: nothing jumps here)
    if $pulse_y_angle == 0 goto L_040E
    if $pulse_y_angle >= 31267 goto L_0BFE
    call fx_pulse_y
    return

L_0BFE:
    $pulse_y_angle = 0
    return

fx_spin:
    ; FX_SPIN: the corners turn (1 and 3 one way, 2 and 4 the other)
    ; (reached again)
    sprite_rotate 1, -1500
    sprite_rotate 2, 1500
    sprite_rotate 3, -1500
    sprite_rotate 4, 1500
    return

fx_spin_stop:
    ; stop FX_SPIN once the angle is back at 0 (not used)
    ; (not reached: nothing jumps here)
    sprite_get_angle 1, $v00
    if $v00 == 0 goto L_040E
    if $v00 >= 31267 goto L_0C40
    call fx_spin
    return

L_0C40:
    sprite_angle 1, 0
    sprite_angle 2, 0
    sprite_angle 3, 0
    sprite_angle 4, 0
    return

card_slide_left:
    ; CARD_SLIDE_LEFT: the card slides in from the left, slowing down, to the center (160, 120)
    ; (reached again)
    if $card_state == CARD_DONE goto L_040E
    step_toward x=0, y=0, distance=261, angle=$card_angle, to_x=$v01, to_y=$v00
    $v00 -= 100
    sprite_pos 0, $v00, 120
    $card_angle += 1000
    if $v00 < 160 goto L_040E
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_slide_right:
    ; CARD_SLIDE_RIGHT: the card slides in from the right
    if $card_state == CARD_DONE goto L_040E
    step_toward x=0, y=0, distance=261, angle=$card_angle, to_x=$v00, to_y=$v01
    $v00 = 420
    $v00 -= $v01
    sprite_pos 0, $v00, 120
    $card_angle += 1000
    if $v00 > 160 goto L_040E
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_zoom:
    ; CARD_ZOOM: the card appears 16 times its size at the center and shrinks to its size
    if $card_state == CARD_DONE goto L_040E
    if $card_state != 0 goto L_0D18
    sprite_pos 0, 160, 120
    sprite_scale 0, 4096, 4096
    $card_state = 1
    return

L_0D18:
    sprite_scale_by 0, -256, -256
    sprite_get_scale 0, $v00, $v01
    if $v00 > 256 goto L_040E
    sprite_scale 0, 256, 256
    $card_state = CARD_DONE
    return

card_rise:
    ; CARD_RISE: the card grows out of the top of the talk panel, moving right from the center (it
    ; ends at x 240, standing on the panel)
    if $card_state == CARD_DONE goto L_040E
    if $card_state != 0 goto L_0D66
    sprite_scale 0, 0, 0
    $card_state = 1
    return

L_0D66:
    $v00 = 240
    $v00 -= 160
    $v00 *= $card_rise_step
    $v00 /= 16
    $v00 += 160
    get_image_size 7, $v01, $v02
    $v01 = $card_rise_step
    $v01 *= 16
    $v02 *= $v01
    $v02 /= 256
    $v02 /= 2
    $v01 = talk_y
    $v01 -= $v02
    $v01 -= 3
    sprite_pos 0, $v00, $v01
    $card_rise_step += 1
    sprite_scale_by 0, 16, 16
    sprite_get_scale 0, $v00, $v01
    if $v00 < 256 goto L_040E
    sprite_scale 0, 256, 256
    $card_state = CARD_DONE
    return

card_sink:
    ; the card shrinks into the talk panel, moving back to the center, and is hidden
    if $card_state == CARD_DONE goto L_040E
    $v00 = 240
    $v00 -= 160
    $v01 = 8
    $v01 -= $card_sink_step
    $v00 *= $v01
    $v00 /= 8
    $v00 += 160
    get_image_size 7, $v01, $v02
    $v01 = 7
    $v01 -= $card_sink_step
    $v01 *= 32
    $v02 *= $v01
    $v02 /= 256
    $v02 /= 2
    $v01 = talk_y
    $v01 -= $v02
    $v01 -= 3
    sprite_pos 0, $v00, $v01
    $card_sink_step += 1
    sprite_scale_by 0, -32, -32
    sprite_get_scale 0, $v00, $v01
    if $v00 > 0 goto L_040E
    sprite_scale 0, 0, 0
    $card_state = CARD_DONE
    sprite_hide 0
    return

card_spiral:
    ; CARD_SPIRAL: the card spirals in to the center
    if $card_state == CARD_DONE goto L_040E
    $v00 = 260
    $v01 = $card_state
    $v01 *= 13
    $v00 -= $v01
    step_toward x=160, y=120, distance=$v00, angle=$card_angle, to_x=$v01, to_y=$v02
    sprite_pos 0, $v01, $v02
    if $v00 <= 0 goto L_0EFE
    $card_state += 1
    $card_angle += 3000
    if $card_angle >= 0 goto L_040E
    sub 0, 32767                          ; a constant where a variable belongs: only $result is set
    return

L_0EFE:
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_bounce:
    ; CARD_BOUNCE: the card bounces up and down, less and less, into the center
    if $card_state == CARD_DONE goto L_040E
    if $card_state != 0 goto L_0F28
    $card_angle = 24575

L_0F28:
    $v00 = 220
    $v01 = $card_state
    $v01 *= 3
    $v00 -= $v01
    step_toward x=160, y=120, distance=$v00, angle=$card_angle, to_x=$v02, to_y=$v01
    sprite_pos 0, 160, $v01
    if $v00 <= 0 goto L_0F8A
    $card_state += 1
    $v00 = 40
    $v00 *= $card_state
    $card_angle += $v00
    if $card_angle >= 0 goto L_040E
    $card_angle -= 16383
    return

L_0F8A:
    sprite_pos 0, 160, 120
    $card_state = CARD_DONE
    return

card_enter:
    ; one frame of the card's entrance, by $card_entrance
    switch $card_entrance: L_0FAE, L_0FB2, L_0FBA, L_0FC2, L_0FCA, L_0FD2, L_0FDA

L_0FAE:
    ; $card_entrance = 0
    goto L_0FDE

L_0FB2:
    ; $card_entrance = 1
    call card_slide_left
    goto L_0FDE

L_0FBA:
    ; $card_entrance = 2
    call card_slide_right
    goto L_0FDE

L_0FC2:
    ; $card_entrance = 3
    call card_zoom
    goto L_0FDE

L_0FCA:
    ; $card_entrance = 4
    call card_rise
    goto L_0FDE

L_0FD2:
    ; $card_entrance = 5
    call card_spiral
    goto L_0FDE

L_0FDA:
    ; $card_entrance = 6
    call card_bounce

L_0FDE:
    return

wait_cross:
    ; keep the effects going until cross is pressed (a CPU player: 30 frames); a sound
    $l0 = 0

L_0FE6:
    call effects_run
    $l0 += 1
    if $cur_is_cpu & CPU goto L_100A
    if $cur_pressed !& CROSS|0x300 goto L_0FE6
    play_se 1
    return

L_100A:
    if $l0 < 30 goto L_0FE6
    play_se 1
    return

clear_vars:
    ; variables 0x00-0xA4 = 0
    $v00 = 0
    $v01 = 0
    $v02 = 0
