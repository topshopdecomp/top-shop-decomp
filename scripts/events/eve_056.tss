fx_tiles_scroll:
    ; FX_TILES: the background tiles drift down and to the left, wrapping around
    $l0 = 10

L_16E0:
    sprite_move_by $l0, -3, 3
    sprite_get_pos $l0, $v00, $v01
    if $v00 > -32 goto L_1708
    $v00 += 384
    sprite_pos $l0, $v00, $v01

L_1708:
    if $v01 < 288 goto L_1720
    $v01 -= 320
    sprite_pos $l0, $v00, $v01

L_1720:
    $l0 += 1
    if $l0 != 40 goto L_16E0
    return

fx_tiles_grow:
    ; FX_TILES: the background tiles grow to full size
    sprite_get_scale 10, $v00, $v01
    if $v00 == 256 goto L_040E
    $l0 = 10

L_174A:
    sprite_scale_by $l0, 16, 16
    $l0 += 1
    if $l0 != 40 goto L_174A
    sprite_get_scale 10, $v00, $v01
    if $v00 < 256 goto L_040E
    $l0 = 10

L_177A:
    sprite_scale $l0, 256, 256
    $l0 += 1
    if $l0 != 40 goto L_177A
    return

tiles_shrink:
    ; the background tiles shrink; hidden once gone
    $l0 = 10

L_179A:
    sprite_scale_by $l0, -16, -16
    $l0 += 1
    if $l0 != 40 goto L_179A
    sprite_get_scale 10, $v00, $v01
    if $v00 > 0 goto L_040E
    $l0 = 10

L_17CA:
    sprite_hide $l0
    $l0 += 1
    if $l0 != 40 goto L_17CA
    return

money_by_years:
    ; $v00 = 100 * ($months / 24 + 1): an amount that grows every two years
    ; (not reached: nothing jumps here)
    $l0 = $months
    $l0 /= 24
    $l0 += 1
    $l0 *= 100
    $v00 = $l0
    return

path_1800:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_13FA, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=-100, anim=anim_13FA, next=END  ; move to -100, -100, 10 pixels a frame

path_1814:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_144A, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=-100, anim=anim_144A, next=END  ; move to 100, -100, 10 pixels a frame

path_1828:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_149A, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=100, anim=anim_149A, next=END  ; move to -100, 100, 10 pixels a frame

path_183C:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_14EA, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=100, anim=anim_14EA, next=END  ; move to 100, 100, 10 pixels a frame
    words 0, 0    ; padding
