fx_tiles_scroll:
    ; FX_TILES: the background tiles drift down and to the left, wrapping around
    $l0 = 10

L_166B:
    sprite_move_by $l0, -3, 3
    sprite_get_pos $l0, $v00, $v01
    if $v00 > -32 goto L_1693
    $v00 += 384
    sprite_pos $l0, $v00, $v01

L_1693:
    if $v01 < 288 goto L_16AB
    $v01 -= 320
    sprite_pos $l0, $v00, $v01

L_16AB:
    $l0 += 1
    if $l0 != 40 goto L_166B
    return

fx_tiles_grow:
    ; FX_TILES: the background tiles grow to full size
    sprite_get_scale 10, $v00, $v01
    if $v00 == 256 goto L_0399
    $l0 = 10

L_16D5:
    sprite_scale_by $l0, 16, 16
    $l0 += 1
    if $l0 != 40 goto L_16D5
    sprite_get_scale 10, $v00, $v01
    if $v00 < 256 goto L_0399
    $l0 = 10

L_1705:
    sprite_scale $l0, 256, 256
    $l0 += 1
    if $l0 != 40 goto L_1705
    return

tiles_shrink:
    ; the background tiles shrink; hidden once gone
    $l0 = 10

L_1725:
    sprite_scale_by $l0, -16, -16
    $l0 += 1
    if $l0 != 40 goto L_1725
    sprite_get_scale 10, $v00, $v01
    if $v00 > 0 goto L_0399
    $l0 = 10

L_1755:
    sprite_hide $l0
    $l0 += 1
    if $l0 != 40 goto L_1755
    return

money_by_years:
    ; $v00 = 100 * ($months / 24 + 1): an amount that grows every two years
    ; (not reached: nothing jumps here)
    $l0 = $months
    $l0 /= 24
    $l0 += 1
    $l0 *= 100
    $v00 = $l0
    return

path_178B:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_1385, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=-100, anim=anim_1385, next=END  ; move to -100, -100, 10 pixels a frame

path_179F:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_13D5, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=-100, anim=anim_13D5, next=END  ; move to 100, -100, 10 pixels a frame

path_17B3:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_1425, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=100, anim=anim_1425, next=END  ; move to -100, 100, 10 pixels a frame

path_17C7:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_1475, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=100, anim=anim_1475, next=END  ; move to 100, 100, 10 pixels a frame
    bytes 0x00, 0x00, 0x00, 0x00, 0x00    ; padding
