fx_tiles_scroll:
    ; FX_TILES: the background tiles drift down and to the left, wrapping around
    $l0 = 10

L_163C:
    sprite_move_by $l0, -3, 3
    sprite_get_pos $l0, $v00, $v01
    if $v00 > -32 goto L_1664
    $v00 += 384
    sprite_pos $l0, $v00, $v01

L_1664:
    if $v01 < 288 goto L_167C
    $v01 -= 320
    sprite_pos $l0, $v00, $v01

L_167C:
    $l0 += 1
    if $l0 != 40 goto L_163C
    return

fx_tiles_grow:
    ; FX_TILES: the background tiles grow to full size
    sprite_get_scale 10, $v00, $v01
    if $v00 == 256 goto L_036A
    $l0 = 10

L_16A6:
    sprite_scale_by $l0, 16, 16
    $l0 += 1
    if $l0 != 40 goto L_16A6
    sprite_get_scale 10, $v00, $v01
    if $v00 < 256 goto L_036A
    $l0 = 10

L_16D6:
    sprite_scale $l0, 256, 256
    $l0 += 1
    if $l0 != 40 goto L_16D6
    return

tiles_shrink:
    ; the background tiles shrink; hidden once gone
    $l0 = 10

L_16F6:
    sprite_scale_by $l0, -16, -16
    $l0 += 1
    if $l0 != 40 goto L_16F6
    sprite_get_scale 10, $v00, $v01
    if $v00 > 0 goto L_036A
    $l0 = 10

L_1726:
    sprite_hide $l0
    $l0 += 1
    if $l0 != 40 goto L_1726
    return

money_by_years:
    ; $v00 = 100 * ($months / 24 + 1): an amount that grows every two years
    ; (not reached: nothing jumps here)
    $l0 = $months
    $l0 /= 24
    $l0 += 1
    $l0 *= 100
    $v00 = $l0
    return

path_175C:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_1356, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=-100, anim=anim_1356, next=END  ; move to -100, -100, 10 pixels a frame

path_1770:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_13A6, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=-100, anim=anim_13A6, next=END  ; move to 100, -100, 10 pixels a frame

path_1784:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_13F6, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=-100, y=100, anim=anim_13F6, next=END  ; move to -100, 100, 10 pixels a frame

path_1798:
    ; (nothing names this)
    step speed=2, x=-32768, y=-32767, anim=anim_1446, next=NEXT  ; move to -32768, -32767, 2 pixels a frame
    step speed=10, x=100, y=100, anim=anim_1446, next=END  ; move to 100, 100, 10 pixels a frame
    words 0, 0    ; padding
