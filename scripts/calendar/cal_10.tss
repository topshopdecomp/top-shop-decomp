; CAL_10.J entry 0
;
; The calendar page of October (Board_Task steps 2100-2120, with event scenes on).
; The picture: Halloween: a werewolf howls (images 0-2) with the word AOHOOON (image 5); a witch
; on a broom (image 3) and a cat (image 4) fly across.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 1584 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    call clear_vars
    sprite_init 0, image=0, attr=0, x=203, y=67, pri=0
    sprite_init 1, image=3, attr=0, x=12, y=87, pri=2
    sprite_init 2, image=4, attr=0, x=133, y=116, pri=3
    sprite_init 3, image=5, attr=BOTTOM_RIGHT, x=220, y=98, pri=1
    sprite_animate 0, anim_0228
    sprite_scale 3, 0, 0
    fade_in 15
    $v96 = 320
    $v97 = 0
    $v98 = 0

L_0060:
    sprite_get_pos 3, $v00, $v01
    if $v00 >= 0 goto L_0092
    sprite_pos 3, 220, 100
    sprite_scale 3, 0, 0
    $v9E = 0
    sprite_animate 0, anim_0228
    goto L_00D4

L_0092:
    step_toward x=0, y=0, distance=220, angle=$v9E, to_x=$v00, to_y=$v01
    $v01 = 220
    $v01 -= $v00
    $v01 /= 8
    $v01 *= -1
    $v01 += 100
    sprite_pos 3, $v00, $v01
    sprite_scale_by 3, 8, 8
    $v9E += 80

L_00D4:
    if $v98 != 0 goto L_0162
    if $v96 > -120 goto L_00FE
    $v98 = 1
    sprite_animate 1, anim_0210
    sprite_animate 2, anim_0220
    goto L_0162

L_00FE:
    step_toward x=0, y=80, distance=16, angle=$v97, to_x=$v01, to_y=$v00
    $v02 = $v97
    $v02 += 16384
    step_toward x=0, y=80, distance=32, angle=$v02, to_x=$v03, to_y=$v01
    $v02 = $v96
    $v02 += 80
    sprite_pos 1, $v96, $v00
    sprite_pos 2, $v02, $v01
    $v96 -= 3
    $v97 += 512
    if $v97 >= 0 goto L_01E2
    $v97 -= 32767
    goto L_01E2

L_0162:
    if $v96 < 420 goto L_0182
    $v98 = 0
    sprite_animate 1, anim_0208
    sprite_animate 2, anim_0218
    goto L_00FE

L_0182:
    step_toward x=0, y=80, distance=16, angle=$v97, to_x=$v01, to_y=$v00
    $v02 = $v97
    $v02 += 16384
    step_toward x=0, y=80, distance=32, angle=$v02, to_x=$v03, to_y=$v01
    $v02 = $v96
    $v02 -= 80
    sprite_pos 1, $v96, $v00
    sprite_pos 2, $v02, $v01
    $v96 += 3
    $v97 += 512
    if $v97 >= 0 goto L_01E2
    $v97 -= 32767

L_01E2:
    $v9F += 1
    wait 1
    if $v9F == 300 goto L_0200
    if $any_pressed !& CROSS|0x300 goto L_0060

L_0200:
    fade_out 15
    wait_fade
    end

anim_0208:
    frame 3, time=1, flip=0, next=END

anim_0210:
    frame 3, time=1, flip=FLIP_X, next=END

anim_0218:
    frame 4, time=1, flip=0, next=END

anim_0220:
