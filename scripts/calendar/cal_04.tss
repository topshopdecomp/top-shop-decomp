; CAL_04.J entry 0
;
; The calendar page of April (Board_Task steps 2100-2120, with event scenes on).
; The picture: spring: a sleeping character and the cactus waking up (images 0-6); butterflies
; (images 12-17) flutter across in three flights.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 2140 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    call clear_vars
    sprite_init 30, image=0, attr=0, x=16, y=30, pri=1
    sprite_init 31, image=3, attr=0, x=245, y=55, pri=2
    sprite_init 32, image=6, attr=0, x=111, y=184, pri=3
    sprite_animate 30, anim_07AA
    sprite_animate 31, anim_07CA
    sprite_animate 32, anim_07EA
    $l0 = 0

L_0046:
    switch $l0: L_0052, L_006A, L_0082

L_0052:
    ; $l0 = 0
    sprite_init $vA0, image=12, attr=MIDDLE_CENTER, x=0, y=0, pri=0
    sprite_animate $vA0, anim_07FA
    goto L_009A

L_006A:
    ; $l0 = 1
    sprite_init $vA0, image=14, attr=MIDDLE_CENTER, x=-200, y=200, pri=0
    sprite_animate $vA0, anim_081A
    goto L_009A

L_0082:
    ; $l0 = 2
    sprite_init $vA0, image=16, attr=MIDDLE_CENTER, x=-400, y=400, pri=0
    sprite_animate $vA0, anim_083A
