L_009A:
    $l0 += 1
    if $l0 != 3 goto L_00B0
    $l0 = 0

L_00B0:
    $vA0 += 1
    if $vA0 != 20 goto L_0046
    $vA0 = 0

L_00C6:
    call butterfly_new
    $vA0 += 1
    if $vA0 != 20 goto L_00C6
    fade_in 15

L_00DE:
    $vA0 = 0

L_00E4:
    call butterfly_fly
    $vA0 += 1
    if $vA0 != 20 goto L_00E4
    $vA0 = 0

L_00FE:
    $v04 = $vA0
    $v04 *= 5
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v00 /= 10
    $v01 /= 10
    sprite_pos $vA0, $v00, $v01
    $vA0 += 1
    if $vA0 != 20 goto L_00FE
    $v9F += 1
    wait 1
    $vA0 = 0

L_014E:
    $vA0 += 1
    if $vA0 != 20 goto L_014E
    if $v9F == 300 goto L_0172
    if $any_pressed !& CROSS|0x300 goto L_00DE

L_0172:
    fade_out 15
    wait_fade
    end

