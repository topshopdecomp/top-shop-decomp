    step_toward x=0, y=$v01, distance=$v07, angle=$v06, to_x=$v08, to_y=$v01
    $v08 = random 1000
    $v05 += 1000
    $v05 += $v08
    if $v05 >= 0 goto L_06D6
    $v05 -= 32767

L_06D6:
