butterfly_new:
    ; butterfly $vA0: a random place, size, wing state and heading (records of 5 from $v0A)
    $v00 = random 3200
    $v01 = random 2000
    $v04 = $vA0
    $v04 *= 5
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    $v00 = random 50
    $v0C[$v04] = $v00
    $v00 += 100
    $v00 *= 1
    sprite_scale $vA0, $v00, $v00
    $v00 = random 2
    $v0D[$v04] = $v00
    $v00 = random 32767
    $v0E[$v04] = $v00
    return

butterfly_fly:
    ; butterfly $vA0 changes its wing animation one frame in 100 (one of three colors by $vA0 % 3)
    ; and flutters along, weaving up and down
    $v04 = $vA0
    $v04 *= 5
    $v03 = $v0D[$v04]
    $v00 = random 100
    $l0 = $vA0
    $l0 %= 3
    if $v00 != 0 goto L_0668
    if $v03 == 1 goto L_0630
    $v03 = 1
    switch $l0: L_060E, L_0618, L_0622

L_060E:
    ; $l0 = 0
    sprite_animate $vA0, anim_07FA
    goto L_062C

L_0618:
