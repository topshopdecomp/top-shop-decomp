; CAL_02.J entry 0
;
; The calendar page of February (Board_Task steps 2100-2120, with event scenes on).
; The picture: a snowman (images 0-8) on the page; eight snowballs (image 13) drift about at
; random; a small snowman head (image 9) rolls in from the right and back, spinning.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 1912 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    call clear_vars
    sprite_init 30, image=0, attr=0, x=192, y=80, pri=2
    sprite_init 31, image=3, attr=0, x=64, y=32, pri=3
    sprite_init 32, image=5, attr=0, x=48, y=112, pri=4
    sprite_init 33, image=6, attr=0, x=96, y=64, pri=5
    sprite_init 34, image=9, attr=MIDDLE_CENTER, x=520, y=148, pri=6
    sprite_animate 30, anim_06FA
    sprite_animate 31, anim_071A
    sprite_animate 33, anim_073A

L_005C:
    sprite_init $vA0, image=13, attr=MIDDLE_CENTER, x=0, y=0, pri=1
    $vA0 += 1
    if $vA0 != 8 goto L_005C
    $vA0 = 0

L_0080:
    call snowball_new
    $v00 = random 2400
    $v0B[$v04] = $v00
    $vA0 += 1
    if $vA0 != 8 goto L_0080
    fade_in 15

L_00A6:
    $vA0 = 0

L_00AC:
    call snowball_fall
    $vA0 += 1
    if $vA0 != 8 goto L_00AC
    $vA0 = 0

L_00C6:
    $v04 = $vA0
    $v04 *= 6
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v02 = $v0E[$v04]
    $v03 = $v0F[$v04]
    $v05 = $v0C[$v04]
    $v00 /= 10
    $v02 /= 3
    $v00 += $v02
    $v01 /= 10
    sprite_pos $vA0, $v00, $v01
    $v03 += $v05
    $v03 /= 2
    sprite_scale $vA0, $v03, $v03
    $vA0 += 1
    if $vA0 != 8 goto L_00C6
    $v9F += 1
    sprite_get_pos 34, $v00, $v01
    if $v9E != 0 goto L_018E
    sprite_move_by 34, -5, 0
    sprite_rotate 34, 2048
    if $v00 > -200 goto L_01C2
    sprite_init 34, image=9, attr=MIDDLE_CENTER, x=-200, y=220, pri=0
    sprite_scale 34, 1024, 1024
    $v9E = 1
    goto L_01C2

L_018E:
    sprite_move_by 34, 15, 0
    sprite_rotate 34, -2048
    if $v00 < 520 goto L_01C2
    sprite_init 34, image=9, attr=MIDDLE_CENTER, x=520, y=148, pri=6
    sprite_scale 34, 256, 256
    $v9E = 0

L_01C2:
    wait 1
    $vA0 = 0

L_01CC:
    $v04 = $vA0
    $v04 *= 6
    $v01 = $v0B[$v04]
    if $v01 <= 3400 goto L_01EE
    call snowball_new

L_01EE:
    $vA0 += 1
    if $vA0 != 8 goto L_01CC
    if $v9F == 300 goto L_0212
    if $any_pressed !& CROSS|0x300 goto L_00A6

L_0212:
    fade_out 15
    wait_fade
    end

