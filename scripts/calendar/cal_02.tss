snowball_new:
    ; snowball $vA0 (sprite $vA0): a random x along the top, a random size (150-229, 256 = full)
    ; and sway angle. Particles are records of 6 variables from $v0A: x and y in tenths of a
    ; pixel, size, sway angle, sway x, sway y
    $v01 = 0
    $v00 = random 3200
    $v04 = $vA0
    $v04 *= 6
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    $v00 = random 80
    $v00 += 150
    $v00 *= 1
    $v0C[$v04] = $v00
    sprite_scale $vA0, $v00, $v00
    $v00 = random 32767
    $v0D[$v04] = $v00
    return

snowball_fall:
    ; snowball $vA0 sways (wider for bigger ones) and falls 5-9 + size/16 tenths of a pixel
    $v04 = $vA0
    $v04 *= 6
    $v02 = $v0C[$v04]
    $v02 /= 8
    $v03 = $v0D[$v04]
    $v05 = 10
    $v05 += $v02
    step_toward x=0, y=0, distance=$v05, angle=$v03, to_x=$v00, to_y=$v01
    $v0E[$v04] = $v00
    $v0F[$v04] = $v01
    $v00 = random 200
    $v03 += 200
    $v03 += $v00
    if $v03 > 0 goto L_06C2
    $v03 -= 32767

L_06C2:
    $v0D[$v04] = $v03
    $v00 = random 5
    $v00 += 5
    $v02 /= 2
    $v00 += $v02
    $v01 = $v0B[$v04]
    $v01 += $v00
    $v0B[$v04] = $v01
    return

anim_06FA:
    frame 0, time=60, flip=0, next=anim_0702

anim_0702:
    frame 1, time=8, flip=0, next=NEXT
    frame 2, time=16, flip=0, next=NEXT
    frame 0, time=66, flip=0, next=anim_0702

