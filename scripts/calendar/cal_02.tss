    frame 8, time=8, flip=0, next=NEXT
    frame 6, time=62, flip=0, next=anim_0742

anim_075A:
    ; (nothing names this)
    frame 9, time=8, flip=0, next=END

path_0762:
    ; (nothing names this)
    step speed=5, x=-40, y=152, anim=anim_075A, next=END  ; move to -40, 152, 5 pixels a frame

path_076C:
    ; (nothing names this)
    step speed=5, x=360, y=152, anim=anim_075A, next=END  ; move to 360, 152, 5 pixels a frame
    words 0    ; padding
