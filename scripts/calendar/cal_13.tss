; CAL_13.J entry 0
;
; Not loaded by the game (CalendarFile in src/board.c gives CAL_01-CAL_12 only).
; The picture: the same script and pictures as January (CAL_01).
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 1296 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    call clear_vars
    sprite_init 0, image=0, attr=0, x=0, y=117, pri=2
    sprite_init 1, image=1, attr=0, x=263, y=175, pri=0
    sprite_init 2, image=3, attr=0, x=0, y=111, pri=1
    sprite_animate 1, anim_04E0
    $v9C = 1100
    fade_in 15

L_003E:
    if $v9D != 0 goto L_0068
    $v9E += 1
    $v9C += 4
    if $v9E < 55 goto L_0084
    $v9D = 1
    goto L_0084

L_0068:
    $v9E -= 1
    $v9C -= 4
    if $v9E > 0 goto L_0084
    $v9D = 0

L_0084:
    $v00 = $v9C
    $v00 /= 10
    $v01 = 132
    $v01 -= $v00
    step_toward x=0, y=0, distance=$v01, angle=$v9B, to_x=$v00, to_y=$v01
    $v9B += 1024
    if $v9B >= 0 goto L_00C0
    $v9B -= 32767

L_00C0:
    $v00 = $v9C
    $v00 /= 10
    $v00 += $v01
    sprite_pos 0, $v9E, $v00
    $v9F += 1
    wait 1
    if $v9F == 300 goto L_00F8
    if $any_pressed !& CROSS|0x300 goto L_003E

L_00F8:
    fade_out 15
    wait_fade
    end

