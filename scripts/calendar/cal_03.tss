; CAL_03.J entry 0
;
; The calendar page of March (Board_Task steps 2100-2120, with event scenes on).
; The picture: cherry blossoms: a character under a blossoming tree (images 0, 1, 5, 7), the
; cactus swinging on a swing; petals (image 9) fall at random.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 1692 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CAL_03"                       ; a name for the script; costs a frame
    call clear_vars
    sprite_init 30, image=0, attr=MIDDLE_CENTER, x=161, y=118, pri=1
    sprite_init 31, image=0, attr=MIDDLE_CENTER|FLIP_X, x=195, y=118, pri=1
    sprite_init 32, image=1, attr=0, x=48, y=112, pri=2
    sprite_init 33, image=5, attr=0, x=240, y=128, pri=3
    sprite_init 34, image=7, attr=0, x=64, y=80, pri=4
    sprite_animate 32, anim_0631
    sprite_animate 33, anim_0671
    sprite_animate 34, anim_0651

L_0065:
    sprite_init $vA0, image=9, attr=MIDDLE_CENTER, x=0, y=0, pri=0
    sprite_animate $vA0, anim_0681
    $vA0 += 1
    if $vA0 != 20 goto L_0065
    $vA0 = 0

L_008F:
    call petal_new
    $vA0 += 1
    if $vA0 != 20 goto L_008F
    fade_in 15

L_00A7:
    $vA0 = 0

L_00AD:
    call petal_fall
    $vA0 += 1
    if $vA0 != 20 goto L_00AD
    $vA0 = 0

L_00C7:
    $v04 = $vA0
    $v04 *= 3
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v00 /= 10
    $v01 /= 10
    sprite_pos $vA0, $v00, $v01
    $vA0 += 1
    if $vA0 != 20 goto L_00C7
    sprite_rotate 30, -1024
    sprite_rotate 31, 1024
    $v9F += 1
    wait 1
    $vA0 = 0

L_0123:
    $v04 = $vA0
    $v04 *= 3
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    if $v00 < 0 goto L_0153
    if $v01 <= 2400 goto L_0157

L_0153:
    call petal_new

L_0157:
    $vA0 += 1
    if $vA0 != 20 goto L_0123
    if $v9F == 300 goto L_017B
    if $any_pressed !& CROSS|0x300 goto L_00A7

L_017B:
    fade_out 15
    wait_fade
    end

