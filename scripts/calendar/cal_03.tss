petal_new:
    ; petal $vA0: a random place along the top or the right edge, a random size (records of 3 from
    ; $v0A: x, y in tenths of a pixel, size)
    $v01 = 0
    $v00 = random 6400
    if $v00 < 3200 goto L_0585
    $v00 = 3200
    $v01 = random 2400

L_0585:
    $v04 = $vA0
    $v04 *= 3
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    $v00 = random 50
    $v0C[$v04] = $v00
    $v00 += 100
    $v00 *= 1
    sprite_scale $vA0, $v00, $v00
    return

petal_fall:
    ; petal $vA0 drifts left and down, bigger ones faster
    $v04 = $vA0
    $v04 *= 3
    $v00 = random 10
    $v00 += 20
    $v02 = $v0C[$v04]
    $v02 /= 3
    $v00 += $v02
    $v01 = $v0A[$v04]
    $v01 -= $v00
    $v0A[$v04] = $v01
    $v00 = random 5
    $v00 += 15
    $v00 += $v02
    $v01 = $v0B[$v04]
    $v01 += $v00
    $v0B[$v04] = $v01
    return

