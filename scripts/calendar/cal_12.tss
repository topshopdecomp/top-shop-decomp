; CAL_12.J entry 0
;
; The calendar page of December (Board_Task steps 2100-2120, with event scenes on).
; The picture: Christmas: reindeer (image 0) prance in a row, a girl in a Santa hat (images 1-2),
; chicks (images 3-5); snowflakes (image 6) fall at random.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 2064 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CAL_12"                       ; a name for the script; costs a frame
    call clear_vars
    $v96 = 104
    $v97 = 0
    $v98 = 24
    $v99 = 20480
    $v9A = -56
    $v9B = 8192
    $v9C = -136
    $v9D = 28672
    sprite_init 30, image=0, attr=0, x=104, y=240, pri=1
    sprite_init 31, image=0, attr=0, x=104, y=240, pri=2
    sprite_init 32, image=0, attr=0, x=104, y=240, pri=3
    sprite_init 33, image=0, attr=0, x=104, y=240, pri=4
    sprite_init 34, image=0, attr=FLIP_X, x=104, y=240, pri=4
    sprite_init 35, image=1, attr=0, x=96, y=32, pri=5
    sprite_init 36, image=3, attr=0, x=16, y=96, pri=6
    sprite_animate 35, anim_0785
    sprite_animate 36, anim_07C5
    sprite_path 34, path_07E5

L_00B1:
    sprite_init $vA0, image=6, attr=MIDDLE_CENTER, x=0, y=0, pri=0
    $vA0 += 1
    if $vA0 != 23 goto L_00B1
    $vA0 = 0

L_00D5:
    call snowball_new
    $v00 = random 2400
    $v0B[$v04] = $v00
    $vA0 += 1
    if $vA0 != 23 goto L_00D5
    fade_in 15

L_00FB:
    $vA0 = 0

L_0101:
    call snow_fall
    $vA0 += 1
    if $vA0 != 23 goto L_0101
    $vA0 = 0

L_011B:
    $v04 = $vA0
    $v04 *= 6
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v02 = $v0E[$v04]
    $v03 = $v0F[$v04]
    $v05 = $v0C[$v04]
    $v00 /= 10
    $v02 /= 3
    $v00 += $v02
    $v01 /= 10
    sprite_pos $vA0, $v00, $v01
    sprite_rotate $vA0, 500
    $v03 += $v05
    sprite_scale $vA0, $v03, $v03
    $vA0 += 1
    if $vA0 != 23 goto L_011B
    $vA0 = 0

L_0199:
    call reindeer_prance
    $vA0 += 1
    if $vA0 != 4 goto L_0199
    $v9F += 1
    wait 1
    $vA0 = 0

L_01BD:
    $v04 = $vA0
    $v04 *= 6
    $v01 = $v0B[$v04]
    if $v01 <= 2400 goto L_01DF
    call snowball_new

L_01DF:
    $vA0 += 1
    if $vA0 != 23 goto L_01BD
    if $v9F == 300 goto L_0203
    if $any_pressed !& CROSS|0x300 goto L_00FB

L_0203:
    fade_out 15
    wait_fade
    end

