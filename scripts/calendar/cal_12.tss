snowball_new:
    ; snowball $vA0 (sprite $vA0): a random x along the top, a random size (150-229, 256 = full)
    ; and sway angle. Particles are records of 6 variables from $v0A: x and y in tenths of a
    ; pixel, size, sway angle, sway x, sway y
    $v01 = 0
    $v00 = random 3200
    $v04 = $vA0
    $v04 *= 6
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    $v00 = random 80
    $v00 += 150
    $v00 *= 1
    $v0C[$v04] = $v00
    sprite_scale $vA0, $v00, $v00
    $v00 = random 32767
    $v0D[$v04] = $v00
    return

snow_fall:
    ; snowflake $vA0 sways and falls
    $v04 = $vA0
    $v04 *= 6
    $v02 = $v0C[$v04]
    $v02 /= 8
    $v03 = $v0D[$v04]
    $v05 = 10
    $v05 += $v02
    step_toward x=0, y=0, distance=$v05, angle=$v03, to_x=$v00, to_y=$v01
    $v0E[$v04] = $v00
    $v0F[$v04] = $v01
    $v00 = random 200
    $v03 += 200
    $v03 += $v00
    if $v03 > 0 goto L_06B3
    $v03 -= 32767

L_06B3:
    $v0D[$v04] = $v03
    $v02 /= 2
    $v00 = random 3
    $v00 += 5
    $v00 += $v02
    $v01 = $v0B[$v04]
    $v01 += $v00
    $v0B[$v04] = $v01
    return

reindeer_prance:
    ; reindeer $vA0 (sprite 30 + $vA0) moves up to the right 5 pixels a frame, bobbing, and starts
    ; again from the left when far off screen
    $l0 = $vA0
    $l6 = $vA0
    $l6 += 30
    $l0 *= 2
    $l1 = $v96[$l0]
    $l3 = $v97[$l0]
    $l2 = 360
    $l2 -= $l1
    step_toward x=0, y=0, distance=8, angle=$l3, to_x=$l4, to_y=$l5
    $l5 = $l4
    $l4 += $l1
    $l5 += $l2
    sprite_pos $l6, $l4, $l5
    $l1 += 5
    $l3 += 1280
    if $l1 < 1000 goto L_0763
    $l1 = 136

L_0763:
    if $l3 >= 0 goto L_0773
    $l3 -= 32767

L_0773:
    $v96[$l0] = $l1
    $v97[$l0] = $l3
    return

anim_0785:
    frame 1, time=48, flip=0, next=NEXT
    frame 2, time=8, flip=0, next=NEXT
    frame 1, time=8, flip=0, next=NEXT
    frame 2, time=8, flip=0, next=NEXT
    frame 1, time=80, flip=0, next=NEXT
    frame 2, time=8, flip=0, next=NEXT
    frame 1, time=8, flip=0, next=NEXT
    frame 2, time=8, flip=0, next=anim_0785

anim_07C5:
    frame 3, time=6, flip=0, next=NEXT
    frame 4, time=6, flip=0, next=NEXT
    frame 5, time=16, flip=0, next=anim_07C5

anim_07DD:
    frame 0, time=8, flip=FLIP_X, next=END

path_07E5:
    step speed=0, x=100, y=0, anim=anim_07DD, next=path_07EF  ; wait 100 frames

path_07EF:
    step speed=10, x=320, y=24, anim=anim_07DD, next=NEXT  ; move to 320, 24, 10 pixels a frame
    step speed=-1, x=104, y=240, anim=anim_07DD, next=NEXT  ; jump to 104, 240
    step speed=0, x=150, y=0, anim=anim_07DD, next=path_07EF  ; wait 150 frames
    bytes 0x00, 0x00, 0x00    ; padding
