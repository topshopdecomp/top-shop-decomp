; CAL_07.J entry 0
;
; The calendar page of July (Board_Task steps 2100-2120, with event scenes on).
; The picture: summer fireworks: two characters seen from behind on a hill (image 9) watch rockets
; (image 3) burst into fireworks (images 0-2, 5-8) at random.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 1920 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CAL_07"                       ; a name for the script; costs a frame
    call clear_vars
    sprite_init 30, image=0, attr=DIM, x=1, y=86, pri=2
    sprite_init 31, image=1, attr=DIM, x=115, y=51, pri=3
    sprite_init 32, image=2, attr=DIM, x=210, y=67, pri=4
    sprite_init 33, image=9, attr=0, x=0, y=149, pri=0
    set_dim 255

L_0049:
    sprite_init $vA0, image=3, attr=MIDDLE_CENTER, x=0, y=0, pri=1
    sprite_animate $vA0, anim_076F
    $vA0 += 1
    if $vA0 != 6 goto L_0049
    $vA0 = 0

L_0073:
    call rocket_new
    $v00 = random 2400
    $v0B[$v04] = $v00
    $vA0 += 1
    if $vA0 != 6 goto L_0073
    fade_in 15

L_0099:
    $vA0 = 0

L_009F:
    call rocket_rise
    $vA0 += 1
    if $vA0 != 6 goto L_009F
    $vA0 = 0

L_00B9:
    $v04 = $vA0
    $v04 *= 6
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v02 = $v0E[$v04]
    $v03 = $v0F[$v04]
    $v05 = $v0C[$v04]
    if $v01 == 30000 goto L_0117
    $v00 /= 10
    $v02 /= 3
    $v00 += $v02
    $v01 /= 10
    sprite_pos $vA0, $v00, $v01

L_0117:
    $vA0 += 1
    if $vA0 != 6 goto L_00B9
    $v9F += 1
    call fireworks_flash
    set_dim $v9E
    wait 1
    $vA0 = 0

L_013F:
    $v04 = $vA0
    $v04 *= 6
    $v01 = $v0B[$v04]
    if $v01 == 30000 goto L_0199
    if $v01 >= 1500 goto L_01B3
    $v00 = random 8
    if $v00 != 0 goto L_01B3
    $v0B[$v04] = 30000
    $l0 = $v0C[$v04]
    sprite_scale $vA0, $l0, $l0
    sprite_animate $vA0, anim_074F
    goto L_01B3

L_0199:
    sprite_get_state $vA0, $v00
    if $v00 != 0 goto L_01B3
    sprite_animate $vA0, anim_076F
    call rocket_new

L_01B3:
    $vA0 += 1
    if $vA0 != 6 goto L_013F
    if $v9F == 300 goto L_01D7
    if $any_pressed !& CROSS|0x300 goto L_0099

L_01D7:
    fade_out 15
    wait_fade
    end

