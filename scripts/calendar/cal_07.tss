rocket_new:
    ; rocket $vA0: a random x along the bottom, a random size (records of 6 from $v0A)
    $v00 = random 3200
    $v01 = 2400
    $v04 = $vA0
    $v04 *= 6
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    $v00 = random 300
    $v00 += 100
    $v00 *= 1
    $v0C[$v04] = $v00
    $v00 /= 2
    sprite_scale $vA0, $v00, $v00
    $v00 = random 32767
    $v0D[$v04] = $v00
    return

rocket_rise:
    ; rocket $vA0 rises, wobbling (y = 30000: it has burst and stays)
    $v04 = $vA0
    $v04 *= 6
    $v00 = $v0B[$v04]
    if $v00 == 30000 goto L_06CF
    $v02 = $v0C[$v04]
    $v02 /= 8
    $v03 = $v0D[$v04]
    $v05 = 5
    $v05 += $v02
    step_toward x=0, y=0, distance=$v05, angle=$v03, to_x=$v00, to_y=$v01
    $v0E[$v04] = $v00
    $v0F[$v04] = $v01
    $v00 = random 400
    $v03 += 400
    $v03 += $v00
    if $v03 > 0 goto L_069F
    $v03 -= 32767

L_069F:
    $v0D[$v04] = $v03
    $v00 = random 10
    $v00 += 30
    $v00 += $v02
    $v01 = $v0B[$v04]
    $v01 -= $v00
    $v0B[$v04] = $v01

L_06CF:
    return

fireworks_flash:
    ; a burst lights up the watchers: the dimming of the DIM sprites ($v9E, 255 = dark) falls to 0
    ; and comes back, at random moments
    if $v9B == 0 goto L_06E3
    $v9B = random 50
    return

L_06E3:
    if $v9C != 0 goto L_0705
    $v9D = random 20
    $v9D += 20
    $v9E = 255
    $v9C = 1

L_0705:
    if $v9C >= 2 goto L_072B
    $v9E -= $v9D
    if $v9E > 0 goto L_074D
    $v9E = 0
    $v9C = 2

L_072B:
    $v9E += $v9D
    if $v9E < 255 goto L_074D
    $v9E = 255
    $v9C = 0
    $v9B = 1

L_074D:
    return

anim_074F:
    frame 5, time=4, flip=0, next=NEXT
    frame 6, time=5, flip=0, next=NEXT
    frame 7, time=6, flip=0, next=NEXT
    frame 8, time=8, flip=0, next=END

anim_076F:
    frame 3, time=4, flip=0, next=NEXT
    frame 4, time=4, flip=0, next=anim_076F
    bytes 0x00    ; padding
