    step speed=10, x=53, y=68, anim=anim_076B, next=NEXT  ; move to 53, 68, 10 pixels a frame
    step speed=5, x=84, y=48, anim=anim_076B, next=NEXT  ; move to 84, 48, 5 pixels a frame
    step speed=9, x=205, y=23, anim=anim_076B, next=NEXT  ; move to 205, 23, 9 pixels a frame
