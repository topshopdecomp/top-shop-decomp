; CAL_09.J entry 0
;
; The calendar page of September (Board_Task steps 2100-2120, with event scenes on).
; The picture: autumn: dragonflies (images 0-1) dart about at random; a small flying saucer (image
; 2) crosses the sky.
; It fades in over 15 frames, plays for 300 frames or until anyone presses cross, and
; fades out.
;
; 2140 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CAL_09"                       ; a name for the script; costs a frame
    call clear_vars
    sprite_init 30, image=2, attr=0, x=320, y=10, pri=1
    sprite_path 30, path_0773
    $v9E = -200

L_0027:
    sprite_init $vA0, image=0, attr=MIDDLE_CENTER, x=0, y=0, pri=0
    sprite_animate $vA0, anim_074B
    $vA0 += 1
    if $vA0 != 7 goto L_0027
    $vA0 = 0

L_0051:
    call dragonfly_new
    $vA0 += 1
    if $vA0 != 7 goto L_0051
    fade_in 15

L_0069:
    $vA0 = 0

L_006F:
    call dragonfly_fly
    call dragonfly_keep_in
    $vA0 += 1
    if $vA0 != 7 goto L_006F
    $vA0 = 0

L_008D:
    $v04 = $vA0
    $v04 *= 7
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v00 /= 10
    $v01 /= 10
    sprite_pos $vA0, $v00, $v01
    $vA0 += 1
    if $vA0 != 7 goto L_008D
    $v9F += 1
    wait 1
    $vA0 = 0

L_00DD:
    $vA0 += 1
    if $vA0 != 7 goto L_00DD
    if $v9F == 300 goto L_0101
    if $any_pressed !& CROSS|0x300 goto L_0069

L_0101:
    fade_out 15
    wait_fade
    end

