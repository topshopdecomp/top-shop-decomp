dragonfly_new:
    ; dragonfly $vA0: a random place and size (records of 7 from $v0A)
    $v00 = random 3200
    $v01 = random 2400
    $v04 = $vA0
    $v04 *= 7
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    $v00 = random 200
    $v0C[$v04] = $v00
    $v00 += 50
    $v00 *= 1
    sprite_scale $vA0, $v00, $v00
    $v00 = random 32767
    $v0E[$v04] = $v00
    return

dragonfly_fly:
    ; dragonfly $vA0 hovers and now and then darts off in a random direction, its picture turned
    ; to face it
    $v04 = $vA0
    $v04 *= 7
    $v02 = $v0C[$v04]
    $v02 /= 3
    $v03 = $v0D[$v04]
    if $v03 == 0 goto L_0683
    $v03 = random 20
    $v0D[$v04] = $v03
    if $v03 != 0 goto L_05E1
    $v00 = random 100
    $v00 -= 50
    $v00 *= $v02
    $v00 /= 30
    $v01 = random 100
    $v01 -= 50
    $v01 *= $v02
    $v01 /= 30
    if $v00 < 0 goto L_05CB
    sprite_animate $vA0, anim_075B
    goto L_05D1

L_05CB:
    sprite_animate $vA0, anim_074B

L_05D1:
    $v0F[$v04] = $v00
    $v10[$v04] = $v01

L_05E1:
    $v01 = $v0B[$v04]
    $v05 = $v0E[$v04]
    $v06 = $v05
    $v06 += 16383
    $v07 = $v02
    $v07 /= 5
    $v07 += 10
    step_toward x=0, y=$v01, distance=$v07, angle=$v06, to_x=$v08, to_y=$v01
    $v08 = random 3000
    $v05 += 3000
    $v05 += $v08
    if $v05 >= 0 goto L_063F
    $v05 -= 32767

L_063F:
    step_toward x=0, y=$v01, distance=$v07, angle=$v05, to_x=$v08, to_y=$v01
    $v08 = random 20
    $v08 -= 10
    $v01 += $v08
    $v0B[$v04] = $v01
    $v0E[$v04] = $v05
    $v01 = random 10
    $v02 /= 2
    $v01 += $v02
    return

L_0683:
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    $v02 = $v0F[$v04]
    $v03 = $v10[$v04]
    $v00 += $v02
    $v01 += $v03
    $v05 = random 10
    if $v05 == 0 goto L_06C3
    goto L_06CB

L_06C3:
    $v0D[$v04] = 1

L_06CB:
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    return

dragonfly_keep_in:
    ; keep dragonfly $vA0 within -50..370, -50..290 pixels
    $v04 = $vA0
    $v04 *= 7
    $v00 = $v0A[$v04]
    $v01 = $v0B[$v04]
    if $v00 >= -500 goto L_0709
    $v00 = -500

L_0709:
    if $v00 <= 3700 goto L_0719
    $v00 = 3700

L_0719:
    if $v01 >= -500 goto L_0729
    $v01 = -500

L_0729:
    if $v01 <= 2900 goto L_0739
    $v01 = 2900

L_0739:
    $v0A[$v04] = $v00
    $v0B[$v04] = $v01
    return

anim_074B:
    frame 0, time=1, flip=0, next=NEXT
    frame 1, time=1, flip=0, next=anim_074B

anim_075B:
    frame 0, time=1, flip=FLIP_X, next=NEXT
    frame 1, time=1, flip=FLIP_X, next=anim_075B

anim_076B:
    frame 2, time=1, flip=0, next=END

path_0773:
