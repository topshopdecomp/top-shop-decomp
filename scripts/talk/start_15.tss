text_0638:
    string "お金が欲しいもぉぉぉ！"                  ; en: I want money, mooo!

text_064F:
    string "ここから早く逃げ出すも"                  ; en: I'll get away from here fast, mo

text_0666:
    string "ねえ、%NMYのお店は？"                 ; en: Hey, where are <player>'s stores?

text_067B:
    string "逃げ出すなら今のうちだも・・・"              ; en: If I'm running away, it's now or never, mo...

text_069A:
    string "う～ん、何を仕入れるか・・・も？"             ; en: Hmm, what should I restock... mo?

text_06BB:
    string "金魚のエサを仕入れるも♪"                 ; en: I'll stock goldfish food, mo ♪

text_06D4:
    string "仕入れっておもしろいも"                  ; en: Restocking is fun, mo

text_06EB:
    string "あっちには行ったことがあるも？"              ; en: Have I been over there, mo?

text_070A:
    string "あっちに向かってくだも"                  ; en: I'll head over there, mo

text_0721:
    string "どっちか棒倒しで決めるも"                 ; en: I'll decide by the stick-falling game, mo

text_073A:
    string "エレベーターに行くも・・・"                ; en: I'll go to the elevator, mo...

text_0755:
    string "えっと・・・エレベーター乗るも★"             ; en: Um... I'll ride the elevator, mo ★

text_0776:
    string "今日は何をするかも？"                   ; en: What shall I do today, mo?

text_078B:
    string "ぷくぷく"                         ; en: Puku puku (bubbles)

text_0794:
    string "も？ももも？"                       ; en: Mo? Momomo?

text_07A1:
    string "ほどいちゃ、いやだも！"                  ; en: Don't untie me, mo!
