text_01E6:
    string "なんかもうダメそうだね～"                 ; en: Looks like it's hopeless now~

text_01FF:
    string "今回は調子がわるかったのさ～"               ; en: I was just off my game this time~

text_021C:
    string "ボードがぼろぼろになる～≦"                ; en: My board's getting wrecked~ ≦

text_0237:
    string "おっ！これなら見劣りしないね～"              ; en: Oh! This doesn't look shabby at all~

text_0256:
    string "ホント僕のお店も大きくなったね～"             ; en: My store really got big~

text_0277:
    string "これで大きくリードってとこかな～"             ; en: I guess this is a big lead~

text_0298:
    string "合体したよ～"                       ; en: They merged~

text_02A5:
    string "これなら普通の大きさかな～"                ; en: I guess this is a normal size~

text_02C0:
    string "もっと大きい方がいいかな～"                ; en: Would bigger be better~

text_02DB:
    string "暇もてあましだね～"                    ; en: I have time on my hands~

text_02EE:
    string "ホント今日は楽だったね～"                 ; en: Today was really easy~

text_0307:
    string "やることないけど、どーしよーか？"             ; en: Nothing to do, so what now?

text_0328:
    string "おっ！買いだね～"                     ; en: Oh! A buy~

text_0339:
    string "こんなんで儲けでてるのか～"                ; en: Do they make a profit like this~

text_0354:
    string "買わないと損でしょ、やっぱ"                ; en: It'd be a loss not to buy, right

text_036F:
    string "今日はここで休んじゃお～"                 ; en: I'll rest here today~

text_0388:
    string "やることあったっけ？"                   ; en: Did I have anything to do?

text_039D:
    string "な～んか暇なんだよね～"                  ; en: I'm kind of bored~

text_03B4:
    string "使わない方が近道だね～"                  ; en: Not using it is a shortcut~

text_03CB:
    string "ま、これも世の常かな～"                  ; en: Well, that's how the world goes~

text_03E2:
    string "文句言ってもしょうがないね～"               ; en: No use complaining~

text_03FF:
    string "給料もらったよ～"                     ; en: I got my pay~

text_0410:
    string "今日は遊びまくるよ～"                   ; en: I'll play all day today~

text_0425:
    string "お金ってもらうとうれし～ね～"               ; en: Getting money makes you happy~

text_0442:
    string "たまにはこういうのもいいかな？"              ; en: This is nice once in a while?

text_0461:
    string "エレベーターって%Kあんまり好きじゃないよ～"       ; en: I'm not / that fond of elevators~

text_048C:
    string "さっ！次はどこ行くんだ～"                 ; en: Right! Where to next~

text_04A5:
    string "ちょっとやばいね～このお店"                ; en: This store's a little risky~

text_04C0:
    string "避けて通りたかったね～"                  ; en: I wanted to avoid it~

text_04D7:
    string "まずいところに来ちゃったよね～"              ; en: I came somewhere bad~

text_04F6:
    string "やりぃ～まる儲け～"                    ; en: Yes~ pure profit~

text_0509:
    string "ホント？ホントに♪"                    ; en: Really? Really? ♪

text_051C:
    string "気ぃ使わせて悪いね～"                   ; en: Sorry to make you go out of your way~

text_0531:
    string "クールだねこりゃ"                     ; en: Now that's cool

text_0542:
    string "本気になりきれないぞ？！"                 ; en: I can't get serious?!

text_055B:
    string "勝てねぇ・・・"                      ; en: Can't win...

text_056A:
    string "僕のお店になったよここは"                 ; en: This place is my store now

text_0583:
    string "ヘイ！悪かったね"                     ; en: Hey! Sorry about that

text_0594:
    string "ホントあきらめてくれよ♪"                 ; en: Just give up already ♪

text_05AD:
    string "お金がないね～"                      ; en: No money~

text_05BC:
    string "少し節約しなくちゃね～"                  ; en: I have to save a little~

text_05D3:
    string "なんでかね～%Kお金使っちゃうのは？"           ; en: Why is it~ / that I end up spending money?

text_05F6:
    string "半分かーまだまだだね～"                  ; en: Half, huh~ still a long way~

text_060D:
    string "ホントここからが勝負かな～"                ; en: This is where it really starts~

text_0628:
    string "半分なんて大した事ないでしょ"               ; en: Half is no big deal

text_0645:
    string "ホント最近ついてないね～"                 ; en: I've had no luck lately~

text_065E:
    string "まぁ、必要ないけどね・・・"                ; en: Well, I don't need it anyway...

text_0679:
    string "お店がお金に変わったね～"                 ; en: The store turned into money~

text_0692:
    string "ホントお金がないんだよね～"                ; en: I really have no money~

text_06AD:
    string "カードも使えないなんてダメだね"              ; en: Can't even use a card, no good

text_06CC:
    string "お店、買えなかったね～"                  ; en: Couldn't buy the store~

text_06E3:
    string "新しいボードも欲しいし%K今日はガマンだね～"       ; en: I want a new board too, / so I'll hold back today~

text_070E:
    string "ホント余裕でもみせよ～か？"                ; en: Shall I show I can afford it~?

text_0729:
    string "ちょっとクールじゃないね～"                ; en: That's not very cool~

text_0744:
    string "スノボしたいよん"                     ; en: I want to go snowboarding

text_0755:
    string "ひざかゆ！！"                       ; en: Itchy knees!!

text_0762:
    string "%NMYだ"                        ; en: It's <player>
    bytes 0x00, 0x00, 0x00    ; padding
