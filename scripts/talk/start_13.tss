text_01F8:
    string "白銀の世界にしてやるゆきー"                ; en: I'll make it a silver world, yuki

text_0213:
    string "北の国に行くんだゆきー★"                 ; en: I'm going to the northern country, yuki ★

text_022C:
    string "転がって大きくなるゆきー♪"                ; en: I roll and get bigger, yuki ♪

text_0247:
    string "北の国は目の前だゆきー♭"                 ; en: The northern country is right ahead, yuki ♭

text_0260:
    string "大寒波襲来だゆきー♪"                   ; en: A big cold wave is coming, yuki ♪

text_0275:
    string "世界が真っ白になってくゆきー★"              ; en: The world is turning pure white, yuki ★

text_0294:
    string "これがドライアイス効果だゆきー！"             ; en: This is the dry-ice effect, yuki!

text_02B5:
    string "ここんとこ寒かったから調子が%K最高だゆきー★"      ; en: It's been cold lately so I'm / in top shape, yuki ★

text_02E2:
    string "しばらく１位にいてあげるゆき★"              ; en: I'll stay in 1st place for a while, yuki ★

text_0301:
    string "なんか溶けちゃいそうゆき～≦"               ; en: I feel like I'm melting, yuki~ ≦

text_031E:
    string "冷凍庫が故障だゆきー∵"                  ; en: The freezer is broken, yuki ∵

text_0335:
    string "ありゃ？%K目の位置がずれちゃったゆき≦"         ; en: Huh? / My eyes slipped out of place, yuki ≦

text_035C:
    string "お店に行ったら%K一瞬で溶けちゃうゆきー≦"        ; en: If I go to that store / I'll melt in an instant, yuki ≦

text_0385:
    string "雪の降ってないお店があるゆき≦"              ; en: There's a store where no snow falls, yuki ≦

text_03A4:
    string "危険な雰囲気・・・・ゆき～≦≦"              ; en: A dangerous atmosphere.... yuki~ ≦≦

text_03C3:
    string "暑そうな所が集中してるゆきー≦"              ; en: Hot-looking places are bunched together, yuki ≦

text_03E2:
    string "おっきなお店は反則だゆき～"                ; en: Big stores are against the rules, yuki~

text_03FD:
    string "このままじゃほんとに溶けちゃうゆき"            ; en: At this rate I'll really melt, yuki

text_0420:
    string "お休み中のお店には%K雪を降らしちゃうゆき♪"       ; en: I'll make it snow on the store / that's taking a break, yuki ♪

text_044B:
    string "お休み中ゆきー♪"                     ; en: Taking a break, yuki ♪

text_045C:
    string "チャンスが来たゆき♭"                   ; en: My chance has come, yuki ♭

text_0471:
    string "品物がなくなってるゆきー≦"                ; en: The goods are gone, yuki ≦

text_048C:
    string "補充しなくちゃ溶かされちゃうゆき≦"            ; en: If they don't restock they'll get melted, yuki ≦

text_04AF:
    string "仕入れをしとくの忘れてたゆき≦"              ; en: I forgot to restock, yuki ≦

text_04CE:
    string "お給料で%Kドライアイスを買い込むゆきー♭"        ; en: With my pay / I'll stock up on dry ice, yuki ♭

text_04F7:
    string "これで一息つけるゆきー★"                 ; en: Now I can catch my breath, yuki ★

text_0510:
    string "ねこはこたつで丸くなってるゆき★"             ; en: The cat curls up under the kotatsu, yuki ★

text_0531:
    string "雪合戦ＧＯ！だゆき★"                   ; en: Snowball fight, GO! yuki ★

text_0546:
    string "スキーがやりたいゆき♪"                  ; en: I want to go skiing, yuki ♪

text_055D:
    string "北極圏に住みたいゆき★"                  ; en: I want to live in the Arctic, yuki ★

text_0574:
    string "なんか暑くなってきたゆき≦"                ; en: It's getting kind of hot, yuki ≦

text_058F:
    string "ぽたぽた体が溶けてるゆき～≦"               ; en: My body's melting drip by drip, yuki~ ≦

text_05AC:
    string "雪国に帰りたいゆき≦≦"                  ; en: I want to go back to snow country, yuki ≦≦

text_05C3:
    string "耐えられそうゆき？"                    ; en: Can I stand it, yuki?

text_05D6:
    string "買い物して品切れにしてやるゆき！"             ; en: I'll shop till it's sold out, yuki!

text_05F7:
    string "大きな店なんてこわくないゆき"               ; en: Big stores don't scare me, yuki

text_0614:
    string "お店買ってクーラー全開だゆき♪"              ; en: I'll buy a store and run the air conditioner full blast, yuki ♪

text_0633:
    string "フリーお店は早い者勝ちだゆき★"              ; en: Free stores go to whoever's first, yuki ★

text_0652:
    string "雪まみれになっちゃうゆき★"                ; en: I'll get covered in snow, yuki ★

text_066D:
    string "あんなの買ったら%K水になっちゃうゆき～∵"        ; en: If I buy that / I'll turn into water, yuki~ ∵

text_0696:
    string "高い品物なんか%K知ったことじゃないゆき！"        ; en: Expensive goods / are none of my business, yuki!

text_06BF:
    string "もしかして・・・%K%NMYって負けてるゆき？"      ; en: Could it be... / <player> is losing, yuki?

text_06E8:
    string "お金を補充したいゆき"                   ; en: I want to refill my money, yuki

text_06FD:
    string "銀行ってみんなのものゆき★"                ; en: The bank belongs to everyone, yuki ★

text_0718:
    string "給料日ってそろそろだったかゆき？"             ; en: Is payday coming up soon, yuki?

text_0739:
    string "このへん雪が全然ないゆき≦"                ; en: There's no snow at all around here, yuki ≦

text_0754:
    string "この辺みょーに暑いゆき～∥｜∵"              ; en: It's strangely hot around here, yuki~ ∥｜∵

text_0773:
    string "雪がつもってない・・・・ゆき≦"              ; en: No snow piled up.... yuki ≦

text_0792:
    string "お店の基本は仕入れだゆき♭"                ; en: The basics of a store is restocking, yuki ♭

text_07AD:
    string "お金もうけは補充からだゆき♪"               ; en: Making money starts with restocking, yuki ♪

text_07CA:
    string "高級品で迎撃準備だゆき★"                 ; en: Preparing to intercept with luxury goods, yuki ★

text_07E3:
    string "どっちに行ったら得かゆき？"                ; en: Which way is the better deal, yuki?

text_07FE:
    string "寒いのはどっちだゆき？"                  ; en: Which way is cold, yuki?

text_0815:
    string "北はどっちの方だゆき？"                  ; en: Which way is north, yuki?

text_082C:
    string "方向転換したくなってきたゆき★"              ; en: I feel like changing direction, yuki ★

text_084B:
    string "スピーディーに行きたいゆき♪"               ; en: I want to go speedily, yuki ♪

text_0868:
    string "クーラーを強くしておくれだゆき♭"             ; en: Turn up the air conditioner, yuki ♭

text_0889:
    string "ふゆがいいゆき"                      ; en: Winter is good, yuki

text_0898:
    string "おそまつさまゆき"                     ; en: Thanks for having me, yuki

text_08A9:
    string "ゆっきやコンコン・・・"                  ; en: Yukki ya konkon (snow song)...
