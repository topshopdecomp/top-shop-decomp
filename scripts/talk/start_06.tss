text_01F8:
    string "よろしく～"                        ; en: Nice to meet you~

text_0203:
    string "今日も決めるよ～"                     ; en: I'll nail it today too~

text_0214:
    string "クールに行くよ～"                     ; en: Keeping it cool~

text_0225:
    string "気分は最高いぇ～い！"                   ; en: Feeling great, yeah!

text_023A:
    string "この勝負もらったよ～"                   ; en: This match is mine~

text_024F:
    string "最後までクールに行くよ～"                 ; en: Keeping it cool to the end~

text_0268:
    string "僕ががんばればこんなもんかな～"              ; en: This is what happens when I try~

text_0287:
    string "ジャンプアップて楽しいね～"                ; en: Jumping up is fun~

text_02A2:
    string "一発逆転～"                        ; en: A comeback in one shot~

text_02AD:
    string "このゲーム、まじでつまんな～い"              ; en: This game is seriously boring~

text_02CC:
    string "なんでだよ～どうしてだよ～"                ; en: Why~ how come~

text_02E7:
    string "僕、何か悪いことした？"                  ; en: Did I do something bad?

text_02FE:
    string "あんなところに・・・%Kやばいよ～"            ; en: Over there... / that's bad~

text_031F:
    string "パスってなしなの～"                    ; en: No passing?

text_0332:
    string "いやな感じが～"                      ; en: I've got a bad feeling~

text_0341:
    string "この先に進むのやだよ～"                  ; en: I don't want to go on~

text_0358:
    string "ホント勘弁して～"                     ; en: Give me a break, really~

text_0369:
    string "どうか大きいお店には%K止まんないよ～に"         ; en: Please don't let me stop / at a big store~

text_0390:
    string "僕の狙いは・・・"                     ; en: What I'm aiming for is...

text_03A1:
    string "休業中のお店当然狙うよ～"                 ; en: Of course I'm aiming for the closed store~

text_03BA:
    string "休業中のお店は%K知らないよ～"              ; en: The closed store / isn't my problem~

text_03D7:
    string "僕のお店に商品を入れなきゃ～"               ; en: I have to put goods in my store~

text_03F4:
    string "僕のお店が売り切れ中だっ"                 ; en: My store is sold out

text_040D:
    string "なんで僕のお店に商品がないの～"              ; en: Why are there no goods in my store~

text_042C:
    string "あっ給料日だ～"                      ; en: Oh, it's payday~

text_043B:
    string "給料で何買おっかな～"                   ; en: What should I buy with my pay~

text_0450:
    string "銀行にいってお金持ちになろ～"               ; en: I'll go to the bank and get rich~

text_046D:
    string "あっ順位があがってる～"                  ; en: Oh, my rank's going up~

text_0484:
    string "ジャンプアップかな～"                   ; en: A jump up, maybe~

text_0499:
    string "悪いね順位が上がったよ～"                 ; en: Sorry, my rank went up~

text_04B2:
    string "なんか順位が下がってる～"                 ; en: My rank's going down somehow~

text_04CB:
    string "気分が悪いよ～"                      ; en: I feel bad~

text_04DA:
    string "やる気がなくなる～"                    ; en: I'm losing my drive~

text_04ED:
    string "高いものは買いたくないよ～"                ; en: I don't want to buy expensive things~

text_0508:
    string "買い物したくないよ～"                   ; en: I don't want to shop~

text_051D:
    string "僕お金使いたくない～"                   ; en: I don't want to spend money~

text_0532:
    string "ホント新しいお店がほしいネ～"               ; en: I really want a new store~

text_054F:
    string "新しいお店の店長に%Kなっちゃおうかな～"         ; en: Maybe I'll become manager / of a new store~

text_0576:
    string "僕はお店の店長さん"                    ; en: I'm a store manager

text_0589:
    string "高い買い物は遠慮したいよ～"                ; en: I'd rather pass on expensive shopping~

text_05A4:
    string "高い品物は専門外だよ～"                  ; en: Expensive goods aren't my specialty~

text_05BB:
    string "いい品物もこれじゃ買えないね～"              ; en: Can't buy good goods like this~

text_05DA:
    string "銀行でお金おろしてきたいよ～"               ; en: I want to withdraw money at the bank~

text_05F7:
    string "銀行までつけるかな～"                   ; en: Can I make it to the bank~

text_060C:
    string "運に任せるしかないのか～"                 ; en: Do I just have to trust to luck~

text_0625:
    string "僕のお店が見当たらないよ～"                ; en: I can't find my stores~

text_0640:
    string "ライバル店ばっかりだよ～"                 ; en: Nothing but rival stores~

text_0659:
    string "なんかピンチだよ～"                    ; en: Kind of a pinch~

text_066C:
    string "補充しに行こうかな～"                   ; en: Maybe I'll go restock~

text_0681:
    string "ホント補充も大切だよな～"                 ; en: Restocking really is important~

text_069A:
    string "お店に寄ってけるかな～"                  ; en: Can I stop by my store~

text_06B1:
    string "こっちがいいかな～"                    ; en: Is this way better~

text_06C4:
    string "どっちもよさそうだよ～"                  ; en: Both look good~

text_06DB:
    string "どっちでもいいんじゃないか～"               ; en: Either one's fine, isn't it~

text_06F8:
    string "エレベーターまで行けるのか～"               ; en: Can I get to the elevator~

text_0715:
    string "どこに行こうか・・・・%Kホント迷っちゃうね∵"      ; en: Where should I go.... / I really can't decide ∵

text_0742:
    string "楽するとあとがきついね～"                 ; en: Take it easy now and it's tough later~

text_075B:
    string "スノボしたいよん"                     ; en: I want to go snowboarding

text_076C:
    string "俺ってサーファー"                     ; en: I'm a surfer

text_077D:
    string "%NMYだ"                        ; en: It's <player>
