text_01E6:
    string "これで勝ったと思うなにょーー！"              ; en: Don't think you've won with this, nyo!

text_0205:
    string "ボクちんはまだガンバれるにょー"              ; en: I can still keep trying, nyo

text_0224:
    string "我が王国は永遠に不滅にょーーー！！"            ; en: My kingdom is forever immortal, nyo!!

text_0247:
    string "見たかにょ！%Kこれぞ超魔導合体にょーー！！"       ; en: Did you see, nyo! / This is the Super Sorcery Merge, nyo!!

text_0272:
    string "これぞマジカルパワーの威力だにょー"            ; en: This is the might of magical power, nyo

text_0295:
    string "絶対無敵店の完成にょー"                  ; en: The absolutely invincible store is complete, nyo

text_02AC:
    string "これぞ魔導合体にょ！"                   ; en: This is the Sorcery Merge, nyo!

text_02C1:
    string "マジカルパワーで合体だにょ"                ; en: Merging with magical power, nyo

text_02DC:
    string "作戦は順調なのだにょ"                   ; en: The plan is going smoothly, nyo

text_02F1:
    string "平和が１番だにょ"                     ; en: Peace is best, nyo

text_0302:
    string "平和が大切だにょ"                     ; en: Peace is important, nyo

text_0313:
    string "ここは休憩所なのかにょ？"                 ; en: Is this a rest area, nyo?

text_032C:
    string "お得だったのかにょ？"                   ; en: Was it a good deal, nyo?

text_0341:
    string "セールっていいにょ♪"                   ; en: Sales are nice, nyo ♪

text_0356:
    string "作戦成功だにょ"                      ; en: The plan worked, nyo

text_0365:
    string "望郷の念にかられるにょ"                  ; en: I'm overcome by homesickness, nyo

text_037C:
    string "作戦を立て直すにょ"                    ; en: I'll rebuild the plan, nyo

text_038F:
    string "我が祖国が心配だにょ"                   ; en: I'm worried about my homeland, nyo

text_03A4:
    string "使ってもよかったにょ？"                  ; en: Should I have used it, nyo?

text_03BB:
    string "エレベーターは呪われているにょ！"             ; en: The elevator is cursed, nyo!

text_03DC:
    string "これも戦略のうちだにょ"                  ; en: This is part of the strategy too, nyo

text_03F3:
    string "眠いにょ"                         ; en: Sleepy, nyo

text_03FC:
    string "作戦を練り直すにょ"                    ; en: I'll rework the plan, nyo

text_040F:
    string "一休みするにょ"                      ; en: I'll take a short rest, nyo

text_041E:
    string "ここは別世界なのかにょ？"                 ; en: Is this another world, nyo?

text_0437:
    string "これが科学というものにょ？"                ; en: Is this what they call science, nyo?

text_0452:
    string "魔法で飛んだほうが速いにょ"                ; en: Flying by magic is faster, nyo

text_046D:
    string "ファイヤーミサイルを%K唱えてもいいかにょ？"       ; en: May I cast / Fire Missile, nyo?

text_0498:
    string "ライトニングボルトを%K撃ってもいいかにょ？"       ; en: May I fire / Lightning Bolt, nyo?

text_04C3:
    string "作戦失敗だにょ"                      ; en: The plan failed, nyo

text_04D2:
    string "ノロイの効果が効いてきたようだにょ"            ; en: Looks like the curse is taking effect, nyo

text_04F5:
    string "マホウの効果がでてきたようだにょ"             ; en: Looks like the magic is taking effect, nyo

text_0516:
    string "パワーさくれつにょ"                    ; en: Power explosion, nyo

text_0529:
    string "にょ？"                          ; en: Nyo?

text_0530:
    string "お金は大丈夫にょ"                     ; en: The money's fine, nyo

text_0541:
    string "力の制御が効かないにょ"                  ; en: I can't control my power, nyo

text_0558:
    string "我が王国の国力がアップしたにょ"              ; en: My kingdom's national strength went up, nyo

text_0577:
    string "迎撃準備完了だにょ"                    ; en: Ready to intercept, nyo

text_058A:
    string "ジャマしてゴメンにょ"                   ; en: Sorry for getting in the way, nyo

text_059F:
    string "これは魔導公国の策略だにょー"               ; en: This is a scheme of the Sorcery Principality, nyo

text_05BC:
    string "魔法で何とかならないにょ？"                ; en: Can't magic do something, nyo?

text_05D7:
    string "なんでこんなに不幸なにょ"                 ; en: Why am I so unlucky, nyo

text_05F0:
    string "魔導帝国設立に１歩前進したにょ"              ; en: One step closer to founding a sorcery empire, nyo

text_060F:
    string "我が野望に１歩前進したにょ"                ; en: One step closer to my ambition, nyo

text_062A:
    string "マジカルパワーがアップしたにょ！"             ; en: My magical power went up, nyo!

text_064B:
    string "我が王国の財政は苦しいにょ・・・"             ; en: My kingdom's finances are tight, nyo...

text_066C:
    string "すぐに取り返してやるにょ！"                ; en: I'll get it back right away, nyo!

text_0687:
    string "このテナントは用済みだにょ"                ; en: I'm done with this tenant, nyo

text_06A2:
    string "我が王国の財政は厳しいにょ≦"               ; en: My kingdom's finances are hard, nyo ≦

text_06BF:
    string "お金貸して欲しいにょ"                   ; en: Lend me money, nyo

text_06D4:
    string "しまったにょ！お金が無いにょ"               ; en: Oops, nyo! No money, nyo

text_06F1:
    string "今は我慢するにょ"                     ; en: I'll hold back for now, nyo

text_0702:
    string "作戦だにょ"                        ; en: It's a strategy, nyo

text_070D:
    string "買うのやめたにょ"                     ; en: I decided not to buy, nyo

text_071E:
    string "ふふ～んにょ"                       ; en: Hmph~ nyo

text_072B:
    string "だーーにょ"                        ; en: Da-a, nyo

text_0736:
    string "ガンバるにょ"                       ; en: I'll do my best, nyo
    bytes 0x00    ; padding
