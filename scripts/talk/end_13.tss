text_01E6:
    string "溶けてなくなっちゃうゆき～∥｜≦"             ; en: I'm melting away, yuki~∥｜ ≦

text_0207:
    string "と～け～て～く～ゆき～・・≦≦"              ; en: Me-el-ting a-way, yuki~.. ≦≦

text_0226:
    string "ダメそうゆき～≦"                     ; en: Looks hopeless, yuki~ ≦

text_0237:
    string "とってもおっきくなったゆき★"               ; en: It got really big, yuki ★

text_0254:
    string "４連雪だるまだゆき♪"                   ; en: A four-snowman chain, yuki ♪

text_0269:
    string "勝ったも同然ゆき★"                    ; en: As good as won, yuki ★

text_027C:
    string "ちょっと小手調べだゆき♭"                 ; en: Just a warm-up, yuki ♭

text_0295:
    string "もっとおっきくなって欲しいゆき"              ; en: I want it to get bigger, yuki

text_02B4:
    string "この辺はドライアイスで%K冷やしとくゆき★"        ; en: I'll cool this area / with dry ice, yuki ★

text_02DD:
    string "休業中なんて寒そうゆきね♭"                ; en: Closed for now, how cold, yuki ♭

text_02F8:
    string "油断大敵ゆきね★"                     ; en: Never let your guard down, yuki ★

text_0309:
    string "雪をつもらせてあげるゆき♪"                ; en: I'll let the snow pile up, yuki ♪

text_0324:
    string "買い物するなら今しかないゆきね"              ; en: If you're shopping, now's the time, yuki

text_0343:
    string "これで雪さえ降れば満足ゆき♪"               ; en: Now if only it would snow I'd be satisfied, yuki ♪

text_0360:
    string "ここで買わないと損しちゃうゆき★"             ; en: It'd be a loss not to buy here, yuki ★

text_0381:
    string "ここはクーラーガンガンだゆき～"              ; en: The air conditioner's on full here, yuki~

text_03A0:
    string "ドライアイスでスモーク効果だゆき♪"            ; en: A smoke effect with dry ice, yuki ♪

text_03C3:
    string "お店はゆきぃぐに～∥｜ゆき★"               ; en: The store is snow country~∥｜ yuki ★

text_03E0:
    string "暑いゆき≦"                        ; en: It's hot, yuki ≦

text_03EB:
    string "エレベーターは体が%K小さくなるゆき～≦"         ; en: In the elevator my body / gets smaller, yuki~ ≦

text_0412:
    string "外が寒そうだゆき・・・・"                 ; en: It looks cold outside, yuki....

text_042B:
    string "ドライアイスでショータイムだゆき♪"            ; en: Showtime with dry ice, yuki ♪

text_044E:
    string "今度はどっちにいこうかゆき★"               ; en: Which way shall I go now, yuki ★

text_046B:
    string "暇だゆき・・・"                      ; en: Bored, yuki...

text_047A:
    string "う～ん、%NMYって%K見かけより重いゆきか？"      ; en: Hmm, is <player> / heavier than it looks, yuki?

text_04A3:
    string "一時的に冷蔵庫になってたゆき♪"              ; en: I was a refrigerator for a while, yuki ♪

text_04C2:
    string "一緒に乗ってた人寒そうだったゆき♪"            ; en: The people riding with me looked cold, yuki ♪

text_04E5:
    string "仕返しに雪崩おこしてやるゆき！"              ; en: I'll start an avalanche to get even, yuki!

text_0504:
    string "大雪になって%K埋まっちゃえばいいゆき！"         ; en: I hope a heavy snow / buries it, yuki!

text_052B:
    string "溶けはじめちゃうゆき≦≦"                 ; en: I'm starting to melt, yuki ≦≦

text_0544:
    string "なんか得しちゃったみたいゆき♪"              ; en: Seems I got a good deal, yuki ♪

text_0563:
    string "お礼に雪降らせてあげるゆき♭"               ; en: I'll make it snow to thank you, yuki ♭

text_0580:
    string "雪祭り気分だゆき★"                    ; en: Feels like a snow festival, yuki ★

text_0593:
    string "じゃましちゃったゆき♭"                  ; en: Sorry to intrude, yuki ♭

text_05AA:
    string "クーラーほしいゆき♪"                   ; en: I want an air conditioner, yuki ♪

text_05BF:
    string "都会のゆきはおいしくないゆき∈"              ; en: City snow doesn't taste good, yuki ∈

text_05DE:
    string "雪の国からこんにちわーだゆき"               ; en: Hello from snow country, yuki

text_05FB:
    string "今日からここは冬は暖房なしだゆき★"            ; en: From today there's no heating here in winter, yuki ★

text_061E:
    string "ここにカマクラでも作っちゃうゆき♪"            ; en: I'll build a snow hut here, yuki ♪

text_0641:
    string "このごろ暑い日が続いてるゆき≦"              ; en: Hot days keep coming lately, yuki ≦

text_0660:
    string "なんかポタポタっていう音が%Kするゆき～≦"        ; en: I hear a drip, drip / sound, yuki~ ≦

text_0689:
    string "連続出費思考ゆき≦≦"                   ; en: Thinking of nothing but spending, yuki ≦≦

text_069E:
    string "ここからが本番だゆき∈"                  ; en: This is where it really starts, yuki ∈

text_06B5:
    string "雪はまだまだ積もってくゆき★"               ; en: The snow will keep piling up, yuki ★

text_06D2:
    string "半分まで大きくなったゆき♪"                ; en: I've grown halfway, yuki ♪

text_06ED:
    string "体が一回り小さくなったゆき≦≦"              ; en: My body got a size smaller, yuki ≦≦

text_070C:
    string "こんど雪でうめてやるゆき！"                ; en: Next time I'll bury you in snow, yuki!

text_0727:
    string "借金の返済だゆき≦"                    ; en: Paying off debt, yuki ≦

text_073A:
    string "この先の出費を計算に入れたゆき≦"             ; en: I counted in the expenses ahead, yuki ≦

text_075B:
    string "ここ買えないと%K大変なことになるゆき≦≦"        ; en: If I can't buy this / it'll be terrible, yuki ≦≦

text_0784:
    string "お金がなくなってるゆき≦"                 ; en: My money is disappearing, yuki ≦

text_079D:
    string "店買わない思考ゆき！"                   ; en: Thinking of not buying stores, yuki!

text_07B2:
    string "今回はお金をとっとくゆき♪"                ; en: I'll keep my money this time, yuki ♪

text_07CD:
    string "ここはゆずってあげるゆき"                 ; en: I'll let you have this one, yuki

text_07E6:
    string "うれち～"                         ; en: So happy~

text_07EF:
    string "おそまつさまゆき"                     ; en: Thanks for having me, yuki

text_0800:
    string "ゆっきやコンコン・・・"                  ; en: Yukki ya konkon (snow song)...
    bytes 0x00    ; padding
