text_01E6:
    string "I'm melting away, yuki ≦"  ; ja: 溶けてなくなっちゃうゆき～∥｜≦

text_0207:
    string "Meeelting aaway, yukiii.. ≦≦"  ; ja: と～け～て～く～ゆき～・・≦≦

text_0226:
    string "Looks hopeless, yukiii ≦"      ; ja: ダメそうゆき～≦

text_0237:
    string "It got really big, yuki ★"    ; ja: とってもおっきくなったゆき★

text_0254:
    string "A four-snowman chain, yuki ♪"  ; ja: ４連雪だるまだゆき♪

text_0269:
    string "As good as won, yuki ★"       ; ja: 勝ったも同然ゆき★

text_027C:
    string "Just a warm-up, yuki ♭"       ; ja: ちょっと小手調べだゆき♭

text_0295:
    string "I want it to get bigger, yuki"  ; ja: もっとおっきくなって欲しいゆき

text_02B4:
    string "I'll cool this area%Kwith dry ice, yuki ★"  ; ja: この辺はドライアイスで%K冷やしとくゆき★

text_02DD:
    string "Closed for now, how cold, yuki ♭"  ; ja: 休業中なんて寒そうゆきね♭

text_02F8:
    string "Never let your guard down, yuki ★"  ; ja: 油断大敵ゆきね★

text_0309:
    string "I'll let the snow pile up, yuki ♪"  ; ja: 雪をつもらせてあげるゆき♪

text_0324:
    string "If you're going to shop,%Know's the time, yuki"  ; ja: 買い物するなら今しかないゆきね

text_0343:
    string "Now if it would only snow,%KI'd be satisfied, yuki ♪"  ; ja: これで雪さえ降れば満足ゆき♪

text_0360:
    string "It'd be a loss not to buy here,%Kyuki ★"  ; ja: ここで買わないと損しちゃうゆき★

text_0381:
    string "The air conditioner's on full%Khere, yuki~"  ; ja: ここはクーラーガンガンだゆき～

text_03A0:
    string "A smoke effect with dry ice,%Kyuki ♪"  ; ja: ドライアイスでスモーク効果だゆき♪

text_03C3:
    string "This store is snow country now.%Kyuki ★"  ; ja: お店はゆきぃぐに～∥｜ゆき★

text_03E0:
    string "It's hot, yuki ≦"             ; ja: 暑いゆき≦

text_03EB:
    string "In the elevator, my body%Kgets smaller, yukiii ≦"  ; ja: エレベーターは体が%K小さくなるゆき～≦

text_0412:
    string "It looks cold outside, yuki...."  ; ja: 外が寒そうだゆき・・・・

text_042B:
    string "Showtime with dry ice, yuki ♪"  ; ja: ドライアイスでショータイムだゆき♪

text_044E:
    string "Which way shall I go now, yuki ★"  ; ja: 今度はどっちにいこうかゆき★

text_046B:
    string "Bored, yuki..."               ; ja: 暇だゆき・・・

text_047A:
    string "Hmm, is %NMY%Kheavier than it looks, yuki?"  ; ja: う～ん、%NMYって%K見かけより重いゆきか？

text_04A3:
    string "I turned it into a refrigerator,%Kyuki ♪"  ; ja: 一時的に冷蔵庫になってたゆき♪

text_04C2:
    string "The people riding with me looked%Kcold, yuki ♪"  ; ja: 一緒に乗ってた人寒そうだったゆき♪

text_04E5:
    string "I'll start an avalanche to get%Keven, yuki!"  ; ja: 仕返しに雪崩おこしてやるゆき！

text_0504:
    string "I hope a heavy snow%Kburies them, yuki!"  ; ja: 大雪になって%K埋まっちゃえばいいゆき！

text_052B:
    string "I'm starting to melt, yuki ≦≦"  ; ja: 溶けはじめちゃうゆき≦≦

text_0544:
    string "Seems I got a good deal, yuki ♪"  ; ja: なんか得しちゃったみたいゆき♪

text_0563:
    string "I'll make it snow to thank you,%Kyuki ♭"  ; ja: お礼に雪降らせてあげるゆき♭

text_0580:
    string "Feels like a snow festival,%Kyuki ★"  ; ja: 雪祭り気分だゆき★

text_0593:
    string "Sorry to intrude, yuki ♭"     ; ja: じゃましちゃったゆき♭

text_05AA:
    string "I want an air conditioner, yuki ♪"  ; ja: クーラーほしいゆき♪

text_05BF:
    string "City snow doesn't taste good,%Kyuki ∈"  ; ja: 都会のゆきはおいしくないゆき∈

text_05DE:
    string "Hello from snow country, yuki"  ; ja: 雪の国からこんにちわーだゆき

text_05FB:
    string "From today there's no heating here%Kin winter, yuki ★"  ; ja: 今日からここは冬は暖房なしだゆき★

text_061E:
    string "I'll build an igloo here,%Kyuki ♪"  ; ja: ここにカマクラでも作っちゃうゆき♪

text_0641:
    string "Hot days keep coming lately,%Kyuki ≦"  ; ja: このごろ暑い日が続いてるゆき≦

text_0660:
    string "I hear a drip, drip%Ksound, yuki~ ≦"  ; ja: なんかポタポタっていう音が%Kするゆき～≦

text_0689:
    string "Thinking of nothing but spending,%Kyuki ≦≦"  ; ja: 連続出費思考ゆき≦≦

text_069E:
    string "This is where it really starts,%Kyuki ∈"  ; ja: ここからが本番だゆき∈

text_06B5:
    string "The snow will keep piling up,%Kyuki ★"  ; ja: 雪はまだまだ積もってくゆき★

text_06D2:
    string "I've grown halfway, yuki ♪"   ; ja: 半分まで大きくなったゆき♪

text_06ED:
    string "My body got a size smaller,%Kyuki ≦≦"  ; ja: 体が一回り小さくなったゆき≦≦

text_070C:
    string "Next time I'll bury you in snow,%Kyuki!"  ; ja: こんど雪でうめてやるゆき！

text_0727:
    string "Paying off debt, yuki ≦"      ; ja: 借金の返済だゆき≦

text_073A:
    string "I counted the expenses ahead,%Kyuki ≦"  ; ja: この先の出費を計算に入れたゆき≦

text_075B:
    string "If I can't buy this%Kit'll be terrible, yuki ≦≦"  ; ja: ここ買えないと%K大変なことになるゆき≦≦

text_0784:
    string "My money is disappearing, yuki ≦"  ; ja: お金がなくなってるゆき≦

text_079D:
    string "Thinking of not buying stores,%Kyuki!"  ; ja: 店買わない思考ゆき！

text_07B2:
    string "I'll keep my money this time,%Kyuki ♪"  ; ja: 今回はお金をとっとくゆき♪

text_07CD:
    string "I'll let you have this one, yuki"  ; ja: ここはゆずってあげるゆき

text_07E6:
    string "So happyyy"                    ; ja: うれち～

text_07EF:
    string "Thanks for having me, yuki"   ; ja: おそまつさまゆき

text_0800:
    string "Yukki ya konkon (snow song)..."  ; ja: ゆっきやコンコン・・・
    bytes 0x00    ; padding
