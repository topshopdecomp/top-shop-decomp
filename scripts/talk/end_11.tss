text_01E6:
    string "煮るなも！"                        ; en: Don't boil me, mo!

text_01F1:
    string "だめだめも？"                       ; en: No good, mo?

text_01FE:
    string "息が出来ないも・・・≦"                  ; en: I can't breathe, mo... ≦

text_0215:
    string "ホント苦労したも★"                    ; en: That was really hard work, mo ★

text_0228:
    string "これで勝てるも♪"                     ; en: Now I can win, mo ♪

text_0239:
    string "ホントに大きくなったも"                  ; en: It really got big, mo

text_0250:
    string "このくらいで収入増えるのかも？"              ; en: Will my income grow with this much, mo?

text_026F:
    string "少しおっきくしたも♪"                   ; en: I made it a little bigger, mo ♪

text_0284:
    string "まだ、小手調べだも♭"                   ; en: Just a warm-up, mo ♭

text_0299:
    string "残念だも★"                        ; en: Too bad, mo ★

text_02A4:
    string "泳ぎに行っていいかも？"                  ; en: May I go for a swim, mo?

text_02BB:
    string "たまにはゆっくりしたいも"                 ; en: I want to relax once in a while, mo

text_02D4:
    string "うん？これやす～いも♭"                  ; en: Hm? This is che-eap, mo ♭

text_02EB:
    string "バーゲンとはなんだも？"                  ; en: What's a bargain sale, mo?

text_0302:
    string "今日は何故か安く買えたも♪"                ; en: For some reason I bought cheap today, mo ♪

text_031D:
    string "タライに水を入れとくも"                  ; en: I'll put water in the tub, mo

text_0334:
    string "今日くらい楽してもいいも♪"                ; en: It's okay to take it easy today, mo ♪

text_034F:
    string "%NMYのお店だも♭"                   ; en: It's <player>'s store, mo ♭

text_0360:
    string "乗りたい気分じゃないも・・・"               ; en: I'm not in the mood to ride, mo...

text_037D:
    string "乗り遅れた訳じゃないも！"                 ; en: It's not that I missed it, mo!

text_0396:
    string "苦しいもぉぉぉ・・・≦≦"                 ; en: It's hard, mooo... ≦≦

text_03AF:
    string "今度はどこに行こうかも♪"                 ; en: Where shall I go next, mo ♪

text_03C8:
    string "給料を貰ったも♪"                     ; en: I got my pay, mo ♪

text_03D9:
    string "これで反撃できるも∈"                   ; en: Now I can strike back, mo ∈

text_03EE:
    string "変な感覚だも？"                      ; en: A strange feeling, mo?

text_03FD:
    string "なんか変な目で見られてるも∵"               ; en: People are looking at me funny, mo ∵

text_041A:
    string "気に入っちゃったも♭"                   ; en: I've taken a liking to it, mo ♭

text_042F:
    string "なんか仕返しを考えるも・・・"               ; en: I'll think of some way to get even, mo...

text_044C:
    string "なんかお金使っちゃたもぉ≦"                ; en: Somehow I spent money, mo ≦

text_0467:
    string "なんかヤバメだねも∵∵"                  ; en: Looks kind of risky, mo ∵∵

text_047E:
    string "お金返してもらっちゃったも♪"               ; en: I got my money back, mo ♪

text_049B:
    string "地上のシステムは複雑だも♪"                ; en: The surface world's system is complicated, mo ♪

text_04B6:
    string "得しちゃったけど、どうするも？"              ; en: I came out ahead, but what now, mo?

text_04D5:
    string "しっぱいしちゃったも"                   ; en: I messed up, mo

text_04EA:
    string "ウオ～∥！だも"                      ; en: Wo~∥! Mo

text_04F9:
    string "状況は不利に展開してるも∵∵"               ; en: Things are turning against me, mo ∵∵

text_0516:
    string "ここの店長になっちゃったも♪"               ; en: I've become the manager here, mo ♪

text_0533:
    string "マリモが店長だも♪"                    ; en: A marimo is the manager, mo ♪

text_0546:
    string "とにかく一歩前進しなくちゃも∵"              ; en: Anyway, I have to take one step forward, mo ∵

text_0565:
    string "お金の減りがなんか早いも？"                ; en: Is my money going down fast, mo?

text_0580:
    string "このごろ出費が多すぎだも∵"                ; en: Too many expenses lately, mo ∵

text_059B:
    string "やっぱり節約って出来ないも"                ; en: I just can't save after all, mo

text_05B6:
    string "半分くらいに来たかも？"                  ; en: Maybe I'm about halfway?

text_05CD:
    string "故郷の湖が見えてきたも♭"                 ; en: I can see my home lake, mo ♭

text_05E6:
    string "ようやく半分だもぉ★"                   ; en: Halfway at last, mo ★

text_05FB:
    string "仕返しに水草送ってやるも！"                ; en: I'll send them water weeds to get even, mo!

text_0616:
    string "なんか経営が厳しいも∵"                  ; en: Business is kind of tough, mo ∵

text_062D:
    string "買い戻すからガマンするも≦≦"               ; en: I'll buy it back, so I'll hold on, mo ≦≦

text_064A:
    string "・・・高かっただけも≦"                  ; en: ...It was only expensive, mo ≦

text_0661:
    string "こんなお店はいらないも！"                 ; en: I don't need a store like this, mo!

text_067A:
    string "なんかピンチって感じだもぉ"                ; en: Feels like a pinch, mo

text_0695:
    string "買い忘れたも・・・・∵"                  ; en: I forgot to buy it, mo.... ∵

text_06AC:
    string "お店に感覚がまったくあわないも≦"             ; en: The store doesn't suit my taste at all, mo ≦

text_06CD:
    string "お金を貯めるも♪"                     ; en: I'll save money, mo ♪

text_06DE:
    string "ぷくぷくぅ～∥"                      ; en: Puku-puku~ ∥

text_06ED:
    string "も、ももも・・・"                     ; en: Mo, momomo...

text_06FE:
    string "まるめてぇちょうだいも！"                 ; en: Roll me up, please, mo!
    bytes 0x00    ; padding
