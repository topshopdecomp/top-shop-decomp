text_01F8:
    string "光合成開始なり♪"                     ; en: Photosynthesis starting, nari ♪

text_0209:
    string "水分はあまりほしくないなり♪%K腐ってしまうなり♪"    ; en: I don't want much water, nari ♪ / I'd rot, nari ♪

text_023A:
    string "%NMYなり♭%Kよろしくおねがいするなり♪"       ; en: I'm <player>, nari ♭ / Nice to meet you, nari ♪

text_0261:
    string "もう少しで砂漠の国に帰れるなり"              ; en: Soon I can go back to the desert country, nari

text_0280:
    string "お母ちゃんお父ちゃん！%Kもう少しで帰るなり♪"      ; en: Mom! Dad! / I'll be home soon, nari ♪

