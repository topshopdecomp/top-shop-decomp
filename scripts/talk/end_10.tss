text_01E6:
    string "I don't believe it"           ; ja: 俺は信じねー

text_01F3:
    string "Why!!"                        ; ja: なんでだよ！！

text_0202:
    string "Ah, forget it, forget it!%KI can't be bothered"  ; ja: あ～やめたやめた！%Kやってらんねーぜ

text_0227:
    string "You? Beating me? Dream on."     ; ja: 俺に勝とーなんてあめ～んだよ

text_0244:
    string "Heh! Mine's the best"         ; ja: へっ！俺のが一番だぜ

text_0259:
    string "As good as won now!"          ; ja: これで勝ったも同然だぜ！

text_0272:
    string "Getting a store this size%Kis a piece of cake."  ; ja: このくらい楽勝だぜ～

text_0287:
    string "This is okay, but I need more!"  ; ja: 俺はこんなもんじゃ納得しねーぜ

text_02A6:
    string "MEEERGE!!%K(oof that was embarrassing)"  ; ja: 合体！ってなんか恥じ～ぜ！

text_02C1:
    string "Do they even care?"           ; ja: この店やる気あんのかねぇ？

text_02DC:
    string "I can't be bothered."         ; ja: やってられね～な

text_02ED:
    string "You think this is good enough?"  ; ja: こんなんでいいと思ってんのか？

text_030C:
    string "Oh! It's cheap."               ; ja: おっ！安いじゃんかよ

text_0321:
    string "Keep it cheap all the time."  ; ja: いつも安くしておけよ～

text_0338:
    string "Don't slack off even on a sale!"  ; ja: 安売りでも手ぇぬくなよ！

text_0351:
    string "I've got time on my hands today!"  ; ja: 今日は暇をもてあましてるぜ！

text_036E:
    string "What'll I do next?"           ; ja: 次はどうしてやるかな？

text_0385:
    string "Stop by my store once in a while!"  ; ja: たまには俺の店にも寄れよな！

text_03A2:
    string "I don't need to ride it!"  ; ja: のんなくても平気だぜ！

text_03B9:
    string "I've got no intention of taking it%Keasy"  ; ja: まったく楽する気はねーぜ

text_03D2:
    string "It's fine. I only use it%Ksometimes!"  ; ja: たまに使うからいいんだよ！

text_03ED:
    string "Let's go wild today!"         ; ja: 今日はパァ～っとやろーぜ！

text_0408:
    string "I grabbed my pay!"            ; ja: 給料ふんだくったぜ！

text_041D:
