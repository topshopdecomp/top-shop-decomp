text_01E6:
    string "俺は信じねー"                       ; en: I don't believe it

text_01F3:
    string "なんでだよ！！"                      ; en: Why!!

text_0202:
    string "あ～やめたやめた！%Kやってらんねーぜ"          ; en: Ah, forget it, forget it! / I can't be bothered

text_0227:
    string "俺に勝とーなんてあめ～んだよ"               ; en: You beating me? Dream on

text_0244:
    string "へっ！俺のが一番だぜ"                   ; en: Heh! Mine's the best

text_0259:
    string "これで勝ったも同然だぜ！"                 ; en: As good as won now!

text_0272:
    string "このくらい楽勝だぜ～"                   ; en: This much is a piece of cake~

text_0287:
    string "俺はこんなもんじゃ納得しねーぜ"              ; en: I'm not satisfied with just this

text_02A6:
    string "合体！ってなんか恥じ～ぜ！"                ; en: Merge! is kind of embarrassing!

text_02C1:
    string "この店やる気あんのかねぇ？"                ; en: Does this store even care?

text_02DC:
    string "やってられね～な"                     ; en: I can't be bothered~

text_02ED:
    string "こんなんでいいと思ってんのか？"              ; en: You think this is good enough?

text_030C:
    string "おっ！安いじゃんかよ"                   ; en: Oh! It's cheap

text_0321:
    string "いつも安くしておけよ～"                  ; en: Keep it cheap all the time~

text_0338:
    string "安売りでも手ぇぬくなよ！"                 ; en: Don't slack off even on a sale!

text_0351:
    string "今日は暇をもてあましてるぜ！"               ; en: I've got time on my hands today!

text_036E:
    string "次はどうしてやるかな？"                  ; en: What'll I do next?

text_0385:
    string "たまには俺の店にも寄れよな！"               ; en: Stop by my store once in a while!

text_03A2:
    string "のんなくても平気だぜ！"                  ; en: I'm fine without riding it!

text_03B9:
    string "まったく楽する気はねーぜ"                 ; en: I've got no intention of taking it easy

text_03D2:
    string "たまに使うからいいんだよ！"                ; en: It's good because I only use it sometimes!

text_03ED:
    string "今日はパァ～っとやろーぜ！"                ; en: Let's go wild today!

text_0408:
    string "給料ふんだくったぜ！"                   ; en: I grabbed my pay!

text_041D:
    string "金ためねーとな"                      ; en: Gotta save money

text_042C:
    string "とろいぜ！このエレベータはよ！"              ; en: This elevator's slow!

text_044B:
    string "着いたのか・・・"                     ; en: We're here...

text_045C:
    string "貸し切りだったぜ♪"                    ; en: Had it all to myself ♪

text_046F:
    string "金使わせやがって！！"                   ; en: Making me spend money!!

text_0484:
    string "俺も負けてらんねーぜ！"                  ; en: I can't lose either!

text_049B:
    string "くっそ～∥｜！"                      ; en: Dammit~∥｜!

text_04AA:
    string "おっ！金返してくれんのか？"                ; en: Oh! You're paying me back?

text_04C5:
    string "また来るからな"                      ; en: I'll be back

text_04D4:
    string "やめられねーな、もう"                   ; en: Can't quit now

text_04E9:
    string "冷たくないねェ～∥"                    ; en: Not cold at all~ ∥

text_04FC:
    string "邪魔するな！"                       ; en: Don't get in my way!

text_0509:
    string "俺の勝手！"                        ; en: My choice!

text_0514:
    string "俺が貰ったぜ"                       ; en: I got it

text_0521:
    string "ちょっとクールじゃないけど%Kガマンするか！"       ; en: Not too cool, but / I'll put up with it!

text_054C:
    string "俺が店長だからな！"                    ; en: 'Cause I'm the manager!

text_055F:
    string "どーなってんだよ！"                    ; en: What's going on!

text_0572:
    string "助けてくれよぉ"                      ; en: Help me out

text_0581:
    string "全然たまんねーじゃないか！"                ; en: It's not building up at all!

text_059C:
    string "やっと半分かよぉ"                     ; en: Only halfway at last

text_05AD:
    string "俺の実力って奴さ！"                    ; en: That's what I can do!

text_05C0:
    string "まだまだぁぁぁ"                      ; en: Not done yet!

text_05CF:
    string "絶対仕返ししてやっからな！"                ; en: I'll definitely get even!

text_05EA:
    string "なんかマジブルーだぜ"                   ; en: I'm seriously blue

text_05FF:
    string "こんなのありなのかよ！"                  ; en: Is this even allowed!

text_0616:
    string "店が買えないなんて・・・%Kこんなのありかよ！"      ; en: I can't buy a store... / is this even allowed!

text_0643:
    string "金がないんじゃ諦めるしかねーな"              ; en: If I've got no money I'll just have to give up

text_0662:
    string "むっちゃブルーだぜ・・・"                 ; en: I'm super blue...

text_067B:
    string "買う価値もないぜ！"                    ; en: Not even worth buying!

text_068E:
    string "またにすっかな・・・"                   ; en: Maybe next time...

text_06A3:
    string "こんな店なんか買わなくたって%K余裕だぜ！"        ; en: I'm doing fine without buying / a store like this!

text_06CC:
    string "はらへったぁ～∥"                     ; en: I'm starving~ ∥

text_06DD:
    string "オレかぁ？"                        ; en: Me?

text_06E8:
    string "いや～最近ね。オイラ辛くて・・・"             ; en: Well~ lately, it's been tough for me...
    bytes 0x00, 0x00, 0x00    ; padding
