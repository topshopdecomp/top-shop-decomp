text_045C:
    string "I was the only one in there ♪"       ; ja: 貸し切りだったぜ♪

text_046F:
    string "Making me spend money!!"      ; ja: 金使わせやがって！！

text_0484:
    string "I can't lose either!"         ; ja: 俺も負けてらんねーぜ！

text_049B:
