text_01F8:
    string "だりぃ～けどいっちょやるか！"               ; en: What a drag~ but let's do this!

text_0215:
    string "チーッス！ヨロシク！！"                  ; en: 'Sup! Nice to meet ya!!

text_022C:
    string "とっとと始めようゼ！"                   ; en: Let's get started already!

text_0241:
    string "楽勝じゃん！よゆうッス"                  ; en: Piece of cake! No sweat

text_0258:
    string "まじで俺の勝ちが決定じゃん！"               ; en: Seriously, my win is settled!

text_0275:
    string "最後までバシッと決めるよ！"                ; en: I'll nail it right to the end!

text_0290:
    string "俺ってスゲーじゃん！"                   ; en: Ain't I awesome!

text_02A5:
    string "まあこんなの楽勝っス！"                  ; en: Well, this is easy!

text_02BC:
    string "スゴイ！スゴイ！スゴイ！"                 ; en: Awesome! Awesome! Awesome!

text_02D5:
    string "まじかよっ！"                       ; en: Seriously!?

text_02E2:
    string "ざけんなよっ！"                      ; en: Gimme a break!

text_02F1:
    string "ブチきれるよっ俺！"                    ; en: I'm gonna snap!

text_0304:
    string "俺をはめる気だなっ！！！"                 ; en: You're trying to set me up!!!

text_031D:
    string "まじいよっ！ブチきれるよ！！"               ; en: This sucks! I'm gonna snap!!

text_033A:
    string "このまましょぼくれんのかよっ！"              ; en: Am I just gonna mope like this!

text_0359:
    string "デッケェ店はなんだよっ！"                 ; en: What's with that huge store!

text_0372:
    string "ここは一気に通り抜けるぜっ！"               ; en: I'll blow right through here!

text_038F:
    string "この先危険すぎるぜっ！"                  ; en: It's way too dangerous ahead!

text_03A6:
    string "俺は無敵じゃ！"                      ; en: I'm invincible!

text_03B5:
    string "クローズ？%Kたるんでんじゃねえよっ！"          ; en: Closed? / Don't slack off!

text_03DA:
    string "堕天使をナメるな！！"                   ; en: Don't mess with a fallen angel!!

text_03EF:
    string "俺の店が品切れだっ！"                   ; en: My store's out of stock!

text_0404:
    string "やべっ！%K俺の店が品切れ中だっ！"            ; en: Crap! / My store's out of stock!

text_0425:
    string "俺の店人気があって商品がないぜっ！"            ; en: My store's so popular it's out of goods!

text_0448:
    string "働いた分の給料は頂くかっ！"                ; en: I'll take the pay I worked for!

text_0463:
    string "給料日にパーッといくかっ！"                ; en: Shall I blow it all on payday!

text_047E:
    string "給料日だぜっ何しよっかな？"                ; en: It's payday, what should I do?

text_0499:
    string "なんか悪り～な！%K順位があがっちまって"         ; en: Sorry about this! / My rank went up

text_04C0:
    string "俺ってクールだろっ！！！"                 ; en: Ain't I cool!!!

text_04D9:
    string "俺調子いいじゃん！！"                   ; en: I'm on a roll!!

text_04EE:
    string "なんで俺の順位がさがってんだよ！"             ; en: Why's my rank dropping!

text_050F:
    string "調子悪り～よっ！！"                    ; en: I'm off my game!!

text_0522:
    string "ざけんなよっ！！"                     ; en: Gimme a break!!

text_0533:
    string "俺に高いものを買わせるなよっ！"              ; en: Don't make me buy expensive stuff!

text_0552:
    string "俺は買い物しないからなっ！"                ; en: I'm not shopping, got it!

text_056D:
    string "さっさと進むかなっ！"                   ; en: Shall I just move on!

text_0582:
    string "新しい店でも買うかなっ！"                 ; en: Maybe I'll buy a new store!

text_059B:
    string "俺が買うからなっ！"                    ; en: I'm the one buying it!

text_05AE:
    string "ちっと店でも買ってやるかっ！"               ; en: Maybe I'll buy myself a store!

text_05CB:
    string "高い商品は買わないからなっ"                ; en: I'm not buying expensive goods

text_05E6:
    string "気に入らない所は避けてくぜっ！"              ; en: I'll steer clear of places I don't like!

text_0605:
    string "高いもの売ってたら承知しないぞ！"             ; en: I won't stand for it if they sell expensive stuff!

text_0626:
    string "銀行に行かせろよっ"                    ; en: Let me go to the bank

text_0639:
    string "金がないとなんも出来ないぜっ"               ; en: Can't do anything without money

text_0656:
    string "銀行までどのくらいあんだ？"                ; en: How far is it to the bank?

text_0671:
    string "俺の店がないってど～ゆ～こと？"              ; en: What do you mean I don't have a store?

text_0690:
    string "この借りはいつか返すぜっ！"                ; en: I'll pay you back for this someday!

text_06AB:
    string "も～やってらんねー"                    ; en: I can't take it anymore

text_06BE:
    string "だり～な、補充かよぉ"                   ; en: What a drag, restocking?

text_06D3:
    string "おい！%K品物の補充くらいやっとけよ"           ; en: Hey! / At least restock the goods

text_06F6:
    string "商品の補充って俺がやんのか？"               ; en: Am I the one restocking the goods?

text_0713:
    string "こっちに決まってんだろ！"                 ; en: It's obviously this way!

text_072C:
    string "悩む必要なんかねーな"                   ; en: Nothing to worry about

text_0741:
    string "どっちもそんな差がね～だろ？"               ; en: Neither one's that different, right?

text_075E:
    string "早く進もーぜ"                       ; en: Let's get moving

text_076B:
    string "エレベーターって使えたのか？"               ; en: Could you use the elevator?

text_0788:
    string "だり～、楽して～ぜ"                    ; en: What a drag, I wanna take it easy

text_079B:
    string "はらへったぁ～∥"                     ; en: I'm starving~ ∥

text_07AC:
    string "オレかぁ？"                        ; en: Me?

text_07B7:
    string "鉄のコブシ！！"                      ; en: Iron fist!!
    words 0    ; padding
