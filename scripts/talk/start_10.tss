text_01F8:
    string "What a drag... but let's do this!"  ; ja: だりぃ～けどいっちょやるか！

text_0215:
    string "'Sup! Nice to meet ya!!"      ; ja: チーッス！ヨロシク！！

text_022C:
    string "Let's get started already!"   ; ja: とっとと始めようゼ！

text_0241:
    string "Piece of cake! No sweat"      ; ja: 楽勝じゃん！よゆうッス

text_0258:
    string "Seriously, my win is settled!"  ; ja: まじで俺の勝ちが決定じゃん！

text_0275:
    string "I'll nail it right to the end!"  ; ja: 最後までバシッと決めるよ！

text_0290:
    string "Ain't I awesome!"             ; ja: 俺ってスゲーじゃん！

text_02A5:
    string "Well, this is easy!"          ; ja: まあこんなの楽勝っス！

text_02BC:
    string "Awesome! Awesome! Awesome!"   ; ja: スゴイ！スゴイ！スゴイ！

text_02D5:
    string "Seriously!?"                  ; ja: まじかよっ！

text_02E2:
    string "Gimme a break!"               ; ja: ざけんなよっ！

text_02F1:
    string "I'm gonna snap!"              ; ja: ブチきれるよっ俺！

text_0304:
    string "You're trying to set me up!!!"  ; ja: 俺をはめる気だなっ！！！

text_031D:
    string "This sucks! I'm gonna snap!!"  ; ja: まじいよっ！ブチきれるよ！！

text_033A:
    string "Am I just gonna mope like this!"  ; ja: このまましょぼくれんのかよっ！

text_0359:
    string "What's with that huge store!"  ; ja: デッケェ店はなんだよっ！

text_0372:
    string "I'll blow right through here!"  ; ja: ここは一気に通り抜けるぜっ！

text_038F:
    string "It's way too dangerous ahead!"  ; ja: この先危険すぎるぜっ！

text_03A6:
    string "I'm invincible!"              ; ja: 俺は無敵じゃ！

text_03B5:
    string "Closed?%KDon't slack off!"    ; ja: クローズ？%Kたるんでんじゃねえよっ！

text_03DA:
    string "Don't mess with a fallen angel!!"  ; ja: 堕天使をナメるな！！

text_03EF:
    string "My store's out of stock!"     ; ja: 俺の店が品切れだっ！

text_0404:
    string "Crap!%KMy store's out of stock!"  ; ja: やべっ！%K俺の店が品切れ中だっ！

text_0425:
    string "My store's so popular it's out of%Kgoods!"  ; ja: 俺の店人気があって商品がないぜっ！

text_0448:
    string "I'll take the pay I worked for!"  ; ja: 働いた分の給料は頂くかっ！

text_0463:
    string "Should I blow it all on payday?!"  ; ja: 給料日にパーッといくかっ！

text_047E:
    string "It's payday, what should I do?"  ; ja: 給料日だぜっ何しよっかな？

text_0499:
    string "Sorry about this!%KMy rank went up"  ; ja: なんか悪り～な！%K順位があがっちまって

text_04C0:
    string "Ain't I cool!!!"              ; ja: 俺ってクールだろっ！！！

text_04D9:
    string "I'm on a roll!!"              ; ja: 俺調子いいじゃん！！

text_04EE:
    string "Why's my rank dropping!"      ; ja: なんで俺の順位がさがってんだよ！

text_050F:
    string "I'm off my game!!"            ; ja: 調子悪り～よっ！！

text_0522:
    string "Gimme a break!!"              ; ja: ざけんなよっ！！

text_0533:
    string "Don't make me buy expensive stuff!"  ; ja: 俺に高いものを買わせるなよっ！

