text_01F8:
    string "Let's do our best, ryu ♪"     ; ja: がんばっていくりゅ♪

text_020D:
    string "I'll make it full of mysteries,%Kryu ♭"  ; ja: なぞだらけしてやりゅ♭

text_0224:
    string "%NMY is all set, ryu ★"       ; ja: %NMY準備完了りゅ★

text_0237:
    string "Still a mystery, I made it this%Kfar, ryu ♪"  ; ja: 謎なまま、ここまで来れたりゅ♪

text_0256:
    string "It's become quite full of%Kmysteries, ryu ♪"  ; ja: かなりナゾだらけになったりゅ♪

text_0275:
    string "Now you know%K%NMY's power, ryu ♪"  ; ja: %NMYの力%K思い知ったかりゅ♪

text_0292:
    string "Think better of me now, ryu ♭"  ; ja: 見直したかりゅ♭

text_02A3:
