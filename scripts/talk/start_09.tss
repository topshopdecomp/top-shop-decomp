text_02EA:
    string "It's not %NMY's fault,%Kryu ≦"  ; ja: %NMYは悪くないりゅ≦

text_02FF:
    string "I'll get back somehow, ryu!"  ; ja: 何とか復帰するりゅ！

text_0314:
    string "I'm about to be crushed, ryu ≦"  ; ja: 潰れそうだりゅ≦

text_0325:
