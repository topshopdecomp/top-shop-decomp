text_01F8:
    string "キレイな水が好きだも"                   ; en: I like clean water, mo

text_020D:
    string "やるからには全力で行くも"                 ; en: If I'm doing it, I'll go all out, mo

text_0226:
    string "%NMYはがんばるも"                   ; en: <player> will do its best, mo

text_0237:
    string "もうすぐ湖にかえれるも★"                 ; en: Soon I can go back to the lake, mo ★

text_0250:
    string "このまま勝っちゃっていいかも？"              ; en: Is it okay if I just win like this, mo?

text_026F:
    string "らっくしょ～だも♪"                    ; en: Easy-peasy, mo ♪

text_0282:
    string "水の流れが変わったも♭"                  ; en: The flow of the water changed, mo ♭

text_0299:
    string "ラッキーだも"                       ; en: Lucky, mo

text_02A6:
    string "１番って楽しいんだも★"                  ; en: Being number 1 is fun, mo ★

text_02BD:
    string "コロコロコロ・・・・≦"                  ; en: Roll roll roll.... ≦

text_02D4:
    string "転げ落ちゃったも"                     ; en: I rolled down, mo

text_02E5:
    string "信じられないことが起こったも∵"              ; en: Something unbelievable happened, mo ∵

text_0304:
    string "止まったら強制送還だも∵"                 ; en: If I stop I'll be sent back, mo ∵

text_031D:
    string "よけてけないかも？"                    ; en: Maybe I can't dodge it?

text_0330:
    string "絶体絶命！！かも・・・？"                 ; en: No way out!! Maybe...?

text_0349:
    string "おっきなお店は避けにくいも≦"               ; en: Big stores are hard to avoid, mo ≦

text_0366:
    string "%NMYは急には止まらないも！"              ; en: <player> can't stop suddenly, mo!

text_0381:
    string "止まったらどうなるも？"                  ; en: What happens if I stop, mo?

text_0398:
    string "しあわせも"                        ; en: Happiness, mo

text_03A3:
    string "うれしいも♪"                       ; en: I'm happy, mo ♪

text_03B0:
    string "お店に止まりたいも★"                   ; en: I want to stop at a store, mo ★

text_03C5:
    string "お店が取られちゃうも・・・・"               ; en: My store will be taken, mo....

text_03E2:
    string "補充の必要があるも∈"                   ; en: It needs restocking, mo ∈

text_03F7:
    string "カラッポになっちゃったも"                 ; en: It's gone empty, mo

text_0410:
    string "うれしい給料日だも"                    ; en: A happy payday, mo

text_0423:
    string "ミネラルウォーターでも買っちゃうも"            ; en: Maybe I'll buy mineral water, mo

text_0446:
    string "お金がもらえるも♪"                    ; en: I get money, mo ♪

text_0459:
    string "上り調子だも"                       ; en: On the way up, mo

text_0466:
    string "水がキレイになってきたも"                 ; en: The water's getting clean, mo

text_047F:
    string "いー天気だもぉ・・・・"                  ; en: Nice weather, mo-o....

text_0496:
    string "%NMYはころがりやすいも・・"              ; en: <player> rolls easily, mo..

text_04B1:
    string "順位が下がったも！"                    ; en: My rank went down, mo!

text_04C4:
    string "水かけて欲しいも・・・"                  ; en: I want someone to splash water on me, mo...

text_04DB:
    string "なんでもないも"                      ; en: It's nothing, mo

text_04EA:
    string "ぶくぶくぶくぶく・・・・"                 ; en: Bubble bubble bubble bubble....

text_0503:
    string "避けて行けたらボーナスものだも"              ; en: Dodging it would be a bonus, mo

text_0522:
    string "店を買って店長になるも★"                 ; en: I'll buy a store and become its manager, mo ★

text_053B:
    string "急いで向かうも！"                     ; en: Heading there in a hurry, mo!

text_054C:
    string "プール付きの店が欲しいも♪"                ; en: I want a store with a pool, mo ♪

text_0567:
    string "お店に行ったらダメかも？"                 ; en: Maybe I shouldn't go to the store?

text_0580:
    string "少し見習うかも・・・・"                  ; en: Maybe I'll learn a little from it....

text_0597:
    string "店に止まったらぴんちだも∵"                ; en: If I stop at the store it's a pinch, mo ∵

text_05B2:
    string "銀行に寄ってくだも★"                   ; en: I'll stop by the bank, mo ★

text_05C7:
    string "銀行によってけるようガンバルも♪"             ; en: I'll try to stop by the bank, mo ♪

text_05E8:
    string "お金が欲しいもぉぉぉ！"                  ; en: I want money, mooo!

text_05FF:
    string "ここから早く逃げ出すも"                  ; en: I'll get away from here fast, mo

text_0616:
    string "ねえ、%NMYのお店は？"                 ; en: Hey, where are <player>'s stores?

text_062B:
    string "逃げ出すなら今のうちだも・・・"              ; en: If I'm running away, it's now or never, mo...

text_064A:
    string "う～ん、何を仕入れるか・・・も？"             ; en: Hmm, what should I restock... mo?

text_066B:
    string "金魚のエサを仕入れるも♪"                 ; en: I'll stock goldfish food, mo ♪

text_0684:
    string "仕入れっておもしろいも"                  ; en: Restocking is fun, mo

text_069B:
    string "あっちには行ったことがあるも？"              ; en: Have I been over there, mo?

text_06BA:
    string "あっちに向かってくだも"                  ; en: I'll head over there, mo

text_06D1:
    string "どっちか棒倒しで決めるも"                 ; en: I'll decide by the stick-falling game, mo

text_06EA:
    string "エレベーターに行くも・・・"                ; en: I'll go to the elevator, mo...

text_0705:
    string "えっと・・・エレベーター乗るも★"             ; en: Um... I'll ride the elevator, mo ★

text_0726:
    string "今日は何をするかも？"                   ; en: What shall I do today, mo?

text_073B:
    string "ぷくぷく"                         ; en: Puku puku (bubbles)

text_0744:
    string "も？ももも？"                       ; en: Mo? Momomo?

text_0751:
    string "ほどいちゃ、いやだも！"                  ; en: Don't untie me, mo!
