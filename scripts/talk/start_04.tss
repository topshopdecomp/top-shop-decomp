text_01F8:
    string "神秘の力を見せてやるにょー！"               ; en: I'll show you mystic power, nyo!

text_0215:
    string "天才まどーし参上だにょー♪"                ; en: The genius sorcerer is here, nyo ♪

text_0230:
    string "また異次元に召喚されてしまったにょ"            ; en: I've been summoned to another dimension again, nyo

text_0253:
    string "勝利を我が手につかむにょ！"                ; en: I'll seize victory with my own hands, nyo!

text_026E:
    string "勝利は目前だにょ"                     ; en: Victory is right ahead, nyo

text_027F:
    string "魔法の力で勝利は目前だにょ！"               ; en: With the power of magic, victory is right ahead, nyo!

text_029C:
    string "フッカーツの魔法だにょ"                  ; en: It's the magic of re-viv-al, nyo

text_02B3:
    string "これぞ！神秘の力にょー！！"                ; en: Behold! Mystic power, nyo!!

text_02CE:
    string "究極魔法で大逆転だにょー！"                ; en: A big comeback with the ultimate spell, nyo!

text_02E9:
    string "ノロイの魔法をかけるにょー"                ; en: I'll cast a curse spell, nyo

text_0304:
    string "王国に帰りたいにょ・・・"                 ; en: I want to go back to my kingdom, nyo...

text_031D:
    string "我が魔力もここまでかにょ？"                ; en: Is this the limit of my magic, nyo?

text_0338:
    string "これは連合軍の陰謀だにょー！"               ; en: This is a plot by the Allied Forces, nyo!

text_0355:
    string "やりなおしを要求するにょー！"               ; en: I demand a do-over, nyo!

text_0372:
    string "これは維新軍の卑劣なワナだにょー！"            ; en: This is a dirty trap by the Restoration Army, nyo!

text_0395:
    string "しまったにょ！%Kテレポートし忘れたにょ"         ; en: Oops, nyo! / I forgot to teleport, nyo

text_03BC:
    string "これは皇国軍の陰謀だにょー"                ; en: This is a plot by the Imperial Army, nyo

text_03D7:
    string "そこを献上しないかにょ？"                 ; en: Won't you offer that place to me, nyo?

text_03F0:
    string "テナント補充計画を進行させるにょ♭"            ; en: The tenant restocking plan is underway, nyo ♭

text_0413:
    string "今のうちにょ！"                      ; en: Now's the time, nyo!

text_0422:
    string "ひと安心にょ"                       ; en: What a relief, nyo

text_042F:
    string "商品補充計画を実行するにょ"                ; en: Carrying out the goods restocking plan, nyo

text_044A:
    string "すぐに仕入れるにょ"                    ; en: I'll restock right away, nyo

text_045D:
    string "栗ご飯を召喚して商品を運ばせるにょ"            ; en: I'll summon chestnut rice to carry the goods, nyo

text_0480:
    string "もっとお金が欲しいにょ"                  ; en: I want more money, nyo

text_0497:
    string "ここは買い取れないかにょ？"                ; en: Can't I buy this place, nyo?

text_04B2:
    string "休憩するにょ"                       ; en: Time for a break, nyo

text_04BF:
    string "レベルアッーープにょー！"                 ; en: Level u-u-up, nyo!

text_04D8:
    string "油断は禁物だにょ"                     ; en: Carelessness is forbidden, nyo

text_04E9:
    string "マジカルポイントアップにょー！"              ; en: Magical points up, nyo!

text_0508:
    string "レベルダウンにょ・・・"                  ; en: Level down, nyo...

text_051F:
    string "許さんにょー！"                      ; en: Unforgivable, nyo!

text_052E:
    string "経験値をためて%K順位アップするんだにょ！"        ; en: I'll gain experience / and rank up, nyo!

text_0557:
    string "これは帝国軍の陰謀だにょー"                ; en: This is a plot by the Empire, nyo

text_0572:
    string "この店に災いを招いてやるにょ"               ; en: I'll bring disaster on this store, nyo

text_058F:
    string "地脈の流れが悪いにょ%K早く引っ越した方がいいにょ"    ; en: The earth's energy flows badly here, nyo / they'd better move soon, nyo

text_05C0:
    string "我が王国の領土を増やしたいんだ%Kにょー！"        ; en: I want to expand my kingdom's territory, / nyo!

text_05E9:
    string "野望に１歩、前進したにょ"                 ; en: One step closer to my ambition, nyo

text_0602:
    string "重要拠点に、ここは欲しいにょ"               ; en: I want this place as a key base, nyo

text_061F:
    string "魔法を教えるから%K商品を無料にして欲しいにょ"      ; en: I'll teach you magic, / so make the goods free, nyo

text_064C:
    string "ノロイの魔法を唱えてもいいかにょ？"            ; en: May I cast a curse spell, nyo?

text_066F:
    string "この店を壊してやるにょ！%K・・・・（いつかにょ）"    ; en: I'll destroy this store, nyo! / .... (someday, nyo)

text_06A0:
    string "所持金を増やして仕返しするにょ"              ; en: I'll grow my money and get even, nyo

text_06BF:
    string "作戦を決めるにょ%K・・・（眠くなってきたにょ）"     ; en: Let's decide on a plan, nyo / ... (I'm getting sleepy, nyo)

text_06EE:
    string "良い作戦は無いかにょ？"                  ; en: Isn't there a good plan, nyo?

text_0705:
    string "八方ふさがりだにょ・・・%Kこれは敵のワナかにょ？"    ; en: I'm boxed in on every side, nyo... / Is this an enemy trap, nyo?

text_0736:
    string "店を自分の物にする魔法は%K無いかにょ？"         ; en: Isn't there a spell to make / a store my own, nyo?

text_075D:
    string "コーソク・イドーの呪文がほしいにょ"            ; en: I want a High-Speed Travel spell, nyo

text_0780:
    string "商品補充計画を進行させるにょ"               ; en: The goods restocking plan is underway, nyo

text_079D:
    string "迎撃準備をするにょ"                    ; en: Preparing to intercept, nyo

text_07B0:
    string "ミセニ・トマールの呪文をかけるにょ%K・・・・（効くかにょ？）"  ; en: I'll cast the Stop-at-Store spell, nyo / .... (will it work, nyo?)

text_07ED:
    string "どっちに進むか水晶占いで決めるにょ%K・・・（割れてしまったにょ）"  ; en: I'll choose the way with my crystal ball, nyo / ... (it broke, nyo)

text_082E:
    string "どっちに進むか魔法で決めるにょ%K・・・（呪文を忘れたにょ）"  ; en: I'll choose the way by magic, nyo / ... (I forgot the spell, nyo)

text_0869:
    string "どっちに進んでも後悔しない様に%Kするにょ"        ; en: Whichever way I go, I won't regret it, / nyo

text_0892:
    string "この扉は異次元につながっているにょ%K・・・（ウソだにょ）"  ; en: This door leads to another dimension, nyo / ... (just kidding, nyo)

text_08CB:
    string "エレベーターが地下迷宮につながって%Kたらいいにょ"    ; en: I wish the elevator led to / an underground labyrinth, nyo

text_08FC:
    string "エレベーターに乗ると楽しそうだにょ"            ; en: Riding the elevator looks fun, nyo

text_091F:
    string "ドーピングしたいにょ"                   ; en: I want some doping, nyo

text_0934:
    string "ブルーだにょ"                       ; en: I'm blue, nyo

text_0941:
    string "ガンバるにょ"                       ; en: I'll do my best, nyo
    words 0    ; padding
