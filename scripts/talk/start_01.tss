text_0400:
    string "本日休業中みたいな～"                   ; en: Looks like it's closed today~

text_0415:
    string "やる気ない店発見！？"                   ; en: Found a store that doesn't care!?

text_042A:
    string "クローズなんてかわいそ～☆"                ; en: Closed, how sad~ ☆

text_0445:
