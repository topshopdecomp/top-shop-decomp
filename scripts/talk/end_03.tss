text_01E6:
    string "父上・・・・≦"                      ; en: Father.... ≦

text_01F5:
    string "けろっけろ？"                       ; en: Kerokero?

text_0202:
    string "これからどうなるのかみょん≦"               ; en: What will happen now, myon ≦

text_021F:
    string "ふふふふふふふふふふ%K僕にふさわしいお店だみょん♪"   ; en: Fufufufufufufufufufu / A store worthy of me, myon ♪

text_0252:
    string "究極最強！もう負けないみょん★"              ; en: Ultimate and strongest! I won't lose anymore, myon ★

text_0271:
    string "これなら勝てる！勝てるみょん♪"              ; en: With this I can win! I can win, myon ♪

text_0290:
    string "合体！最強ショップの誕生だみょん♪"            ; en: Merged! The strongest shop is born, myon ♪

text_02B3:
    string "大きくなったみょん♪"                   ; en: It got bigger, myon ♪

text_02C8:
    string "もっと大きくなれだみょん∵"                ; en: Get bigger still, myon ∵

text_02E3:
    string "休業中だみょん%K水浴びに行くことにするみょん"      ; en: It's closed, myon / I think I'll go for a dip, myon

text_0310:
    string "今日はお休みみょん♪%Kたまにはいいもんだみょん∝"    ; en: A day off today, myon ♪ / It's nice once in a while, myon ∝

text_0341:
    string "クローズだなんて・・・%Kとっても運がいいんだみょん∴"  ; en: Closed of all things... / what luck, myon ∴

text_0376:
    string "安いんだみょん%Kとにかく得々なのみょん☆"        ; en: It's cheap, myon / A real bargain anyway, myon ☆

text_039F:
    string "安くて、おいしくて、いいものなら%K言うことなしみょん★"  ; en: If it's cheap, tasty and good, / there's nothing more to say, myon ★

text_03D6:
    string "今のうちに買っとくみょん♪"                ; en: I'll buy it while I can, myon ♪

text_03F1:
    string "僕の新しい城だみょん"                   ; en: My new castle, myon

text_0406:
    string "僕の新しい城だみょん%Kみんな寄っていけだみょん♭"    ; en: My new castle, myon / Everyone stop by, myon ♭

text_0437:
    string "僕の新しい城だみょん%K大繁盛間違いなしだみょん★"    ; en: My new castle, myon / Sure to be a huge success, myon ★

text_0468:
    string "乗らなくても平気だみょん♪"                ; en: It's fine not to ride it, myon ♪

text_0483:
    string "満員だみょん！%K乗せてくれなかったみょん！"       ; en: It's full, myon! / They wouldn't let me on, myon!

text_04AE:
    string "どうしようかみょん≦"                   ; en: What shall I do, myon ≦

text_04C3:
    string "世の中、かね・カネ・金だみょん"              ; en: The world is money, money, money, myon

text_04E2:
    string "もう、お得意様だみょん♪"                 ; en: I'm a regular customer now, myon ♪

text_04FB:
    string "いくらあっても足りないみょん≦"              ; en: However much I have, it's never enough, myon ≦

text_051A:
    string "ここって、何階だみょん？"                 ; en: What floor is this, myon?

text_0533:
    string "着きましたみょん♪"                    ; en: We've arrived, myon ♪

text_0546:
    string "ワープ完了！だみょん♪"                  ; en: Warp complete! Myon ♪

text_055D:
    string "・・・壊してやるみょん！"                 ; en: ...I'll smash it, myon!

text_0576:
    string "なんか気になるみょん"                   ; en: Something's bothering me, myon

text_058B:
    string "みょみょみょーん★∴≧？！"                ; en: Myomyomyo-on ★∴≧?!

text_05A6:
    string "これってムチャクチャ得だみょん♭"             ; en: This is a crazy good deal, myon ♭

text_05C7:
    string "ちょっとだけ得したかみょん♪"               ; en: Did I gain a little, myon ♪

text_05E4:
    string "けろっけろっみょん★"                   ; en: Kerokero, myon ★

text_05F9:
    string "恵まれない庶民にプレゼント"                ; en: A present for the unfortunate common folk

text_0614:
    string "頭ガンガンだみょん・・・"                 ; en: My head is pounding, myon...

text_062D:
    string "徐々にやる気が消えるみょん"                ; en: My drive is slowly fading, myon

text_0648:
    string "これって買って%K正解だったのかみょん？"         ; en: Was buying this / the right choice, myon?

text_066F:
    string "ここは何の役に立つかみょん？"               ; en: What use is this place, myon?

text_068C:
    string "ゴメンだみょん%K勝負の世界は厳しいものだみょん"     ; en: Sorry, myon / The world of competition is tough, myon

text_06BB:
    string "少し節約しなきゃだみょん≦"                ; en: I have to save a little, myon ≦

text_06D6:
    string "お金は使うためにあるんだみょん"              ; en: Money is for spending, myon

text_06F5:
    string "お金がドンドン減っていくみょん？"             ; en: Is my money shrinking fast, myon?

text_0716:
    string "うーん%K予定より時間がかかったみょん≦"         ; en: Hmm / It took longer than planned, myon ≦

text_073D:
    string "折り返し地点だみょん♪"                  ; en: The turning point, myon ♪

text_0754:
    string "王者への道は長くけわしいみょん"              ; en: The road to the throne is long and steep, myon

text_0773:
    string "これを元手にガンバってくみょん♪"             ; en: I'll use this as capital and keep trying, myon ♪

text_0794:
    string "ここを手放すことになるとは%Kザンネンだみょん"      ; en: To think I have to let go of this place / is a shame, myon

text_07C1:
    string "僕には必要ないお店だみょん%Kせいぜい使ってくれだみょん"  ; en: It's a store I don't need, myon / Make the most of it, myon

text_07F8:
    string "ローンじゃだめかみょん？"                 ; en: Can't I pay with a loan, myon?

text_0811:
    string "ほしいけどお金がないみょん≦"               ; en: I want it but I have no money, myon ≦

text_082E:
    string "貧乏って切ないみょん≦"                  ; en: Being poor is sad, myon ≦

text_0845:
    string "こんな所はいらないみょん"                 ; en: I don't need a place like this, myon

text_085E:
    string "買った方が良かったかみょん？"               ; en: Would buying it have been better, myon?

text_087B:
    string "僕には僕の考えがあるみょん∵"               ; en: I have my own ideas, myon ∵

text_0898:
    string "ゲロゲロゲロ～∥"                     ; en: Gero gero gero~ ∥

text_08A9:
    string "ケロ？"                          ; en: Kero?

text_08B0:
    string "けろん"                          ; en: Keron
    bytes 0x00    ; padding
