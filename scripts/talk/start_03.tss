text_01F8:
    string "今回もがんばっていくみょん"                ; en: I'll do my best this time too, myon

text_0213:
    string "レディーゴーだみょん"                   ; en: Ready, go, myon

text_0228:
    string "王者の風を吹かせるみょん★"                ; en: I'll blow the wind of a king, myon ★

text_0243:
    string "王者の風よ！早く吹けみょん！"               ; en: Wind of the king! Blow soon, myon!

text_0260:
    string "勝利を我が手に！だみょん"                 ; en: Victory into my hands! Myon

text_0279:
    string "楽勝、楽勝♪%Kこのまま突っ走るみょん。"         ; en: Easy, easy ♪ / I'll run straight on like this, myon.

text_02A0:
    string "これが%NMYの実力だみょん♪"              ; en: This is what <player> can do, myon ♪

text_02BB:
    string "ここが王者の居場所だみょん"                ; en: This is where the king belongs, myon

text_02D6:
    string "雨さえ降ればこんなもんみょん♭"              ; en: If only it rains, this is nothing, myon ♭

text_02F5:
    string "け？けろぉぉぉぉぉ？！"                  ; en: Ke? Kerooooo?!

text_030C:
    string "きっと夢に決まってるみょん%K（ぎゅぅぅう）痛いみょん≦"  ; en: It must be a dream, myon / (pinch) Ouch, myon ≦

text_0343:
    string "・・ノーコメントだみょん"                 ; en: ..No comment, myon

text_035C:
    string "行きたくないみょん"                    ; en: I don't want to go, myon

text_036F:
    string "もう・・だめ・・みょん≦%Kなんとかしなくちゃだみょん"  ; en: It's... no good... myon ≦ / I have to do something, myon

text_03A4:
    string "どうしよう・・みょん"                   ; en: What do I do.. myon

text_03B9:
    string "ケロ？ヤバそうだみょん∵"                 ; en: Kero? Looks bad, myon ∵

text_03D2:
    string "ピンチ度１２０％！！！だみょん"              ; en: Danger level 120%!!! Myon

text_03F1:
    string "大きなお店は作っちゃだめみょん"              ; en: You mustn't build big stores, myon

text_0410:
    string "王子の名において%K買い取ってあげるみょん♭"       ; en: In the name of the prince, / I'll buy it out, myon ♭

text_043B:
    string "お休み中のお店はもらっちゃうみょん"            ; en: I'll take the store that's taking a break, myon

text_045E:
    string "休業中のお店は%Kもらっちゃうみょん♪"          ; en: I'll take the closed store, / myon ♪

text_0483:
    string "お店カラッポだみょん≦%K補充しなくちゃダメだみょん"   ; en: The store is empty, myon ≦ / It has to be restocked, myon

text_04B6:
    string "なんで何も無いんだみょん？"                ; en: Why is there nothing, myon?

text_04D1:
    string "ガーン！！%Kな～んに～もな～いみょん≦"         ; en: Shock!! / There's no-thing at a-all, myon ≦

text_04F8:
    string "銀行によってこーだみょん★"                ; en: Let's stop by the bank, myon ★

text_0513:
    string "ここにはお金がイッパイみょん♪"              ; en: There's lots of money here, myon ♪

text_0532:
    string "お金が欲しいみょん★"                   ; en: I want money, myon ★

text_0547:
    string "チョロイ、チョロイみょん♪"                ; en: Easy peasy, myon ♪

text_0562:
    string "まだまだこんなもんじゃないみょん"             ; en: This is nothing yet, myon

text_0583:
    string "ふぁいとだゴー！！だみょん"                ; en: Fight and go!! Myon

text_059E:
    string "水をくれだみょん≦"                    ; en: Give me water, myon ≦

text_05B1:
    string "間違いだって言ってくれみょん≦"              ; en: Tell me it's a mistake, myon ≦

text_05D0:
    string "プライド、ズタボロみょん%K（いじけてるらしい≦）"    ; en: My pride is in tatters, myon / (apparently sulking ≦)

text_0601:
    string "ふっ、まだまだだみょん"                  ; en: Hmph, not yet, myon

text_0618:
    string "まだまだ大丈夫みょん"                   ; en: Still all right, myon

text_062D:
    string "全然平気だみょーん☆"                   ; en: Totally fine, myo-on ☆

text_0642:
    string "誰か居ますかー？みょん"                  ; en: Anybody there-e? Myon

text_0659:
    string "お買い得かみょん？"                    ; en: Is it a bargain, myon?

text_066C:
    string "みょみょ！%Kフリーのお店を見っけたみょん♭"       ; en: Myomyo! / Found a free store, myon ♭

text_0697:
    string "僕には高い商品だみょん"                  ; en: These goods are too pricey for me, myon

text_06AE:
    string "おぉ？すごい商品だみょん・・・"              ; en: Ooh? Amazing goods, myon...

text_06CD:
    string "あんな高い物、僕には買えないみょん"            ; en: I can't buy something that expensive, myon

text_06F0:
    string "銀行に用事あったかみょん？"                ; en: Did I have business at the bank, myon?

text_070B:
    string "銀行はまるでオアシスに見えるみょん"            ; en: The bank looks like an oasis, myon

text_072E:
    string "銀行に行ければ勝機があるみょん"              ; en: If I can reach the bank I have a chance, myon

text_074D:
    string "僕のお店はどこだみょん？"                 ; en: Where are my stores, myon?

text_0766:
    string "ライバルばっかりだみょん・・・"              ; en: Nothing but rivals, myon...

text_0785:
    string "おーい、僕のお店はないのかみょん？"            ; en: Hey, aren't there any stores of mine, myon?

text_07A8:
    string "ふっ、これでバッチリみょん"                ; en: Hmph, this is perfect, myon

text_07C3:
    string "補充できるかみょん？"                   ; en: Can I restock, myon?

text_07D8:
    string "たまには補充しなくちゃだみょん"              ; en: I have to restock once in a while, myon

text_07F7:
    string "王者の風はどっちに吹くみょん？"              ; en: Which way will the king's wind blow, myon?

text_0816:
    string "明鏡止水の心で決めるみょん"                ; en: I'll decide with a calm, clear mind, myon

text_0831:
    string "父さん！%Kどっちにいけばイイかみょん？"         ; en: Father! / Which way should I go, myon?

text_0858:
    string "らく、らく、楽するみょん♪"                ; en: Easy, easy, taking it easy, myon ♪

text_0873:
    string "どこに行こうか迷うみょん"                 ; en: I can't decide where to go, myon

text_088C:
    string "扉に挟まれたらやだみょん≦%Kん～でんじゃらす～"     ; en: I'd hate to get caught in the doors, myon ≦ / Mmm, dangerous~

text_08BB:
    string "ゲロゲロゲロ～∥"                     ; en: Gero gero gero~ ∥

text_08CC:
    string "ケロ？"                          ; en: Kero?

text_08D3:
    string "けろん"                          ; en: Keron
    words 0    ; padding
