; TALK.J entry 24 (LZSS-packed)
;
; Edited from the disc's: the texts in English (tools/tss_english.json, fitted to the talk
; panel), the Japanese in the comments, and the text shown three times as long (90 frames,
; not 30). `tools/tss.py extract DIR` writes the script as it is on the disc.
;
; What Chat says at the end of a turn (Board_Task step 9200): on a CPU player's turn, and only
; while g_optSkipCpuTalk is 0, which the game never sets (scripts/README.md).
; $entry (TurnEnd_PickScript, the TURN_* flag):
; 0 (no comment)
; 1 a chain of 4
; 2 a chain of 2 or 3
; 3 landed on a rival store closed for now
; 4 landed on a rival store with lowered prices
; 5 landed on its own store / opened a store
; 6 did not take the elevator
; 7 landed on the bank
; 8 took the elevator
; 9 shopping cost a fifth of its money or more
; 10 shopping: got the money back
; 11 shopping
; 12 bought a rival's store
; 13 shopped this turn and the last
; 14 assets passed half the goal
; 15 sold a store
; 16 declined a vacant lot it could not afford
; 17 declined a vacant lot
; 18 an event card (the default)
;
; The code picks row $entry * 3 + (random 3) of the table: the offset of a text, the
; portrait's face and the voice's XA channel. It shows the speaker's name and that text in
; the talk panel, the portrait (face, at a random position), plays the voice, and waits for
; cross (30 frames at most). Table comments: entry.variant situation: what is said.
;
; What it says: "[<player>]"
;
; 2164 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    $v00 = random 1
    $v01 = random 3
    $v02 = random 3
    talk_speaker PLAYER
    talk_clear
    talk "【%NMY】"                         ; [<player>]
    talk "%K"
    $v04 = $entry
    $v04 *= 3
    $v04 += $v02
    $v04 *= 3
    $l0 = table_0090[$v04]
    $v04 += 1
    $l1 = table_0090[$v04]
    $v04 += 1
    $l2 = table_0090[$v04]
    talk_data $l0
    talk_show 0
    talk_open
    portrait_show unused=$v00, face=$l1, pos=$v01
    talk_wait_open
    play_xa 8, $l2                        ; voice: XA track 8 * 16 + $l2 (g_xaSets[1])
    yield
    wait_buttons_for CROSS|0x300, 90      ; wait for cross, 90 frames at most (the disc: 30)
    portrait_hide 0
    talk_close
    talk_wait_closed
    end

table_0090:
    words text_01E6, 4, 9                 ; 0.0 (no comment): Don't step on the monitor, beep
    words text_01FB, 4, 9                 ; 0.1 (no comment): Getting my show canceled is / such a shame, beep ≦
    words text_0218, 1, 7                 ; 0.2 (no comment): Click!! (turns off)
    words text_0223, 3, 6                 ; 1.0 a chain of 4: Let's run flashy commercials, / beep ♪
    words text_023E, 3, 6                 ; 1.1 a chain of 4: Now everything's ready, beep ♪
    words text_025D, 3, 6                 ; 1.2 a chain of 4: Maybe I'll put up an ad balloon / to advertise, beep ★
    words text_028C, 3, 6                 ; 2.0 a chain of 2 or 3: I'll advertise with newspaper / inserts, beep
    words text_02AB, 0, 5                 ; 2.1 a chain of 2 or 3: Maybe a little bigger would be / better, beep
    words text_02CE, 0, 5                 ; 2.2 a chain of 2 or 3: Can I double the sales, beep?
    words text_02ED, 3, 6                 ; 3.0 landed on a rival store closed for now: Beep, that's the end of today's / broadcast
    words text_030A, 3, 6                 ; 3.1 landed on a rival store closed for now: Delivery date not set.. beep ♪
    words text_0325, 0, 5                 ; 3.2 landed on a rival store closed for now: If I don't rest sometimes I'll / break, beep
    words text_0348, 3, 6                 ; 4.0 landed on a rival store with lowered prices: I'll buy it all up while I can, / beep
    words text_0363, 3, 6                 ; 4.1 landed on a rival store with lowered prices: I want some electromagnetic wave / protection gear, beep ★
    words text_0384, 0, 5                 ; 4.2 landed on a rival store with lowered prices: If I don't hurry it'll sell out, / beep ≦
    words text_03A7, 3, 6                 ; 5.0 landed on its own store / opened a store: For electromagnetic goods, come to / our store, beep
    words text_03C6, 3, 6                 ; 5.1 landed on its own store / opened a store: The mobile street TV, / <player>, is here, beep
    words text_03EF, 1, 7                 ; 5.2 landed on its own store / opened a store: <player>'s store is bursting / with electromagnetic waves, beep
    words text_0412, 3, 6                 ; 6.0 did not take the elevator: Not getting on, beep ♪
    words text_0423, 2, 8                 ; 6.1 did not take the elevator: It's a detour, beep!
    words text_0438, 3, 6                 ; 6.2 did not take the elevator: I'll watch some rakugo, beep ♪
    words text_044F, 1, 7                 ; 7.0 landed on the bank: I withdrew my meager pay, beep
    words text_046E, 3, 6                 ; 7.1 landed on the bank: I'll buy a video camera with this, / beep ★
