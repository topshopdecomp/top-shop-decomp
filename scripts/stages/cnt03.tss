; CNT03.J entry 0
;
; Story mode: the introduction of stage 4 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player 1>] / Wait!" | "[<player>] / Meow? What do you want?" | "[<player 1>] /
; Are you the cat that people say is / screwing up the neighborhood lately?" | "[<player>] /
; Screwing up!?" | "[<player>] / I'm just acquiring wealth for my own / personal gain!" |
; "[<player 1>] / That's even worse!" | ...
;
; 3616 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT03"                        ; a name for the script; costs a frame
    call start_scene_4
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=10
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=11
    sprite_init 4, image=30, attr=0, x=-100, y=-100, pri=4
    sprite_init 5, image=35, attr=0, x=-100, y=-100, pri=12
    sprite_init 6, image=38, attr=0, x=-100, y=-100, pri=13
    sprite_path 2, path_084C
    sprite_path 3, path_08A2
    sprite_path 4, path_0D86
    sprite_path 5, path_0DA2
    sprite_path 6, path_0DCE
    talk "【%N01】%KWait!"                  ; [<player 1>] / Wait!
    call show_and_open
    sprite_path 1, path_04A0
    call wait_then_clear
    talk "【%NMY】%KMeow? What do you want?"  ; [<player>] / Meow? What do you want?
    call show_text
    sprite_path 0, path_0676
    sprite_path 1, path_04D2
    call wait_then_clear
    talk "【%N01】%KAre you the cat that people say is%Kscrewing up the neighborhood lately?"  ; [<player 1>] / Are you the cat that people say is / screwing up the neighborhood lately?
    call show_text
    sprite_path 0, path_06A8
    sprite_path 1, path_04BE
    call wait_then_clear
    talk "【%NMY】%KScrewing up!?"          ; [<player>] / Screwing up!?
    call show_text
    sprite_path 0, path_0694
    sprite_path 1, path_04D2
    call wait_then_clear
    talk "【%NMY】%KI'm just acquiring wealth for my own%Kpersonal gain!"  ; [<player>] / I'm just acquiring wealth for my own / personal gain!
    call show_text
    sprite_path 0, path_06F2
    call wait_then_clear
    talk "【%N01】%KThat's even worse!"     ; [<player 1>] / That's even worse!
    call show_text
    sprite_path 0, path_0706
    sprite_path 1, path_04BE
    call wait_then_clear
    talk "【%N01】%KYou won't have your way here!"  ; [<player 1>] / You won't have your way here!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KWhat!?"                 ; [<player>] / What!?
    call show_text
    sprite_path 0, path_0694
    sprite_path 1, path_04D2
    call wait_then_clear
    talk "【%NMY】%KA cactus can't say that to me!"  ; [<player>] / A cactus can't say that to me!
    call show_text
    sprite_path 0, path_07AE
    call wait_then_clear
    talk "【%NMY】%KYou good for nothing!"  ; [<player>] / You good for nothing!
    call show_text
    call wait_then_clear
    sprite_path 0, path_06A8
    sprite_path 1, path_0636
    talk "【%N01】%KWow, that hurts!"       ; [<player 1>] / Wow, that hurts!
    call show_text
    call wait_then_clear
    talk "【%N01】%KI won't forgive you for that,%Kyou dog-breath kitty!"  ; [<player 1>] / I won't forgive you for that, / you dog-breath kitty!
    call show_text
    sprite_path 1, path_05D8
    call wait_then_clear
    talk "【%N01】%KLet's fight!"           ; [<player 1>] / Let's fight!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KDog-breath?!"           ; [<player>] / Dog-breath?!
    call show_text
    sprite_path 0, path_080C
    sprite_path 1, path_04D2
    call wait_then_clear
    talk "【%NMY】%KDog-breath?! You've said it now!"  ; [<player>] / Dog-breath?! You've said it now!
    call show_text
    sprite_path 0, path_07AE
    call wait_then_clear
    talk "【%NMY】%KBehold! I am a cat, hear me meow!"  ; [<player>] / Behold! I am a cat, hear me meow!
    call show_text
    sprite_path 0, path_07C2
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

