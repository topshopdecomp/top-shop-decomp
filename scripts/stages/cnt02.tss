; CNT02.J entry 0
;
; Story mode: the introduction of stage 3 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player>] / Meow." | "[<player>] / I'm tired from that battle with that /
; runny-nosed kid." | "[<player>] / Who's next?" | "[<player 1>] / ME!" | "[<player>] / Meow..." |
; "[<player>] / Meow... another kid..." | ...
;
; 2800 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT02"                        ; a name for the script; costs a frame
    call start_scene_3
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=4
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=7
    sprite_init 4, image=30, attr=0, x=-100, y=-100, pri=5
    sprite_init 5, image=31, attr=0, x=-100, y=-100, pri=6
    sprite_init 6, image=32, attr=0, x=-100, y=-100, pri=8
    sprite_init 7, image=34, attr=0, x=-100, y=-100, pri=1
    sprite_init 8, image=35, attr=0, x=-100, y=-100, pri=3
    sprite_init 9, image=36, attr=0, x=-100, y=-100, pri=13
    sprite_path 2, path_0834
    sprite_path 4, path_08DE
    sprite_path 5, path_08FA
    sprite_path 6, path_0932
    sprite_path 7, path_0A22
    sprite_path 9, path_0AA8
    talk "【%NMY】%KMeow."                  ; [<player>] / Meow.
    call show_and_open
    sprite_path 0, path_065E
    call wait_then_clear
    talk "【%NMY】%KI'm tired from that battle with that%Krunny-nosed kid."  ; [<player>] / I'm tired from that battle with that / runny-nosed kid.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KWho's next?"            ; [<player>] / Who's next?
    call show_text
    call wait_then_clear
    talk "【%N01】%KME!"                    ; [<player 1>] / ME!
    call show_text
    sprite_path 0, path_0690
    sprite_path 2, path_088A
    sprite_path 1, path_0488
    sprite_path 3, path_094E
    sprite_path 5, path_0916
    sprite_path 7, path_0A5C
    sprite_path 8, path_0A78
    play_se 32
    sprite_path 1, path_09E8
    call wait_then_clear
    talk "【%NMY】%KMeow..."                ; [<player>] / Meow...
    call show_text
    sprite_path 0, path_067C
    sprite_path 1, path_04BA
    call wait_then_clear
    talk "【%NMY】%KMeow... another kid..."  ; [<player>] / Meow... another kid...
    call show_text
    sprite_path 0, path_0738
    call wait_then_clear
    talk "【%N01】%KKID!?"                  ; [<player 1>] / KID!?
    call show_text
    sprite_path 0, path_074C
    sprite_path 1, path_04A6
    call wait_then_clear
    talk "【%N01】%KYou called me a kid!?"  ; [<player 1>] / You called me a kid!?
    call show_text
    call wait_then_clear
    talk "【%N01】%KYou called me a kid!? My 1,500 fans%Kwon't leave you alone for that!"  ; [<player 1>] / You called me a kid!? My 1,500 fans / won't leave you alone for that!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KFifteen hundred?"       ; [<player>] / Fifteen hundred?
    call show_text
    sprite_path 0, path_067C
    sprite_path 1, path_04A6
    call wait_then_clear
    talk "【%NMY】%KFifteen hundred? That's it?"  ; [<player>] / Fifteen hundred? That's it?
    call show_text
    call wait_then_clear
    talk "【%N01】%KYou're so rude!"        ; [<player 1>] / You're so rude!
    call show_text
    sprite_path 0, path_0690
    sprite_path 1, path_04A6
    call wait_then_clear
    talk "【%N01】%KYou're so rude! Fine,"  ; [<player 1>] / You're so rude! Fine,
    call show_text
    sprite_path 1, path_04A6
    call wait_then_clear
    talk "【%N01】%KYou're so rude! Fine, lets fight!"  ; [<player 1>] / You're so rude! Fine, lets fight!
    call show_text
    call wait_then_clear
    talk "【%N01】%KIf you lose, you'll become a fan of%Kmine,just like the others!"  ; [<player 1>] / If you lose, you'll become a fan of / mine,just like the others!
    call show_text
    sprite_path 1, path_04BA
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

