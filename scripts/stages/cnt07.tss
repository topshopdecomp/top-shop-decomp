; CNT07.J entry 0
;
; Story mode: the introduction of stage 8 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player 1>] / Step right up, step right up!" | "[<player 1>] / If you're not
; busy, step right up!" | "[<player>] / Huh?" | "[<player>] / Huh? It looks like fun over there!"
; | "[<player 1>] / You! Cat!" | "[<player 1>] / You! Cat! Take a look at our stuff!" | ...
;
; 2656 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
; NOTE 0x0889: the step's animation, 0x0000, is an instruction, not an animation frame: what got there would read it as one

L_0000:
    marker "CNT07"                        ; a name for the script; costs a frame
    call start_scene_8
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=11
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=12
    sprite_init 4, image=33, attr=0, x=-100, y=-100, pri=13
    sprite_init 5, image=34, attr=0, x=-100, y=-100, pri=3
    sprite_init 6, image=35, attr=0, x=-100, y=-100, pri=14
    sprite_path 3, path_0889
    sprite_path 4, path_0A03
    sprite_path 5, path_0A1F
    sprite_path 6, path_0A3B
    talk "【%N01】%KStep right up, step right up!"  ; [<player 1>] / Step right up, step right up!
    call show_and_open
    sprite_path 1, path_0433
    sprite_path 2, path_0781
    call wait_then_clear
    talk "【%N01】%KIf you're not busy, step right up!"  ; [<player 1>] / If you're not busy, step right up!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KHuh?"                   ; [<player>] / Huh?
    call show_text
    sprite_path 0, path_05AB
    sprite_path 1, path_0451
    call wait_then_clear
    talk "【%NMY】%KHuh? It looks like fun over there!"  ; [<player>] / Huh? It looks like fun over there!
    call show_text
    call wait_then_clear
    talk "【%N01】%KYou! Cat!"              ; [<player 1>] / You! Cat!
    call show_text
    sprite_path 0, path_05DD
    sprite_path 1, path_03F3
    call wait_then_clear
    talk "【%N01】%KYou! Cat! Take a look at our stuff!"  ; [<player 1>] / You! Cat! Take a look at our stuff!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KI don't give my money to others."  ; [<player>] / I don't give my money to others.
    call show_text
    sprite_path 0, path_05C9
    sprite_path 1, path_0407
    call wait_then_clear
    talk "【%N01】%KOuch! You're stingy!"   ; [<player 1>] / Ouch! You're stingy!
    call show_text
    sprite_path 0, path_05DD
    sprite_path 1, path_03F3
    call wait_then_clear
    talk "【%N01】%KEnjoy life a little and buy yourself%Ksome gifts."  ; [<player 1>] / Enjoy life a little and buy yourself / some gifts.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KNone of your business! Let's fight,%Kthen!"  ; [<player>] / None of your business! Let's fight, / then!
    call show_text
    sprite_path 0, path_05C9
    sprite_path 1, path_0407
    call wait_then_clear
    talk "【%N01】%KOkay."                  ; [<player 1>] / Okay.
    call show_text
    sprite_path 0, path_05DD
    sprite_path 1, path_03F3
    call wait_then_clear
    talk "【%N01】%KOkay. Let's"            ; [<player 1>] / Okay. Let's
    call show_text
    call wait_then_clear
    talk "【%N01】%KOkay. Let's fight!"     ; [<player 1>] / Okay. Let's fight!
    call show_text
    sprite_path 1, path_0407
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

