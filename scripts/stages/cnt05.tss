; CNT05.J entry 0
;
; Story mode: the introduction of stage 6 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player>] / Now..." | "[<player>] / Now... which way?" | "[<player>] / Maybe
; I'll ask him!" | "[<player 1>] / Body blow! Body blow!" | "[<player>] / Hurr!" | "[<player>] /
; Hurr! No, I mean..." | ...
;
; 2308 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT05"                        ; a name for the script; costs a frame
    call start_scene_6
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=10
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=11
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=12
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=13
    sprite_init 4, image=30, attr=0, x=-100, y=-100, pri=14
    sprite_path 4, path_0854
    talk "【%NMY】%KNow..."                 ; [<player>] / Now...
    call show_and_open
    sprite_path 0, path_05A4
    sprite_path 2, path_077A
    sprite_path 3, path_07D0
    call wait_then_clear
    talk "【%NMY】%KNow... which way?"      ; [<player>] / Now... which way?
    call show_text
    call wait_then_clear
    talk "【%NMY】%KMaybe I'll ask him!"    ; [<player>] / Maybe I'll ask him!
    call show_text
    call wait_then_clear
    talk "【%N01】%KBody blow! Body blow!"  ; [<player 1>] / Body blow! Body blow!
    call show_text
    sprite_path 0, path_05D6
    sprite_path 1, path_04E8
    call wait_then_clear
    talk "【%NMY】%KHurr!"                  ; [<player>] / Hurr!
    call show_text
    sprite_path 0, path_0620
    sprite_path 1, path_0400
    call wait_then_clear
    talk "【%NMY】%KHurr! No, I mean..."    ; [<player>] / Hurr! No, I mean...
    call show_text
    sprite_path 0, path_05C2
    call wait_then_clear
    talk "【%N01】%KYeah,"                  ; [<player 1>] / Yeah,
    call show_text
    sprite_path 0, path_05D6
    sprite_path 1, path_03EC
    call wait_then_clear
    talk "【%N01】%KYeah,I think a drink on the rocks is%Kthe best."  ; [<player 1>] / Yeah,I think a drink on the rocks is / the best.
    call show_text
    sprite_path 1, path_044A
    call wait_then_clear
    talk "【%NMY】%KHuh?"                   ; [<player>] / Huh?
    call show_text
    sprite_path 0, path_067E
    sprite_path 1, path_045E
    call wait_then_clear
    talk "【%NMY】%KHuh? Oh,"               ; [<player>] / Huh? Oh,
    call show_text
    call wait_then_clear
    talk "【%NMY】%KHuh? Oh, yeah..."       ; [<player>] / Huh? Oh, yeah...
    call show_text
    call wait_then_clear
    talk "【%N01】%KOK!"                    ; [<player 1>] / OK!
    call show_text
    sprite_path 0, path_0692
    sprite_path 1, path_03EC
    call wait_then_clear
    talk "【%N01】%KOK! Let's get going!"   ; [<player 1>] / OK! Let's get going!
    call show_text
    call wait_then_clear
    sprite_path 1, path_0506
    talk "【%N01】%KGo for the American Dream!"  ; [<player 1>] / Go for the American Dream!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KBig Brother!"           ; [<player>] / Big Brother!
    call show_text
    sprite_path 0, path_073A
    sprite_path 1, path_051A
    call wait_then_clear
    talk "【%NMY】%KBig Brother!%KI'll follow you wherever you go!"  ; [<player>] / Big Brother! / I'll follow you wherever you go!
    call show_text
    sprite_path 0, path_074E
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

