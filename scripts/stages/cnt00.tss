; CNT00.J entry 0
;
; Story mode: the introduction of stage 1 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player>] / Meow-wow-wow!" | "[<player>] / Ah, my first step to become rich!" |
; "[<player>] / Money! Money! Money!" | "[<player 1>] / Noooo!" | "[<player>] / Meow?" |
; "[<player>] / Meow? / What's this!?" | ...
;
; 3332 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT00"                        ; a name for the script; costs a frame
    call start_scene
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=4
    sprite_init 3, image=23, attr=0, x=-100, y=-100, pri=5
    sprite_init 4, image=29, attr=0, x=-100, y=-100, pri=3
    sprite_init 5, image=30, attr=0, x=-100, y=-100, pri=10
    sprite_init 6, image=31, attr=0, x=-100, y=-100, pri=11
    sprite_init 7, image=32, attr=0, x=-100, y=-100, pri=12
    sprite_init 8, image=33, attr=0, x=-100, y=-100, pri=13
    sprite_init 9, image=34, attr=0, x=-100, y=-100, pri=14
    sprite_init 10, image=36, attr=0, x=-100, y=-100, pri=15
    sprite_init 11, image=37, attr=0, x=-100, y=-100, pri=14
    sprite_init 12, image=39, attr=0, x=-100, y=-100, pri=15
    sprite_path 2, path_08CB
    sprite_path 3, path_0901
    sprite_path 5, path_09A5
    sprite_path 6, path_0A9B
    sprite_path 7, path_0B19
    sprite_path 8, path_0B97
    sprite_path 9, path_0BED
    sprite_path 11, path_0C7D
    talk "【%NMY】%KMeow-wow-wow!"          ; [<player>] / Meow-wow-wow!
    call show_and_open
    call wait_then_clear
    talk "【%NMY】%KAh, my first step to become rich!"  ; [<player>] / Ah, my first step to become rich!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KMoney! Money! Money!"   ; [<player>] / Money! Money! Money!
    call show_text
    call wait_then_clear
    talk "【%N01】%KNoooo!"                 ; [<player 1>] / Noooo!
    call show_text
    sprite_path 1, path_051F
    call wait_then_clear
    talk "【%NMY】%KMeow?"                  ; [<player>] / Meow?
    call show_text
    sprite_path 0, path_07B1
    sprite_path 1, path_0551
    call wait_then_clear
    talk "【%NMY】%KMeow?%KWhat's this!?"   ; [<player>] / Meow? / What's this!?
    call show_text
    call wait_then_clear
    talk "【%NMY】%KMeow?%KWhat's this!? What do you want?"  ; [<player>] / Meow? / What's this!? What do you want?
    call show_text
    call wait_then_clear
    talk "【%N01】%KNoooo!"                 ; [<player 1>] / Noooo!
    call show_text
    sprite_path 0, path_07E3
    sprite_path 1, path_053D
    call wait_then_clear
    talk "【%N01】%KNoooo! This place is mine!"  ; [<player 1>] / Noooo! This place is mine!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KYours?"                 ; [<player>] / Yours?
    call show_text
    sprite_path 0, path_0713
    sprite_path 1, path_0551
    call wait_then_clear
    talk "【%NMY】%KWhy, you selfish little..."  ; [<player>] / Why, you selfish little...
    call show_text
    sprite_path 0, path_082D
    call wait_then_clear
    talk "【%NMY】%KYou just a kid!"        ; [<player>] / You just a kid!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KYou just a kid! Meow!"  ; [<player>] / You just a kid! Meow!
    call show_text
    call wait_then_clear
    sprite_path 0, path_0727
    sprite_path 1, path_0657
    sprite_path 3, path_0961
    sprite_path 4, path_097F
    talk "【%N01】%KThat is so mean!"       ; [<player 1>] / That is so mean!
    call show_text
    call wait_then_clear
    talk "【%N01】%KThat is so mean!%KYou'll regret this!"  ; [<player 1>] / That is so mean! / You'll regret this!
    call show_text
    call wait_then_clear
    talk "【%N01】%KThere is more to life then money!"  ; [<player 1>] / There is more to life then money!
    call show_text
    call show_text
    call wait_then_clear
    talk "【%NMY】%KMeow, meow!"            ; [<player>] / Meow, meow!
    call show_text
    sprite_path 0, path_0713
    sprite_path 1, path_066B
    call wait_then_clear
    talk "【%NMY】%KMeow, meow! I'm not about to let%Ka little kid beat me!"  ; [<player>] / Meow, meow! I'm not about to let / a little kid beat me!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KI'm going to take you down."  ; [<player>] / I'm going to take you down.
    call show_text
    sprite_path 0, path_0727
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    ; (reached again)
    talk_clear
    play_bgm 19
    fade_in 8
    return

