; CNT04.J entry 0
;
; Story mode: the introduction of stage 5 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player>] / I'm hungry now." | "[<player>] / Hmm..." | "[<player>] / Hmm...sniff
; sniff..." | "[<player>] / What's that smell?" | "[<player 1>] / Ribbit ribbit!" | "[<player 1>]
; / Ribbit ribbit! Myon myon!" | ...
;
; 3112 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT04"                        ; a name for the script; costs a frame
    call start_scene_5
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=3
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=4
    sprite_init 4, image=29, attr=BOTTOM_RIGHT, x=-100, y=-100, pri=5
    sprite_init 5, image=30, attr=BOTTOM_RIGHT, x=-100, y=-100, pri=10
    sprite_init 6, image=30, attr=BOTTOM_RIGHT, x=-100, y=-100, pri=10
    sprite_init 7, image=30, attr=BOTTOM_RIGHT, x=-100, y=-100, pri=1
    sprite_init 8, image=30, attr=BOTTOM_RIGHT, x=-100, y=-100, pri=10
    sprite_path 5, path_09D7
    sprite_path 6, path_0A59
    sprite_path 7, path_0AEF
    sprite_path 8, path_0B7B
    talk "【%NMY】%KI'm hungry now."        ; [<player>] / I'm hungry now.
    call show_and_open
    sprite_path 0, path_070B
    sprite_path 2, path_08E1
    call wait_then_clear
    talk "【%NMY】%KHmm..."                 ; [<player>] / Hmm...
    call show_text
    call wait_then_clear
    talk "【%NMY】%KHmm...sniff sniff..."   ; [<player>] / Hmm...sniff sniff...
    call show_text
    call wait_then_clear
    talk "【%NMY】%KWhat's that smell?"     ; [<player>] / What's that smell?
    call show_text
    call wait_then_clear
    talk "【%N01】%KRibbit ribbit!"         ; [<player 1>] / Ribbit ribbit!
    call show_text
    sprite_path 0, path_073D
    sprite_path 1, path_0593
    sprite_path 3, path_0937
    sprite_path 4, path_09A7
    call wait_then_clear
    talk "【%N01】%KRibbit ribbit! Myon myon!"  ; [<player 1>] / Ribbit ribbit! Myon myon!
    call show_text
    call wait_then_clear
    talk "【%N01】%KHi, I'm the Frog Prince."  ; [<player 1>] / Hi, I'm the Frog Prince.
    call show_text
    call wait_then_clear
    talk "【%N01】%KHi, I'm the Frog Prince.%KI'm in training to be the Frog King!"  ; [<player 1>] / Hi, I'm the Frog Prince. / I'm in training to be the Frog King!
    call show_text
    call wait_then_clear
    talk "【%NMY】%K(Stomach begins to growl)"  ; [<player>] / (Stomach begins to growl)
    call show_text
    sprite_path 0, path_0729
    sprite_path 1, path_05C5
    sprite_path 3, path_0995
    call wait_then_clear
    talk "【%N01】%KMm?"                    ; [<player 1>] / Mm?
    call show_text
    sprite_path 0, path_073D
    sprite_path 1, path_060F
    call wait_then_clear
    talk "【%N01】%KMm? What's going on?"   ; [<player 1>] / Mm? What's going on?
    call show_text
    call wait_then_clear
    talk "【%N01】%KMm? What's going on?%KI feel a sudden chill!"  ; [<player 1>] / Mm? What's going on? / I feel a sudden chill!
    call show_text
    call wait_then_clear
    sprite_path 0, path_0787
    sprite_path 1, path_0623
    talk "【%NMY】%KI can't take it!"       ; [<player>] / I can't take it!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KI can't take it! I'm hungry! Food!"  ; [<player>] / I can't take it! I'm hungry! Food!
    call show_text
    call wait_then_clear
    talk "【%N01】%KAaaaargh! It's a cat monster!"  ; [<player 1>] / Aaaaargh! It's a cat monster!
    call show_text
    sprite_path 0, path_079B
    sprite_path 1, path_06CB
    call wait_then_clear
    talk "【%N01】%KBut I won't run!"       ; [<player 1>] / But I won't run!
    call show_text
    sprite_path 0, path_079B
    sprite_path 1, path_0553
    call wait_then_clear
    talk "【%N01】%KBut I won't run!I will defeat you%Kand become the King of Frogs!"  ; [<player 1>] / But I won't run!I will defeat you / and become the King of Frogs!
    call show_text
    call wait_then_clear
    talk "【%N01】%KDad!"                   ; [<player 1>] / Dad!
    call show_text
    call wait_then_clear
    talk "【%N01】%KDad! Watch me!"         ; [<player 1>] / Dad! Watch me!
    call show_text
    call wait_then_clear
    talk "【%N01】%KDad! Watch me!%KRivet-rivet!"  ; [<player 1>] / Dad! Watch me! / Rivet-rivet!
    call show_text
    sprite_path 1, path_0567
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

