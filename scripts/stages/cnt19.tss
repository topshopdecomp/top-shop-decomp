; CNT19.J entry 0
;
; Story mode: stage 10 won (Board_Task step 1396, FILE_CNT10_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player 1>] / I should charge up more often." | "[<player>] / Here's my victory
; pose!"
;
; 1040 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT19"                        ; a name for the script; costs a frame
    call start_scene_10
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_path 1, path_009F
    talk "【%N01】%KI should charge up more often."  ; [<player 1>] / I should charge up more often.
    call show_and_open
    call wait_then_clear
    sprite_path 0, path_011B
    talk "【%NMY】%KHere's my victory pose!"  ; [<player>] / Here's my victory pose!
    call show_text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 20
    wait_fade
    stop_bgm
    end

