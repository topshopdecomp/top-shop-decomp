; CNT09.J entry 0
;
; Story mode: the introduction of stage 10 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player 1>] / Gggggg..." | "[<player 1>] / Gggggg...gas..." | "[<player 1>] /
; Gggggg...gas...gasoline..." | "[<player 1>] / Gggggg...gas...gasoline...hungry..." | "[<player>]
; / That's a suspicious-looking robot..." | "[<player>] / Maybe I should give it a hand?" | ...
;
; 2276 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT09"                        ; a name for the script; costs a frame
    call start_scene_10
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=10
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=11
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=12
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=13
    sprite_init 4, image=30, attr=0, x=-100, y=-100, pri=14
    sprite_path 4, path_08C0
    talk "【%N01】%KGggggg..."              ; [<player 1>] / Gggggg...
    call show_and_open
    sprite_path 1, path_04F2
    sprite_path 2, path_07E2
    sprite_path 3, path_0860
    call wait_then_clear
    talk "【%N01】%KGggggg...gas..."        ; [<player 1>] / Gggggg...gas...
    call show_text
    call wait_then_clear
    talk "【%N01】%KGggggg...gas...gasoline..."  ; [<player 1>] / Gggggg...gas...gasoline...
    call show_text
    call wait_then_clear
    talk "【%N01】%KGggggg...gas...gasoline...hungry..."  ; [<player 1>] / Gggggg...gas...gasoline...hungry...
    call show_text
    call wait_then_clear
    talk "【%NMY】%KThat's a suspicious-looking robot..."  ; [<player>] / That's a suspicious-looking robot...
    call show_text
    sprite_path 0, path_060C
    sprite_path 1, path_0524
    sprite_path 2, path_0838
    call wait_then_clear
    talk "【%NMY】%KMaybe I should give it a hand?"  ; [<player>] / Maybe I should give it a hand?
    call show_text
    call wait_then_clear
    talk "【%N01】%KGulp gulp..."           ; [<player 1>] / Gulp gulp...
    call show_text
    sprite_path 0, path_063E
    sprite_path 1, path_0510
    call wait_then_clear
    talk "【%N01】%KGulp gulp...phew..."    ; [<player 1>] / Gulp gulp...phew...
    call show_text
    call wait_then_clear
    talk "【%N01】%KGulp gulp...phew...thank you..."  ; [<player 1>] / Gulp gulp...phew...thank you...
    call show_text
    sprite_path 1, path_0454
    call wait_then_clear
    talk "【%N01】%KGulp gulp...phew...thank you...%Kas a token of appreciation...let's battle!"  ; [<player 1>] / Gulp gulp...phew...thank you... / as a token of appreciation...let's battle!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KIt was a trap!"         ; [<player>] / It was a trap!
    call show_text
    sprite_path 0, path_06E6
    sprite_path 1, path_0468
    call wait_then_clear
    talk "【%NMY】%KIt was a trap! Nooooo!"  ; [<player>] / It was a trap! Nooooo!
    call show_text
    call wait_then_clear
    talk "【%N01】%KDon't complain,"        ; [<player 1>] / Don't complain,
    call show_text
    sprite_path 0, path_06FA
    sprite_path 1, path_0454
    call wait_then_clear
    talk "【%N01】%KDon't complain, or I'll punch you out!"  ; [<player 1>] / Don't complain, or I'll punch you out!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KNo"                     ; [<player>] / No
    call show_text
    sprite_path 0, path_07A2
    sprite_path 1, path_0468
    call wait_then_clear
    talk "【%NMY】%KNo violence, man!"      ; [<player>] / No violence, man!
    call show_text
    sprite_path 0, path_07B6
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

