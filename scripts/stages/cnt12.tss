    step speed=8, x=120, y=119, anim=anim_017A, next=NEXT  ; move to 120, 119, 8 pixels a frame
    step speed=4, x=140, y=119, anim=anim_017A, next=NEXT  ; move to 140, 119, 4 pixels a frame
    step speed=2, x=160, y=119, anim=anim_017A, next=NEXT  ; move to 160, 119, 2 pixels a frame
