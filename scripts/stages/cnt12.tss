; CNT12.J entry 0
;
; Story mode: stage 3 won (Board_Task step 1396, FILE_CNT10_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player 1>] / Waaaah. I lost..." | "[<player>] / Woo-hoo! I won!"
;
; 1020 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT12"                        ; a name for the script; costs a frame
    call start_scene_3
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=1
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=2
    sprite_path 1, path_008A
    talk "【%N01】%KWaaaah. I lost..."      ; [<player 1>] / Waaaah. I lost...
    call show_and_open
    call wait_then_clear
    sprite_path 0, path_0106
    talk "【%NMY】%KWoo-hoo! I won!"        ; [<player>] / Woo-hoo! I won!
    call show_text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 20
    wait_fade
    stop_bgm
    end

path_008A:
    step speed=-1, x=380, y=119, anim=anim_00FE, next=NEXT  ; jump to 380, 119
    step speed=8, x=200, y=119, anim=anim_00FE, next=NEXT  ; move to 200, 119, 8 pixels a frame
    step speed=4, x=180, y=119, anim=anim_00FE, next=NEXT  ; move to 180, 119, 4 pixels a frame
    step speed=2, x=160, y=119, anim=anim_00FE, next=NEXT  ; move to 160, 119, 2 pixels a frame
    step speed=0, x=90, y=0, anim=anim_00EE, next=path_00BC  ; wait 90 frames

