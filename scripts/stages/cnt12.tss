    step speed=8, x=100, y=119, anim=anim_00FE, next=NEXT  ; move to 100, 119, 8 pixels a frame
    step speed=8, x=-64, y=119, anim=anim_00FE, next=path_00E4  ; move to -64, 119, 8 pixels a frame

