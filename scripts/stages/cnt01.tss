; CNT01.J entry 0
;
; Story mode: the introduction of stage 2 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player 1>] / Bubble," | "[<player 1>] / Bubble, bubble," | "[<player 1>] /
; Bubble, bubble,toil and trouble... / The Great Magician appears..." | "[<player>] / Hmm..." |
; "[<player>] / Hmm... Time to move on." | "[<player 1>] / Hey!" | ...
;
; 3248 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT01"                        ; a name for the script; costs a frame
    call start_scene_2
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=10
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=11
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=12
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=13
    sprite_init 4, image=31, attr=0, x=-100, y=-100, pri=14
    sprite_path 4, path_0BC0
    sprite_path 2, path_09F6
    wait 40
    fade_to_white 8
    wait_fade
    fade_from_white 8
    wait_fade
    fade_to_white 6
    wait_fade
    fade_from_white 6
    wait_fade
    fade_to_white 4
    wait_fade
    fade_from_white 4
    wait_fade
    fade_to_white 2
    wait_fade
    fade_from_white 2
    wait_fade
    sprite_path 3, path_0AB4
    talk "【%N01】%KBubble,"                ; [<player 1>] / Bubble,
    call show_and_open
    sprite_path 1, path_064A
    call wait_then_clear
    talk "【%N01】%KBubble, bubble,"        ; [<player 1>] / Bubble, bubble,
    call show_text
    call wait_then_clear
    talk "【%N01】%KBubble, bubble,toil and trouble…%KThe Great Magician appears…"  ; [<player 1>] / Bubble, bubble,toil and trouble... / The Great Magician appears...
    call show_text
    call wait_then_clear
    talk "【%NMY】%KHmm..."                 ; [<player>] / Hmm...
    call show_text
    sprite_path 0, path_0A82
    sprite_path 1, path_067C
    sprite_path 2, path_0A4C
    call wait_then_clear
    talk "【%NMY】%KHmm... Time to move on."  ; [<player>] / Hmm... Time to move on.
    call show_text
    call wait_then_clear
    talk "【%N01】%KHey!"                   ; [<player 1>] / Hey!
    call show_text
    sprite_path 1, path_0782
    call wait_then_clear
    talk "【%N01】%KHey! You can't ignored me!"  ; [<player 1>] / Hey! You can't ignored me!
    call show_text
    call wait_then_clear
    talk "【%N01】%KThat sucked!"           ; [<player 1>] / That sucked!
    call show_text
    call wait_then_clear
    talk "【%N01】%KThat sucked! I'm going to cry!"  ; [<player 1>] / That sucked! I'm going to cry!
    call show_text
    call wait_then_clear
    talk "【%NMY】%K(Sigh) Okay, okay."     ; [<player>] / (Sigh) Okay, okay.
    call show_text
    sprite_path 0, path_0820
    sprite_path 1, path_0796
    sprite_path 2, path_0A56
    call wait_then_clear
    talk "【%NMY】%K(Sigh) Okay, okay. I'll listen to you."  ; [<player>] / (Sigh) Okay, okay. I'll listen to you.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KGo ahead."              ; [<player>] / Go ahead.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KGo ahead. Speak."       ; [<player>] / Go ahead. Speak.
    call show_text
    call wait_then_clear
    talk "【%N01】%KGosh, you're bossy!"    ; [<player 1>] / Gosh, you're bossy!
    call show_text
    sprite_path 0, path_0852
    sprite_path 1, path_0724
    call wait_then_clear
    call wait_then_clear
    sprite_path 1, path_0668
    talk "【%N01】%KNow..."                 ; [<player 1>] / Now...
    call show_text
    call wait_then_clear
    talk "【%N01】%KNow... I'll build a magical kingdom%Khere!"  ; [<player 1>] / Now... I'll build a magical kingdom / here!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KWhat!?"                 ; [<player>] / What!?
    call show_text
    sprite_path 0, path_0958
    sprite_path 1, path_067C
    call wait_then_clear
    talk "【%N01】%KYeah..."                ; [<player 1>] / Yeah...
    call show_text
    sprite_path 0, path_096C
    sprite_path 1, path_0724
    call wait_then_clear
    talk "【%N01】%KYeah... I mean..."      ; [<player 1>] / Yeah... I mean...
    call show_text
    call wait_then_clear
    talk "【%NMY】%KBe quiet,"              ; [<player>] / Be quiet,
    call show_text
    sprite_path 0, path_0958
    sprite_path 1, path_0738
    call wait_then_clear
    talk "【%NMY】%KBe quiet, you imposter!"  ; [<player>] / Be quiet, you imposter!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KYou'd better not get cheeky, even if%KI don't talk back."  ; [<player>] / You'd better not get cheeky, even if / I don't talk back.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KYou are an enemy,"      ; [<player>] / You are an enemy,
    call show_text
    call wait_then_clear
    talk "【%NMY】%KYou are an enemy,%Kand enemies must be defeated!"  ; [<player>] / You are an enemy, / and enemies must be defeated!
    call show_text
    call wait_then_clear
    talk "【%N01】%K(Sniff)"                ; [<player 1>] / (Sniff)
    call show_text
    sprite_path 0, path_096C
    sprite_path 1, path_0724
    call wait_then_clear
    talk "【%N01】%K(Sniff)%KYou said you'd listen..."  ; [<player 1>] / (Sniff) / You said you'd listen...
    call show_text
    call wait_then_clear
    talk "【%N01】%KBut now I'll invite you into my world%Kof magic!"  ; [<player 1>] / But now I'll invite you into my world / of magic!
    call show_text
    sprite_path 1, path_0738
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

