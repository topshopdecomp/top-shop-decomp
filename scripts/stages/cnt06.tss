; CNT06.J entry 0
;
; Story mode: the introduction of stage 7 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player>] / Where am I now?" | "[<player 1>] / Hi," | "[<player 1>] / Hi, here's
; my card." | "[<player 1>] / Hi, here's my card. Nice to meet you." | "[<player>] / Huh?" |
; "[<player>] / Huh? / What's this flabby thing doing here?" | ...
;
; 2576 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT06"                        ; a name for the script; costs a frame
    call start_scene_7
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=10
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=11
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=12
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=13
    sprite_init 4, image=30, attr=0, x=-100, y=-100, pri=14
    sprite_path 4, path_095A
    talk "【%NMY】%KWhere am I now?"        ; [<player>] / Where am I now?
    call show_and_open
    sprite_path 0, path_06A6
    sprite_path 2, path_087C
    sprite_path 3, path_08D2
    call wait_then_clear
    talk "【%N01】%KHi,"                    ; [<player 1>] / Hi,
    call show_text
    sprite_path 0, path_06D8
    sprite_path 1, path_04D0
    call wait_then_clear
    talk "【%N01】%KHi, here's my card."    ; [<player 1>] / Hi, here's my card.
    call show_text
    call wait_then_clear
    talk "【%N01】%KHi, here's my card. Nice to meet you."  ; [<player 1>] / Hi, here's my card. Nice to meet you.
    call show_text
    sprite_path 3, path_0932
    call wait_then_clear
    talk "【%NMY】%KHuh?"                   ; [<player>] / Huh?
    call show_text
    sprite_path 0, path_06C4
    sprite_path 1, path_0502
    call wait_then_clear
    talk "【%NMY】%KHuh?%KWhat's this flabby thing doing here?"  ; [<player>] / Huh? / What's this flabby thing doing here?
    call show_text
    call wait_then_clear
    talk "【%NMY】%KLet's see..."           ; [<player>] / Let's see...
    call show_text
    call wait_then_clear
    talk "“Fakers Laboratory, Sales Division”%K　　　　　「%N01」"  ; "Fakers Laboratory, Sales Division" / 「<player 1>」
    call show_text
    sprite_path 0, path_06C4
    sprite_path 1, path_0502
    call wait_then_clear
    talk "【%NMY】%K%N01?"                  ; [<player>] / <player 1>?
    call show_text
    sprite_path 0, path_0780
    sprite_path 1, path_0502
    call wait_then_clear
    talk "【%N01】%KYes."                   ; [<player 1>] / Yes.
    call show_text
    sprite_path 0, path_0794
    sprite_path 1, path_04EE
    call wait_then_clear
    talk "【%N01】%KYes. Cool name, huh?"   ; [<player 1>] / Yes. Cool name, huh?
    call show_text
    call wait_then_clear
    talk "【%N01】%KAnd"                    ; [<player 1>] / And
    call show_text
    call wait_then_clear
    talk "【%N01】%KAnd I'm"                ; [<player 1>] / And I'm
    call show_text
    call wait_then_clear
    talk "【%N01】%KAnd I'm selling “cat robots”."  ; [<player 1>] / And I'm selling "cat robots".
    call show_text
    call wait_then_clear
    talk "【%N01】%KWould you like one?"    ; [<player 1>] / Would you like one?
    call show_text
    call wait_then_clear
    talk "【%NMY】%KYou sell cats!%KEven though they're robots,%KI can't let this happen!"  ; [<player>] / You sell cats! / Even though they're robots, / I can't let this happen!
    call show_text
    sprite_path 0, path_07DE
    sprite_path 1, path_0502
    call wait_then_clear
    talk "【%NMY】%KI take that, as your challenge!"  ; [<player>] / I take that, as your challenge!
    call show_text
    call wait_then_clear
    talk "【%N01】%KChallenge?"             ; [<player 1>] / Challenge?
    call show_text
    sprite_path 0, path_07F2
    sprite_path 1, path_04EE
    call wait_then_clear
    talk "【%N01】%KOkay,"                  ; [<player 1>] / Okay,
    call show_text
    call wait_then_clear
    talk "【%N01】%KOkay, but just for a while.%KMy boss will be mad if he finds out."  ; [<player 1>] / Okay, but just for a while. / My boss will be mad if he finds out.
    call show_text
    sprite_path 1, path_0502
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

