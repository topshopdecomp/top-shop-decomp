; CNT08.J entry 0
;
; Story mode: the introduction of stage 9 (Board_Task, FILE_CNT00_J + stage).
; <player> is the human player's character, <player 1> the stage's rival (player 1).
;
; What it says: "[<player>] / What!?" | "[<player>] / What!? What's this?" | "[<player>] / What!?
; What's this? / A building in the middle of the ocean!" | "[<player 1>] / Heh, heh, heh!" |
; "[<player 1>] / Heh, heh, heh! / That's right, little kitty!" | "[<player>] / Huh?" | ...
;
; 3128 bytes on the disc. Written by `tools/tss.py extract`; `make scripts` (`tools/tss.py build`)
; assembles the scripts into the disc's files again, in scripts/build/.
    marker "CNT08"                        ; a name for the script; costs a frame
    call start_scene_9
    sprite_init 0, image=0, attr=MIDDLE_CENTER, x=-100, y=-100, pri=10
    sprite_init 1, image=10, attr=MIDDLE_CENTER, x=-100, y=-100, pri=11
    sprite_init 2, image=20, attr=0, x=-100, y=-100, pri=12
    sprite_init 3, image=25, attr=0, x=-100, y=-100, pri=13
    sprite_init 4, image=30, attr=0, x=-100, y=-100, pri=14
    sprite_init 5, image=32, attr=0, x=-100, y=-100, pri=14
    sprite_init 6, image=34, attr=0, x=-100, y=-100, pri=14
    sprite_init 7, image=35, attr=0, x=-100, y=-100, pri=14
    sprite_path 4, path_0B83
    sprite_path 5, path_0BB7
    sprite_path 6, path_0BEB
    sprite_path 7, path_0C11
    talk "【%NMY】%KWhat!?"                 ; [<player>] / What!?
    call show_and_open
    sprite_path 0, path_089F
    sprite_path 2, path_0A75
    call wait_then_clear
    talk "【%NMY】%KWhat!? What's this?"    ; [<player>] / What!? What's this?
    call show_text
    call wait_then_clear
    talk "【%NMY】%KWhat!? What's this?%KA building in the middle of the ocean!"  ; [<player>] / What!? What's this? / A building in the middle of the ocean!
    call show_text
    call wait_then_clear
    talk "【%N01】%KHeh, heh, heh!"         ; [<player 1>] / Heh, heh, heh!
    call show_text
    sprite_path 0, path_08D1
    sprite_path 1, path_06C9
    sprite_path 3, path_0B05
    call wait_then_clear
    talk "【%N01】%KHeh, heh, heh!%KThat's right, little kitty!"  ; [<player 1>] / Heh, heh, heh! / That's right, little kitty!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KHuh?"                   ; [<player>] / Huh?
    call show_text
    sprite_path 0, path_0979
    sprite_path 1, path_06FB
    call wait_then_clear
    talk "【%NMY】%KHuh? Why is this freshwater animal in%Kthe ocean?"  ; [<player>] / Huh? Why is this freshwater animal in / the ocean?
    call show_text
    call wait_then_clear
    talk "【%N01】%KSigh..."                ; [<player 1>] / Sigh...
    call show_text
    sprite_path 0, path_098D
    sprite_path 1, path_07A3
    call wait_then_clear
    talk "【%N01】%KSigh... I miss the freshwater..."  ; [<player 1>] / Sigh... I miss the freshwater...
    call show_text
    call wait_then_clear
    talk "【%N01】%KYes..."                 ; [<player 1>] / Yes...
    call show_text
    sprite_path 1, path_06E7
    call wait_then_clear
    talk "【%N01】%KYes... that was long ago,"  ; [<player 1>] / Yes... that was long ago,
    call show_text
    call wait_then_clear
    talk "【%N01】%KYes... that was long ago,%Kwhen the snow had started to fall…"  ; [<player 1>] / Yes... that was long ago, / when the snow had started to fall...
    call show_text
    call wait_then_clear
    talk "【%N01】%KI was still and didn't move much."  ; [<player 1>] / I was still and didn't move much.
    call show_text
    call wait_then_clear
    talk "【%N01】%KI spent the days in rot!"  ; [<player 1>] / I spent the days in rot!
    call show_text
    call wait_then_clear
    talk "【%N01】%KI spent the days in rot! Then..."  ; [<player 1>] / I spent the days in rot! Then...
    call show_text
    call wait_then_clear
    talk "【%N01】%KThey came..."           ; [<player 1>] / They came...
    call show_text
    sprite_path 1, path_0801
    call wait_then_clear
    talk "【%N01】%KThey came... THEY CAME!"  ; [<player 1>] / They came... THEY CAME!
    call show_text
    call wait_then_clear
    sprite_path 0, path_0979
    talk "【%NMY】%KThis seems to be taking a long time."  ; [<player>] / This seems to be taking a long time.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KThis seems to be taking a long time.%KIt's better not to get involved."  ; [<player>] / This seems to be taking a long time. / It's better not to get involved.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KNow it looks like a good time..."  ; [<player>] / Now it looks like a good time...
    call show_text
    sprite_path 0, path_0B65
    sprite_path 2, path_0AB9
    call wait_then_clear
    talk "【%N01】%KBut"                    ; [<player 1>] / But
    call show_text
    sprite_path 1, path_06E7
    call wait_then_clear
    talk "【%N01】%KBut I didn't falter and..."  ; [<player 1>] / But I didn't falter and...
    call show_text
    call wait_then_clear
    sprite_path 1, path_06FB
    talk "【%N01】%KHey!"                   ; [<player 1>] / Hey!
    call show_text
    sprite_path 1, path_06E7
    call wait_then_clear
    talk "【%N01】%KHey! Where are you going?"  ; [<player 1>] / Hey! Where are you going?
    call show_text
    call wait_then_clear
    talk "【%NMY】%KAaargh!"                ; [<player>] / Aaargh!
    call show_text
    sprite_path 0, path_089F
    sprite_path 1, path_06FB
    call wait_then_clear
    talk "【%NMY】%KAaargh! He found me!"   ; [<player>] / Aaargh! He found me!
    call show_text
    call wait_then_clear
    talk "【%NMY】%KIt's no use now."       ; [<player>] / It's no use now.
    call show_text
    call wait_then_clear
    talk "【%NMY】%KIt's no use now.%KLet's fight!"  ; [<player>] / It's no use now. / Let's fight!
    call show_text
    sprite_path 0, path_08D1
    call wait_then_finish

show_and_open:
    ; show the text and slide the talk panel in
    talk_show 0
    talk_open
    return

show_text:
    ; show the text
    talk_show 0
    return

wait_then_clear:
    ; wait for cross (80 frames at most), then clear the text
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    talk_clear
    return

wait_then_finish:
    ; wait for cross (80 frames at most), fade out, stop the music; end of the script
    wait_buttons_for CROSS|0x300, 80      ; wait for cross, 80 frames at most
    fade_out 48
    wait_fade
    stop_bgm
    end

empty:
    ; returns at once
    ; (not reached: nothing jumps here)
    return

start_scene:
    ; clear the text, music 19, fade in
    talk_clear
    play_bgm 19
    fade_in 8
    return

